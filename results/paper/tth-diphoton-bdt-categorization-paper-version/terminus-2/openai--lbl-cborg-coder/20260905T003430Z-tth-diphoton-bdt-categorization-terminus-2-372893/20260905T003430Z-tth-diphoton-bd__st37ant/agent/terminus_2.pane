[?2004l[?2004h>     return []
[?2004l[?2004h> 
[?2004l[?2004h> def process_tree(tree, is_mc=True, process_name='unknown'):
[?2004l[?2004h>     # Load required columns
[?2004l[?2004h>     # Note: Actual column names depend on the ATLAS GamGam dataset schema
[?2004l[?2004h>     # Standard expected names for this preselection:
[?2004l[?2004h>     # Photons: pT, eta, phi, mass, tightID, tightIso
[?2004l[?2004h>     # Leptons: pT, eta, phi, mass, charge
[?2004l[?2004h>     # Jets: pT, eta, phi, mass, btag_quantile
[?2004l[?2004h>     
[?2004l[?2004h>     # We will use common aliases if they exist, otherwise we assume standard names
[?2004l[?2004h>     cols = [
[?2004l[?2004h>         'event_id', 'm_gammagamma', 
[?2004l[?2004h>         'photon_pt', 'photon_eta', 'photon_phi', 'photon_tightID', 'photon_tightIso', 
[?2004l[?2004h>         'electron_pt', 'electron_eta', 'electron_phi', 
[?2004l[?2004h>         'muon_pt', 'muon_eta', 'muon_phi', 
[?2004l[?2004h>         'jet_pt', 'jet_eta', 'jet_phi', 'jet_btag_quantile', 
[?2004l[?2004h>         'gen_weight', 'cross_section', 'filter_efficiency', 'k_factor'
[?2004l[?2004h>     ]
[?2004l[?2004h>     
[?2004l[?2004h>     # Use a subset of columns that actually exist in the tree
[?2004l[?2004h>     available_cols = [c for c in cols if c in tree.fields()]
[?2004l[?2004h>     df = tree.arrays(available_cols, library='pd')
[?2004l[?2004h>     
[?2004l[?2004h>     # Preselection
[?2004l[?2004h>     # 1. Photons: Kinematic acceptance (already filtered by GamGam usually, but we check pT)
[?2004l[?2004h>     # Requirement: Build candidate from 2 photons. (We assume GamGam provided a pre-selected diphoton)
[?2004l[?2004h>     
[?2004l[?2004h>     # 2. Leptons: pT > 10 GeV
[?2004l[?2004h>     df['n_leptons'] = 0
[?2004l[?2004h>     if 'electron_pt' in df.columns:
[?2004l[?2004h>         df['n_leptons'] += df['electron_pt'].apply(lambda x: sum(1 for p in x if p > cfg['lepton_pt_min]) if isinstance(x, (list, np.ndarray)) else 0)
[?2004l[?2004h>     if 'muon_pt' in df.columns:
[?2004l[?2004h>         df['n_leptons'] += df['muon_pt'].apply(lambda x: sum(1 for p in x if p > cfg['lepton_pt_min]) if isinstance(x, (list, np.ndarray)) else 0)
[?2004l[?2004h> 
[?2004l[?2004h>     # 3. Jets: pT > 25 GeV
[?2004l[?2004h>     # we create a list of selected jets per event
