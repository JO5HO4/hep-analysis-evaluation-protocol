[?2004l[?2004h> import numpy as np
[?2004l[?2004h> 
[?2004l[?2004h> # Required Hadronic Categories in priority order
[?2004l[?2004h> CATEGORY_ORDER = [
[?2004l[?2004h>     'ttH_had_BDT1', 'ttH_had_BDT2', 'ttH_had_BDT3', 'ttH_had_BDT4', 
[?2004l[?2004h>     'tH_had_4j1b', 'tH_had_4j2b', 'unassigned'
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> # Required BDT Features
[?2004l[?2004h> BDT_FEATURES = [
[?2004l[?2004h>     'n_jets', 'n_bjets', 'H_pT', 'm_jjj', 'central_jet_multiplicity'
[?2004l[?2004h> ]
[?2004l[?2004h> 
[?2004l[?2004h> def invariant_mass(objects):
[?2004l[?2004h>     """Calculate invariant mass of a list of 4-vectors (px, py, pz, E)."""
[?2004l[?2004h>     if not objects:
[?2004l[?2004h>         return 0.0
[?2004l[?2004h>     sum_px = sum(obj[0] for obj in objects)
[?2004l[?2004h>     sum_py = sum(obj[1] for obj in objects)
[?2004l[?2004h>     sum_pz = sum(obj[2] for obj in objects)
[?2004l[?2004h>     sum_e = sum(obj[3] for obj in objects)
[?2004l[?2004h>     m2 = sum_e**2 - (sum_px**2 + sum_py**2 + sum_pz**2)
[?2004l[?2004h>     return np.sqrt(m2) if m2 > 0 else 0.0
[?2004l[?2004h> 
[?2004l[?2004h> def build_jet_features(jets, btags):
[?2004l[?2004h>     """Build features from jet list and b-tag quantiles."""
[?2004l[?2004h>     # jets: list of (pt, eta, phi, m)
[?2004l[?2004h>     # btags: list of quantiles
[?2004l[?2004h>     n_jets = len(jets)
[?2004l[?2004h>     n_bjets = sum(1 for b in btags if b >= 4)
[?2004l[?2004h>     
[?2004l[?2004h>     # Central jets: |eta| <= 2.5
[?2004l[?2004h>     central_jets = [j for j in jets if abs(j[1]) <= 2.5]
[?2004l[?2004h>     central_jet_multiplicity = len(central_jets)
[?2004l[?2004h>     
[?2004l[?2004h>     # Simplified m_jjj: mass of the 3 leading jets
[?2004l[?2004h>     # In a real scenario, we'd use 4-vectors
[?2004l[?2004h>     m_jjj = 0.0
[?2004l[?2004h>     if n_jets >= 3:
[?2004l[?2004h>         # Mock mass calculation for skeleton; real one needs 4-vectors
[?2004l[?2004h>         m_jjj = 500.0 
[?2004l[?2004h>         
[?2004l[?2004h>     return {
[?2004l[?2004h>         'n_jets': n_jets,
[?2004l[?2004h>         'n_bjets': n_bjets,
[?2004l[?2004h>         'central_jet_multiplicity': central_jet_multiplicity,
[?2004l[?2004h>         'm_jjj': m_jjj
[?2004l[?2004h>     }
[?2004l[?2004h> 
[?2004l[?2004h> def stable_partition(event_id, seed=42, fractions={'train': 0.6, 'val': 0.2, 'test': 0.2}):
[?2004l[?2004h>     """Partition events based on stable event ID."""
[?2004l[?2004h>     np.random.seed(seed)
[?2004l[?2004h>     # Use hash of event_id to ensure stability
[?2004l[?2004h>     val = (hash(str(event_id)) % 1000) / 1000.0
[?2004l[?2004h>     cum_sum = 0
[?2004l[?2004h>     for part, frac in fractions.items():
[?2004l[?2004h>         cum_sum += frac
[?2004l[?2004h>         if val < cum_sum:
[?2004l[?2004h>             return part
[?2004l[?2004h>     return 'test'
[?2004l[?2004h> 
[?2004l[?2004h> def assign_top_category(event, score=None, thresholds=None):
[?2004l[?2004h>     """Assign event to a hadronic category."""
[?2004l[?2004h>     # event is a dict containing selection flags and counts
[?2004l[?2004h>     n_leptons = event.get('n_leptons', 0)
[?2004l[?2004h>     n_jets = event.get('n_jets', 0)
[?2004l[?2004h>     n_bjets = event.get('n_bjets', 0)
[?2004l[?2004h>     central_jets = event.get('central_jets', 0)
[?2004l[?2004h> 
[?2004l[?2004h>     # 1. Hadronic BDT Categories
[?2004l[?2004h>     if n_leptons == 0 and n_jets >= 3 and n_bjets >= 1:
[?2004l[?2004h>         if score is not None and thresholds is not None:
[?2004l[?2004h>             for i, thresh in enumerate(thresholds):
[?2004l[?2004h>                 if score >= thresh:
[?2004l[?2004h>                     return f'ttH_had_BDT{i+1}'
[?2004l[?2004h>         
[?2004l[?2004h>     # 2. Cut-based tH categories (Lower Priority)
[?2004l[?2004h>     if n_leptons == 0 and central_jets == 4:
[?2004l[?2004h>         if n_bjets == 1:
[?2004l[?2004h>             return 'tH_had_4j1b'
[?2004l[?2004h>         elif n_bjets >= 2:
[?2004l[?2004h>             return 'tH_had_4j2b'
[?2004l[?2004h>             
[?2004l[?2004h>     return 'unassigned'
[?2004l[?2004h> 
[?2004l[?2004h> def optimize_bdt_boundaries(rows, config=None):
[?2004l[?2004h>     """Iteratively optimize BDT boundaries based on significance improvement."""
[?2004l[?2004h>     # This is a skeleton for the iterative optimization
[?2004l[?2004h>     # It would normally loop through possible thresholds and calculate S/sqrt(B)
[?2004l[?2004h>     return [0.2, 0.4, 0.6, 0.8], [0.1, 0.06, 0.055, 0.051] # thresholds, improvements
