[?2004l[?2004h> def get_mc_files(base_path):
[?2004l[?2004h>     # Target Higgs samples: ggH, VBF, WH, ZH, ggZH, ttH, tH
[?2004l[?2004h>     targets = ['ggH', 'VBF', 'WH', 'ZH', 'ggZH', 'ttH', 'tH']
[?2004l[?2004h>     files = []
[?2004l[?2004h>     mc_dir = os.path.join(base_path, 'MC')
[?2004l[?2004h>     if os.path.exists(mc_dir):
[?2004l[?2004h>         for f in glob.glob(os.path.join(mc_dir, '*.root')):
[?2004l[?2004h>             if any(t in os.path.basename(f) for t in targets):
[?2004l[?2004h>                 files.append(f)
[?2004l[?2004h>     return files
[?2004l[?2004h> 
[?2004l[?2004h> def get_data_files(base_path):
