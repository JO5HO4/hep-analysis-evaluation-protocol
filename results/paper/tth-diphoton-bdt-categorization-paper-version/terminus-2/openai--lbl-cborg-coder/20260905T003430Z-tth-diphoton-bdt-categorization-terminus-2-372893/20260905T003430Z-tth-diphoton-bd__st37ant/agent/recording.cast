[482.917941, "o", "        'mcWeight', 'xsec', 'kfac', 'filteff'\r\n\u001b[?2004l\r"]
[482.917968, "o", "\u001b[?2004h> "]
[482.917996, "o", "    ]\r\n\u001b[?2004l\r\u001b[?2004h"]
[482.918073, "o", "> "]
[482.918229, "o", "    available_cols = [c for c in cols if c in tree.fields]\r\n\u001b[?2004l\r"]
[482.918255, "o", "\u001b[?2004h> "]
[482.918437, "o", "    df = tree.arrays(available_cols, library='pd')\r\n\u001b[?2004l\r"]
[482.918464, "o", "\u001b[?2004h> "]
[482.918491, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[482.918517, "o", "> "]
[482.918601, "o", "    for c in cols:\r\n\u001b[?2004l\r\u001b[?2004h"]
[482.918629, "o", "> "]
[482.918728, "o", "        if c not in df.columns:\r\n\u001b[?2004l\r"]
[482.918756, "o", "\u001b[?2004h> "]
[482.919212, "o", "            df[c] = [[] if 'pt' in c or 'eta' in c or 'phi' in c or 'quantile' in c or 'type' in c else 0.0 for _ in range(len(df))]\r\n\u001b[?2004l\r"]
[482.919239, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[482.919298, "o", "\u001b[?2004h> "]
[482.919413, "o", "    def calc_mgg(pts, etas, phis, es):\r\n\u001b[?2004l\r"]
[482.919439, "o", "\u001b[?2004h> "]
[482.919722, "o", "        if not isinstance(pts, (list, np.ndarray)) or len(pts) < 2: return 0.0\r\n\u001b[?2004l\r"]
[482.919747, "o", "\u001b[?2004h> "]
[482.920111, "o", "        p1 = np.array([pts[0]*np.cos(phis[0]), pts[0]*np.sin(phis[0]), pts[0]*np.sinh(etas[0]), es[0]])\r\n\u001b[?2004l\r"]
[482.920139, "o", "\u001b[?2004h> "]
[482.920501, "o", "        p2 = np.array([pts[1]*np.cos(phis[1]), pts[1]*np.sin(phis[1]), pts[1]*np.sinh(etas[1]), es[1]])\r\n\u001b[?2004l\r"]
[482.920528, "o", "\u001b[?2004h> "]
[482.920839, "o", "        m2 = (p1[3]+p2[3])**2 - (p1[0]+p2[0])**2 - (p1[1]+p2[1])**2 - (p1[2]+p2[2])**2\r\n\u001b[?2004l\r"]
[482.92087, "o", "\u001b[?2004h> "]
[482.92103, "o", "        return np.sqrt(m2) if m2 > 0 else 0.0\r\n\u001b[?2004l\r"]
[482.92106, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[482.921118, "o", "\u001b[?2004h> "]
[482.92153, "o", "    df['m_gammagamma'] = df.apply(lambda r: calc_mgg(r['photon_pt'], r['photon_eta'], r['photon_phi'], r['photon_e']), axis=1)\r\n\u001b[?2004l\r"]
[482.921557, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[482.921584, "o", "\u001b[?2004h> "]
[482.921666, "o", "    # Preselection\r\n\u001b[?2004l\r"]
[482.921694, "o", "\u001b[?2004h> "]
[482.922195, "o", "    df['n_leptons_sel'] = df['lep_pt'].apply(lambda x: sum(1 for p in x if p > cfg['lepton_pt_min']) if isinstance(x, (list, np.ndarray)) else 0)\r\n\u001b[?2004l\r"]
[482.922223, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[482.92225, "o", "\u001b[?2004h> "]
[482.922399, "o", "    def filter_jets(pts, etas, btags):\r\n\u001b[?2004l\r"]
[482.922427, "o", "\u001b[?2004h> "]
[482.922492, "o", "        jets = []\r\n\u001b[?2004l\r"]
[482.922519, "o", "\u001b[?2004h> "]
[482.922744, "o", "        if not isinstance(pts, (list, np.ndarray)): return jets\r\n\u001b[?2004l\r"]
[482.922771, "o", "\u001b[?2004h> "]
[482.922934, "o", "        for p, e, b in zip(pts, etas, btags):\r\n\u001b[?2004l\r"]
[482.922962, "o", "\u001b[?2004h> "]
[482.923101, "o", "            if p > cfg['jet_pt_min']:\r\n\u001b[?2004l\r"]
[482.923129, "o", "\u001b[?2004h> "]
[482.923337, "o", "                jets.append({'pt': p, 'eta': e, 'btag': b})\r\n\u001b[?2004l\r"]
[482.923364, "o", "\u001b[?2004h> "]
[482.923438, "o", "        return jets\r\n\u001b[?2004l\r"]
[482.923465, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[482.923523, "o", "\u001b[?2004h> "]
[482.92371, "o", "    df['selected_jets'] = df.apply(lambda row: filter_jets(\r\n\u001b[?2004l\r"]
[482.923736, "o", "\u001b[?2004h> "]
[482.923996, "o", "        row['jet_pt'], row['jet_eta'], row['jet_btag_quantile']), axis=1)\r\n\u001b[?2004l\r"]
[482.924022, "o", "\u001b[?2004h> "]
[482.924077, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[482.92425, "o", "    df['n_jets'] = df['selected_jets'].apply(len)\r\n\u001b[?2004l\r"]
[482.924278, "o", "\u001b[?2004h> "]
[482.924678, "o", "    df['n_bjets'] = df['selected_jets'].apply(lambda js: sum(1 for j in js if j['btag'] >= cfg['btag_threshold']))\r\n\u001b[?2004l\r"]
[482.924705, "o", "\u001b[?2004h> "]
[482.925146, "o", "    df['central_jets'] = df['selected_jets'].apply(lambda js: sum(1 for j in js if abs(j['eta']) <= cfg['central_eta_max']))\r\n\u001b[?2004l\r"]
[482.925174, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[482.925242, "o", "\u001b[?2004h> "]
[482.925323, "o", "    df['channel'] = 'unassigned'\r\n\u001b[?2004l\r"]
[482.925351, "o", "\u001b[?2004h> "]
[482.925655, "o", "    had_mask = (df['n_leptons_sel'] == 0) & (df['n_jets'] >= 3) & (df['n_bjets'] >= 1)\r\n\u001b[?2004l\r"]
[482.925683, "o", "\u001b[?2004h> "]
[482.925841, "o", "    df.loc[had_mask, 'channel'] = 'hadronic'\r\n\u001b[?2004l\r"]
[482.925868, "o", "\u001b[?2004h> "]
[482.926098, "o", "    lep_mask = (df['n_leptons_sel'] >= 1) & (df['n_bjets'] >= 1)\r\n\u001b[?2004l\r"]
[482.926126, "o", "\u001b[?2004h> "]
[482.926402, "o", "    df.loc[lep_mask & (df['channel'] == 'unassigned'), 'channel'] = 'leptonic'\r\n\u001b[?2004l\r"]
[482.926431, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[482.926458, "o", "\u001b[?2004h> "]
[482.926584, "o", "    df['process'] = process_name\r\n\u001b[?2004l\r"]
[482.926612, "o", "\u001b[?2004h> "]
[482.926677, "o", "    return df\r\n\u001b[?2004l\r\u001b[?2004h"]
[482.926705, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[482.926761, "o", "> "]
[482.926811, "o", "def run_analysis():\r\n\u001b[?2004l\r\u001b[?2004h"]
[482.926838, "o", "> "]
[482.92695, "o", "    print(\"Starting pipeline...\")\r\n\u001b[?2004l\r"]
[482.926976, "o", "\u001b[?2004h> "]
[482.927143, "o", "    mc_files = get_mc_files(cfg['input_data'])\r\n\u001b[?2004l\r"]
[482.927169, "o", "\u001b[?2004h> "]
[482.927354, "o", "    data_files = get_data_files(cfg['input_data'])\r\n\u001b[?2004l\r"]
[482.927382, "o", "\u001b[?2004h> "]
[482.927408, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[482.927479, "o", ">     all_dfs = []\r\n"]
[482.927507, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[482.927603, "o", "    for f in mc_files:\r\n\u001b[?2004l\r"]
[482.927629, "o", "\u001b[?2004h> "]
[482.927755, "o", "        proc = os.path.basename(f)\r\n\u001b[?2004l\r"]
[482.927782, "o", "\u001b[?2004h> "]
[482.927925, "o", "        print(f\"Processing MC: {proc}\")\r\n\u001b[?2004l\r"]
[482.927953, "o", "\u001b[?2004h> "]
[482.928131, "o", "        with uproot.open(f) [\"analysis\"] as tree:\r\n\u001b[?2004l\r"]
[482.928159, "o", "\u001b[?2004h> "]
[482.928429, "o", "            all_dfs.append(process_tree(tree, is_mc=True, process_name=proc))\r\n\u001b[?2004l\r"]
[482.928456, "o", "\u001b[?2004h> "]
[482.92852, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[482.928597, "o", "    for f in data_files:\r\n\u001b[?2004l\r"]
[482.928623, "o", "\u001b[?2004h> "]
[482.928766, "o", "        print(f\"Processing Data: {f}\")\r\n\u001b[?2004l\r"]
[482.928794, "o", "\u001b[?2004h> "]
[482.928978, "o", "        with uproot.open(f) [\"analysis\"] as tree:\r\n\u001b[?2004l\r"]
[482.929008, "o", "\u001b[?2004h> "]
[482.929287, "o", "            all_dfs.append(process_tree(tree, is_mc=False, process_name='data'))\r\n\u001b[?2004l\r"]
[482.929316, "o", "\u001b[?2004h> "]
[482.929374, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[482.929401, "o", "> "]
[482.929468, "o", "    if not all_dfs: \r\n\u001b[?2004l\r"]
[482.929494, "o", "\u001b[?2004h> "]
[482.929614, "o", "        print(\"No data loaded.\")\r\n\u001b[?2004l\r"]
[482.929641, "o", "\u001b[?2004h> "]
[482.929703, "o", "        return\r\n\u001b[?2004l\r\u001b[?2004h"]
[482.929731, "o", "> "]
[482.929795, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[482.929908, "o", "    full_df = pd.concat(all_dfs)\r\n\u001b[?2004l\r"]
[482.929935, "o", "\u001b[?2004h> "]
[482.930114, "o", "    print(f\"Total events loaded: {len(full_df)}\")\r\n\u001b[?2004l\r"]
[482.930141, "o", "\u001b[?2004h> "]
[482.930204, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[482.930432, "o", "    preselected = full_df[full_df['channel'] != 'unassigned'].copy()\r\n\u001b[?2004l\r"]
[482.930458, "o", "\u001b[?2004h> "]
[482.930677, "o", "    print(f\"Events passing preselection: {len(preselected)}\")\r\n\u001b[?2004l\r"]
[482.930703, "o", "\u001b[?2004h> "]
[482.930759, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[482.930843, "o", "    # Bookkeeping counts\r\n\u001b[?2004l\r"]
[482.93087, "o", "\u001b[?2004h> "]
[482.931122, "o", "    had_count = len(preselected[preselected['channel'] == 'hadronic'])\r\n\u001b[?2004l\r"]
[482.931149, "o", "\u001b[?2004h> "]
[482.931408, "o", "    lep_count = len(preselected[preselected['channel'] == 'leptonic'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[482.931435, "o", "> "]
[482.931634, "o", "    print(f\"Hadronic: {had_count}, Leptonic: {lep_count}\")\r\n\u001b[?2004l\r"]
[482.931662, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[482.931689, "o", "\u001b[?2004h> "]
[482.931936, "o", "    preselected = preselected.drop(columns=['selected_jets'])\r\n\u001b[?2004l\r\u001b[?2004h"]
[482.931963, "o", "> "]
[482.932269, "o", "    preselected.to_csv(os.path.join(res_dir, 'preselected_events.csv'), index=False)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[482.932297, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[482.932412, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[482.932439, "o", "\u001b[?2004h> "]
[482.932513, "o", "    run_analysis()\r\n\u001b[?2004l\r"]
[482.93254, "o", "\u001b[?2004h> EOF\r\n"]
[482.932594, "o", "\u001b[?2004l\r"]
[482.937253, "o", "\u001b[?2004h"]
[482.937301, "o", "root@nid007078:~/submission/tth-diphoton-bdt# "]
[484.61477, "i", "cd /root/submission/tth-diphoton-bdt && python3 run_pipeline.py\n"]
[484.615253, "o", "cd /root/submission/tth-diphoton-bdt && python3 run_pipeline.py\r\n\u001b[?2004l\r"]
[485.090648, "o", "Starting pipeline...\r\n"]
[485.093599, "o", "Processing MC: ZH_preselection.root\r\n"]
[485.14683, "o", "Processing MC: VBF_preselection.root\r\n"]
[485.175121, "o", "Processing MC: ttH_preselection.root\r\n"]
[487.176989, "o", "Processing MC: WH_preselection.root\r\n"]
[487.239024, "o", "Processing MC: ggZH_preselection.root\r\n"]
[487.282792, "o", "Processing MC: tH_preselection.root\r\n"]
[487.551458, "o", "Processing MC: ggH_preselection.root\r\n"]
[487.744536, "o", "Processing Data: /data/GamGam/data/data_preselection.root\r\n"]
[492.837229, "o", "Total events loaded: 356084\r\n"]
[492.841775, "o", "Events passing preselection: 0\r\n"]
[492.842349, "o", "Hadronic: 0, Leptonic: 0\r\n"]
[493.118845, "o", "\u001b[?2004hroot@nid007078:~/submission/tth-diphoton-bdt# "]
[557.084193, "i", "cat << 'EOF' > /root/submission/tth-diphoton-bdt/debug_preselection.py\nimport uproot\nimport numpy as np\n\ntree = uproot.open('/data/GamGam/MC/ttH_preselection.root')['analysis']\n# Read a few events\ndata = tree.arrays(['lep_pt', 'jet_pt', 'jet_btag_quantile'], library='pd').head(10)\n\nfor i, row in data.iterrows():\n    lp = row['lep_pt']\n    jp = row['jet_pt']\n    jb = row['jet_btag_quantile']\n    \n    n_lep = len(lp) if isinstance(lp, (list, np.ndarray)) else 0\n    n_jet = len(jp) if isinstance(jp, (list, np.ndarray)) else 0\n    n_bjet = sum(1 for b in jb if b >= 4) if isinstance(jb, (list, np.ndarray)) else 0\n    \n    print(f\"Event {i}: n_lep={n_lep}, n_jet={n_jet}, n_bjet={n_bjet} | PassHad={ (n_lep==0 and n_jet>=3 and n_bjet>=1) }, PassLep={ (n_lep>=1 and n_bjet>=1) }\")\nEOF\n"]
[557.085, "o", "cat << 'EOF' > /root/submission/tth-diphoton-bdt/debug_preselection.py\r\n\u001b[?2004l\r"]
[557.085057, "o", "\u001b[?2004h> "]
[557.085153, "o", "import uproot\r\n\u001b[?2004l\r\u001b[?2004h> "]
[557.085245, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[557.085275, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[557.085346, "o", "\u001b[?2004h> "]
[557.08564, "o", "tree = uproot.open('/data/GamGam/MC/ttH_preselection.root')['analysis']\r\n\u001b[?2004l\r"]
[557.085667, "o", "\u001b[?2004h> "]
[557.085768, "o", "# Read a few events\r\n\u001b[?2004l\r"]
[557.085795, "o", "\u001b[?2004h> "]
[557.086096, "o", "data = tree.arrays(['lep_pt', 'jet_pt', 'jet_btag_quantile'], library='pd').head(10)\r\n\u001b[?2004l\r"]
[557.086126, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[557.086183, "o", "\u001b[?2004h> "]
[557.08628, "o", "for i, row in data.iterrows():\r\n\u001b[?2004l\r"]
[557.086309, "o", "\u001b[?2004h> "]
[557.086388, "o", "    lp = row['lep_pt']\r\n\u001b[?2004l\r"]
[557.086416, "o", "\u001b[?2004h> "]
[557.086504, "o", "    jp = row['jet_pt']\r\n\u001b[?2004l\r"]
[557.086535, "o", "\u001b[?2004h> "]
[557.086654, "o", "    jb = row['jet_btag_quantile']\r\n\u001b[?2004l\r"]
[557.086681, "o", "\u001b[?2004h> "]
[557.086737, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[557.086955, "o", "    n_lep = len(lp) if isinstance(lp, (list, np.ndarray)) else 0\r\n\u001b[?2004l\r"]
[557.086984, "o", "\u001b[?2004h> "]
[557.087216, "o", "    n_jet = len(jp) if isinstance(jp, (list, np.ndarray)) else 0\r\n\u001b[?2004l\r"]
[557.087244, "o", "\u001b[?2004h> "]
[557.087547, "o", "    n_bjet = sum(1 for b in jb if b >= 4) if isinstance(jb, (list, np.ndarray)) else 0\r\n\u001b[?2004l\r"]
[557.087576, "o", "\u001b[?2004h> "]
[557.087606, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[557.087633, "o", "> "]
[557.088205, "o", "    print(f\"Event {i}: n_lep={n_lep}, n_jet={n_jet}, n_bjet={n_bjet} | PassHad={ (n_lep==0 and n_jet>=3 and n_bjet>=1) }, PassLep={ (n_lep>=1 and n_bjet>=1) }\")\r\n\u001b[?2004l\r"]
[557.088232, "o", "\u001b[?2004h> "]
[557.088289, "o", "EOF\r\n\u001b[?2004l\r"]
[557.092807, "o", "\u001b[?2004hroot@nid007078:~/submission/tth-diphoton-bdt# "]
[558.736903, "i", "python3 /root/submission/tth-diphoton-bdt/debug_preselection.py\n"]
[558.737742, "o", "python3 /root/submission/tth-diphoton-bdt/debug_preselection.py\r\n\u001b[?2004l\r"]
[568.853101, "o", "Event 0: n_lep=0, n_jet=4, n_bjet=3 | PassHad=True, PassLep=False\r\nEvent 1: n_lep=0, n_jet=4, n_bjet=1 | PassHad=True, PassLep=False\r\nEvent 2: n_lep=2, n_jet=2, n_bjet=1 | PassHad=False, PassLep=True\r\n"]
[568.853191, "o", "Event 3: n_lep=1, n_jet=3, n_bjet=1 | PassHad=False, PassLep=True\r\nEvent 4: n_lep=2, n_jet=3, n_bjet=2 | PassHad=False, PassLep=True\r\n"]
[568.853248, "o", "Event 5: n_lep=1, n_jet=6, n_bjet=1 | PassHad=False, PassLep=True\r\n"]
[568.853298, "o", "Event 6: n_lep=1, n_jet=5, n_bjet=2 | PassHad=False, PassLep=True\r\nEvent 7: n_lep=1, n_jet=3, n_bjet=1 | PassHad=False, PassLep=True\r\n"]
[568.853469, "o", "Event 8: n_lep=0, n_jet=5, n_bjet=1 | PassHad=True, PassLep=False\r\nEvent 9: n_lep=0, n_jet=9, n_bjet=1 | PassHad=True, PassLep=False\r\n"]
[568.959408, "o", "\u001b[?2004hroot@nid007078:~/submission/tth-diphoton-bdt# "]
[576.823353, "i", "cat << 'EOF' > /root/submission/tth-diphoton-bdt/debug_preselection.py\nimport uproot\nimport numpy as np\n\ntree = uproot.open('/data/GamGam/MC/ttH_preselection.root')['analysis']\ndata = tree.arrays(['lep_pt', 'jet_pt', 'jet_btag_quantile'], library='pd').head(20)\n\nfor i, row in data.iterrows():\n    lp = row['lep_pt']\n    jp = row['jet_pt']\n    jb = row['jet_btag_quantile']\n    \n    n_lep = len(lp) if isinstance(lp, (list, np.ndarray)) else 0\n    n_jet = len(jp) if isinstance(jp, (list, np.ndarray)) else 0\n    n_bjet = sum(1 for b in jb if b >= 4) if isinstance(jb, (list, np.ndarray)) else 0\n    \n    print(f\"Event {i}: n_lep={n_lep}, n_jet={n_jet}, n_bjet={n_bjet} | PassHad={ (n_lep==0 and n_jet>=3 and n_bjet>=1) }, PassLep={ (n_lep>=1 and n_bjet>=1) }\")\nEOF\n"]
