[636.306003, "o", "root@nid007078:~/submission/tth-diphoton-bdt# "]
[637.775313, "i", "cd /root/submission/tth-diphoton-bdt && python3 run_pipeline.py\n"]
[637.775939, "o", "cd /root/submission/tth-diphoton-bdt && python3 run_pipeline.py\r\n\u001b[?2004l\r"]
[638.260319, "o", "Starting pipeline...\r\n"]
[638.262797, "o", "Processing MC: ZH_preselection.root\r\n"]
[638.328405, "o", "Processing MC: VBF_preselection.root\r\n"]
[638.359228, "o", "Processing MC: ttH_preselection.root\r\n"]
[640.303756, "o", "Processing MC: WH_preselection.root\r\n"]
[640.377355, "o", "Processing MC: ggZH_preselection.root\r\n"]
[640.439131, "o", "Processing MC: tH_preselection.root\r\n"]
[640.671434, "o", "Processing MC: ggH_preselection.root\r\n"]
[640.878398, "o", "Processing Data: /data/GamGam/data/data_preselection.root\r\n"]
[646.114607, "o", "Total events loaded: 356084\r\n"]
[646.11991, "o", "Events passing preselection: 0\r\n"]
