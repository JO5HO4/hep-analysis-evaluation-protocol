[1026.799009, "o", "root@nid007078:~/submission/tth-diphoton-bdt# "]
[1028.188286, "i", "cd /root/submission/tth-diphoton-bdt && python3 run_pipeline.py\n"]
[1028.189, "o", "cd /root/submission/tth-diphoton-bdt && python3 run_pipeline.py\r\n\u001b[?2004l\r"]
