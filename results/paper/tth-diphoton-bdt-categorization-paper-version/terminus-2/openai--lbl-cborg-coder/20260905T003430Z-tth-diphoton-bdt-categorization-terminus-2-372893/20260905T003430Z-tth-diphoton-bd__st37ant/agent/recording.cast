[825.034907, "o", "\u001b[?2004h> "]
[825.035124, "o", "    n_bjets = ak.sum(sel_jet_btag >= cfg['btag_threshold'], axis=1)\r\n\u001b[?2004l\r"]
[825.035148, "o", "\u001b[?2004h> "]
[825.035299, "o", "    # Count central jets among selected jets\r\n\u001b[?2004l\r"]
[825.035327, "o", "\u001b[?2004h> "]
[825.035566, "o", "    n_central = ak.sum(np.abs(sel_jet_eta) <= cfg['central_eta_max'], axis=1)\r\n\u001b[?2004l\r"]
