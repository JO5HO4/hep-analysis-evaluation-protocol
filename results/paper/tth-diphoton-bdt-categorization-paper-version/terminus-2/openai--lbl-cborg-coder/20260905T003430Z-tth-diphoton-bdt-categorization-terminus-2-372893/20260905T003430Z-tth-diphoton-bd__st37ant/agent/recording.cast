[646.387973, "o", "\u001b[?2004hroot@nid007078:~/submission/tth-diphoton-bdt# "]
[745.636114, "i", "cat << 'EOF' > /root/submission/tth-diphoton-bdt/run_pipeline.py\nimport os\nimport yaml\nimport pandas as pd\nimport numpy as np\nimport uproot\nimport json\nimport glob\nfrom analysis.top_categorization import *\n\nwith open('config.yaml', 'r') as f:\n    cfg = yaml.safe_load(f)\n\nres_dir = cfg['output_dir']\nos.makedirs(res_dir, exist_ok=True)\n\ndef get_mc_files(base_path):\n    targets = ['ggH', 'VBF', 'WH', 'ZH', 'ggZH', 'ttH', 'tH']\n    files = []\n    mc_dir = os.path.join(base_path, 'MC')\n    if os.path.exists(mc_dir):\n        for f in glob.glob(os.path.join(mc_dir, '*.root')):\n            if any(t in os.path.basename(f) for t in targets):\n                files.append(f)\n    return files\n\ndef get_data_files(base_path):\n    data_dir = os.path.join(base_path, 'data')\n    if os.path.exists(data_dir):\n        return glob.glob(os.path.join(data_dir, '*.root'))\n    return []\n\ndef process_tree(tree, is_mc=True, process_name='unknown'):\n    cols = [\n        'eventNumber', \n        'photon_pt', 'photon_eta', 'photon_phi', 'photon_e', 'photon_isTightID', 'photon_isTightIso',\n        'lep_pt', 'lep_eta', 'lep_phi', 'lep_type', \n        'jet_pt', 'jet_eta', 'jet_phi', 'jet_btag_quantile',\n        'mcWeight', 'xsec', 'kfac', 'filteff'\n    ]\n    available_cols = [c for c in cols if c in tree.fields]\n    df = tree.arrays(available_cols, library='pd')\n    \n    for c in cols:\n        if c not in df.columns:\n            df[c] = [[] if any(x in c for x in ['pt', 'eta', 'phi', 'quantile', 'type']) else 0.0 for _ in range(len(df))]\n\n    def calc_mgg(pts, etas, phis, es):\n        try:\n            if not hasattr(pts, '__iter__') or len(pts) < 2: return 0.0\n            p1 = np.array([pts[0]*np.cos(phis[0]), pts[0]*np.sin(phis[0]), pts[0]*np.sinh(etas[0]), es[0]])\n            p2 = np.array([pts[1]*np.cos(phis[1]), pts[1]*np.sin(phis[1]), pts[1]*np.sinh(etas[1]), es[1]])\n            m2 = (p1[3]+p2[3])**2 - (p1[0]+p2[0])**2 - (p1[1]+p2[1])**2 - (p1[2]+p2[2])**2\n            return np.sqrt(m2) if m2 > 0 else 0.0\n        except: return 0.0\n\n    df['m_gammagamma'] = df.apply(lambda r: calc_mgg(r['photon_pt'], r['photon_eta'], r['photon_phi'], r['photon_e']), axis=1)\n\n    df['n_leptons_sel'] = df['lep_pt'].apply(lambda x: sum(1 for p in x if p > cfg['lepton_pt_min']) if hasattr(x, '__iter__') else 0)\n\n    def filter_jets(pts, etas, btags):\n        jets = []\n        if not hasattr(pts, '__iter__'): return jets\n        for p, e, b in zip(pts, etas, btags):\n            if p > cfg['jet_pt_min']:\n                jets.append({'pt': p, 'eta': e, 'btag': b})\n        return jets\n\n    df['selected_jets'] = df.apply(lambda row: filter_jets(\n        row['jet_pt'], row['jet_eta'], row['jet_btag_quantile']), axis=1)\n    \n    df['n_jets'] = df['selected_jets'].apply(len)\n    df['n_bjets'] = df['selected_jets'].apply(lambda js: sum(1 for j in js if j['btag'] >= cfg['btag_threshold']))\n    df['central_jets'] = df['selected_jets'].apply(lambda js: sum(1 for j in js if abs(j['eta']) <= cfg['central_eta_max']))\n\n    df['channel'] = 'unassigned'\n    had_mask = (df['n_leptons_sel'] == 0) & (df['n_jets'] >= 3) & (df['n_bjets'] >= 1)\n    df.loc[had_mask, 'channel'] = 'hadronic'\n    lep_mask = (df['n_leptons_sel'] >= 1) & (df['n_bjets'] >= 1)\n    df.loc[lep_mask & (df['channel'] == 'unassigned'), 'channel'] = 'leptonic'\n\n    df['process'] = process_name\n    \n    # Filter immediately\n    preselected_df = df[df['channel'] != 'unassigned'].copy()\n    return preselected_df\n\ndef run_analysis():\n    print(\"Starting pipeline...\")\n    mc_files = get_mc_files(cfg['input_data'])\n    data_files = get_data_files(cfg['input_data'])\n    \n    all_preselected = []\n    for f in mc_files:\n        proc = os.path.basename(f)\n        print(f\"Processing MC: {proc}\")\n        with uproot.open(f) [\"analysis\"] as tree:\n            df_sel = process_tree(tree, is_mc=True, process_name=proc)\n            print(f\"  -> Selected: {len(df_sel)}\")\n            all_preselected.append(df_sel)\n    \n    for f in data_files:\n        print(f\"Processing Data: {f}\")\n        with uproot.open(f) [\"analysis\"] as tree:\n           "]
[745.636305, "i", " df_sel = process_tree(tree, is_mc=False, process_name='data')\n            print(f\"  -> Selected: {len(df_sel)}\")\n            all_preselected.append(df_sel)\n            \n    if not all_preselected:\n        print(\"No events passed preselection in any file.\")\n        return\n        \n    full_preselected = pd.concat(all_preselected)\n    print(f\"Total events passing preselection: {len(full_preselected)}\")\n    \n    had_count = len(full_preselected[full_preselected['channel'] == 'hadronic'])\n    lep_count = len(full_preselected[full_preselected['channel'] == 'leptonic'])\n    print(f\"Hadronic: {had_count}, Leptonic: {lep_count}\")\n\n    # Drop helper column\n    full_preselected = full_preselected.drop(columns=['selected_jets'])\n    full_preselected.to_csv(os.path.join(res_dir, 'preselected_events.csv'), index=False)\n\nif __name__ == '__main__':\n    run_analysis()\nEOF\n"]
