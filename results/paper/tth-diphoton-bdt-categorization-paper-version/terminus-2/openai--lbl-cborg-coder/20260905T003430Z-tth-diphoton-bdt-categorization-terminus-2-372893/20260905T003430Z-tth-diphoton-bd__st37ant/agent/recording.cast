[1730.130942, "o", "eventNumber,process,n_leptons_sel,n_jets,n_bjets,central_jets,H_pT,channel,m_jjj,mcWeight,xsec,kfac,filteff,m_gammagamma,is_signal,bdt_score\r\n2569219,ZH_preselection.root,0,3,1,3,45.963818,hadronic,856.0780391575944,0.77600515,0.7612,1.0,0.00227,125.0,0,0.10279068368545802\r\n2575470,ZH_preselection.root,0,4,1,4,52.400894,hadronic,326.8376547389641,0.77600515,0.7612,1.0,0.00227,125.0,0,0.1772623724403498\r\n2576202,ZH_preselection.root,0,3,2,3,133.74808,hadronic,922.9472725955329,0.77600515,0.7612,1.0,0.00227,125.0,0,0.2712523268431359\r\n2578930,ZH_preselection.root,0,5,1,5,61.836025,hadronic,327.3290217975681,0.77600515,0.7612,1.0,0.00227,125.0,0,0.24697547904555\r\n"]
[1730.131351, "o", "\u001b[?2004hroot@nid007078:~/submission/tth-diphoton-bdt# "]
