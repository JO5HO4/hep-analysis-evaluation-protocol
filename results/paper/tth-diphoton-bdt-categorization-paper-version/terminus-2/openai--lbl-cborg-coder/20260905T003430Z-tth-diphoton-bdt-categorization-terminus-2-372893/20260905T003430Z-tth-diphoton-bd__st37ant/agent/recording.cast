[116.077092, "o", "    \"\"\"Build features from jet list and b-tag quantiles.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[116.077258, "o", "    # jets: list of (pt, eta, phi, m)\r\n\u001b[?2004l\r\u001b[?2004h> "]
