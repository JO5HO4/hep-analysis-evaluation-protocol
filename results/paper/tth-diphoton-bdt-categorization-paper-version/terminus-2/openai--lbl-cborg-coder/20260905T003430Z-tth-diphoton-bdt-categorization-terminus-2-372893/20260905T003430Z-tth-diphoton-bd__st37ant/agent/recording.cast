[745.6427, "o", "\u001b[?2004h> "]
[745.64289, "o", "def process_tree(tree, is_mc=True, process_name='unknown'):\r\n\u001b[?2004l\r"]
[745.642917, "o", "\u001b[?2004h> "]
[745.642977, "o", "    cols = [\r\n\u001b[?2004l\r"]
[745.643004, "o", "\u001b[?2004h> "]
[745.643095, "o", "        'eventNumber', \r\n\u001b[?2004l\r"]
[745.643123, "o", "\u001b[?2004h> "]
[745.643479, "o", "        'photon_pt', 'photon_eta', 'photon_phi', 'photon_e', 'photon_isTightID', 'photon_isTightIso',\r\n\u001b[?2004l\r"]
[745.643507, "o", "\u001b[?2004h> "]
[745.643693, "o", "        'lep_pt', 'lep_eta', 'lep_phi', 'lep_type', \r\n\u001b[?2004l\r"]
[745.64372, "o", "\u001b[?2004h> "]
[745.643936, "o", "        'jet_pt', 'jet_eta', 'jet_phi', 'jet_btag_quantile',\r\n\u001b[?2004l\r"]
[745.643965, "o", "\u001b[?2004h> "]
[745.644127, "o", "        'mcWeight', 'xsec', 'kfac', 'filteff'\r\n\u001b[?2004l\r"]
[745.644158, "o", "\u001b[?2004h> "]
[745.644186, "o", "    ]\r\n\u001b[?2004l\r"]
[745.644213, "o", "\u001b[?2004h> "]
[745.644424, "o", "    available_cols = [c for c in cols if c in tree.fields]\r\n\u001b[?2004l\r"]
[745.644452, "o", "\u001b[?2004h> "]
[745.644627, "o", "    df = tree.arrays(available_cols, library='pd')\r\n\u001b[?2004l\r"]
[745.644656, "o", "\u001b[?2004h> "]
[745.644682, "o", "    \r\n\u001b[?2004l\r"]
[745.644709, "o", "\u001b[?2004h> "]
[745.644785, "o", "    for c in cols:\r\n\u001b[?2004l\r"]
[745.644843, "o", "\u001b[?2004h> "]
[745.644936, "o", "        if c not in df.columns:\r\n\u001b[?2004l\r"]
[745.644965, "o", "\u001b[?2004h> "]
[745.645393, "o", "            df[c] = [[] if any(x in c for x in ['pt', 'eta', 'phi', 'quantile', 'type']) else 0.0 for _ in range(len(df))]\r\n\u001b[?2004l\r"]
[745.645421, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[745.645448, "o", "\u001b[?2004h> "]
[745.645598, "o", "    def calc_mgg(pts, etas, phis, es):\r\n\u001b[?2004l\r"]
[745.645626, "o", "\u001b[?2004h> "]
[745.64568, "o", "        try:\r\n\u001b[?2004l\r\u001b[?2004h"]
[745.645707, "o", "> "]
[745.645955, "o", "            if not hasattr(pts, '__iter__') or len(pts) < 2: return 0.0\r\n\u001b[?2004l\r"]
[745.645983, "o", "\u001b[?2004h> "]
[745.646363, "o", "            p1 = np.array([pts[0]*np.cos(phis[0]), pts[0]*np.sin(phis[0]), pts[0]*np.sinh(etas[0]), es[0]])\r\n\u001b[?2004l\r"]
[745.646392, "o", "\u001b[?2004h> "]
[745.646765, "o", "            p2 = np.array([pts[1]*np.cos(phis[1]), pts[1]*np.sin(phis[1]), pts[1]*np.sinh(etas[1]), es[1]])\r\n\u001b[?2004l\r"]
[745.646794, "o", "\u001b[?2004h> "]
[745.647107, "o", "            m2 = (p1[3]+p2[3])**2 - (p1[0]+p2[0])**2 - (p1[1]+p2[1])**2 - (p1[2]+p2[2])**2\r\n\u001b[?2004l\r"]
[745.647135, "o", "\u001b[?2004h> "]
[745.64731, "o", "            return np.sqrt(m2) if m2 > 0 else 0.0\r\n\u001b[?2004l\r"]
[745.647354, "o", "\u001b[?2004h> "]
[745.647438, "o", "        except: return 0.0\r\n\u001b[?2004l\r"]
[745.647465, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[745.647521, "o", "\u001b[?2004h> "]
[745.647939, "o", "    df['m_gammagamma'] = df.apply(lambda r: calc_mgg(r['photon_pt'], r['photon_eta'], r['photon_phi'], r['photon_e']), axis=1)\r\n\u001b[?2004l\r"]
[745.647968, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[745.647994, "o", "\u001b[?2004h> "]
[745.648475, "o", "    df['n_leptons_sel'] = df['lep_pt'].apply(lambda x: sum(1 for p in x if p > cfg['lepton_pt_min']) if hasattr(x, '__iter__') else 0)\r\n\u001b[?2004l\r"]
[745.648502, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[745.648558, "o", "\u001b[?2004h> "]
[745.648674, "o", "    def filter_jets(pts, etas, btags):\r\n\u001b[?2004l\r"]
[745.6487, "o", "\u001b[?2004h> "]
[745.648769, "o", "        jets = []\r\n\u001b[?2004l\r"]
[745.648795, "o", "\u001b[?2004h> "]
[745.648993, "o", "        if not hasattr(pts, '__iter__'): return jets\r\n\u001b[?2004l\r"]
[745.64902, "o", "\u001b[?2004h> "]
[745.649182, "o", "        for p, e, b in zip(pts, etas, btags):\r\n\u001b[?2004l\r"]
[745.64921, "o", "\u001b[?2004h> "]
[745.649347, "o", "            if p > cfg['jet_pt_min']:\r\n\u001b[?2004l\r"]
[745.649391, "o", "\u001b[?2004h> "]
[745.649586, "o", "                jets.append({'pt': p, 'eta': e, 'btag': b})\r\n\u001b[?2004l\r"]
[745.649615, "o", "\u001b[?2004h> "]
[745.649691, "o", "        return jets\r\n\u001b[?2004l\r"]
[745.64972, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[745.649747, "o", "\u001b[?2004h> "]
[745.649971, "o", "    df['selected_jets'] = df.apply(lambda row: filter_jets(\r\n\u001b[?2004l\r"]
[745.649998, "o", "\u001b[?2004h> "]
[745.650252, "o", "        row['jet_pt'], row['jet_eta'], row['jet_btag_quantile']), axis=1)\r\n\u001b[?2004l\r"]
[745.650279, "o", "\u001b[?2004h> "]
[745.650333, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.650508, "o", "    df['n_jets'] = df['selected_jets'].apply(len)\r\n\u001b[?2004l\r"]
[745.650534, "o", "\u001b[?2004h> "]
[745.65094, "o", "    df['n_bjets'] = df['selected_jets'].apply(lambda js: sum(1 for j in js if j['btag'] >= cfg['btag_threshold']))\r\n\u001b[?2004l\r"]
[745.650968, "o", "\u001b[?2004h> "]
[745.651401, "o", "    df['central_jets'] = df['selected_jets'].apply(lambda js: sum(1 for j in js if abs(j['eta']) <= cfg['central_eta_max']))\r\n\u001b[?2004l\r"]
[745.65143, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[745.651458, "o", "\u001b[?2004h> "]
[745.651584, "o", "    df['channel'] = 'unassigned'\r\n\u001b[?2004l\r"]
[745.651612, "o", "\u001b[?2004h> "]
[745.651913, "o", "    had_mask = (df['n_leptons_sel'] == 0) & (df['n_jets'] >= 3) & (df['n_bjets'] >= 1)\r\n\u001b[?2004l\r"]
[745.65194, "o", "\u001b[?2004h> "]
[745.652102, "o", "    df.loc[had_mask, 'channel'] = 'hadronic'\r\n\u001b[?2004l\r"]
[745.65213, "o", "\u001b[?2004h> "]
[745.652359, "o", "    lep_mask = (df['n_leptons_sel'] >= 1) & (df['n_bjets'] >= 1)\r\n\u001b[?2004l\r"]
[745.652386, "o", "\u001b[?2004h> "]
[745.652672, "o", "    df.loc[lep_mask & (df['channel'] == 'unassigned'), 'channel'] = 'leptonic'\r\n\u001b[?2004l\r\u001b[?2004h"]
[745.652699, "o", "> \r\n\u001b[?2004l\r"]
[745.652761, "o", "\u001b[?2004h> "]
[745.652851, "o", "    df['process'] = process_name\r\n\u001b[?2004l\r"]
[745.652881, "o", "\u001b[?2004h> "]
[745.652907, "o", "    \r\n\u001b[?2004l\r"]
[745.652988, "o", "\u001b[?2004h> "]
[745.653041, "o", "    # Filter immediately\r\n\u001b[?2004l\r\u001b[?2004h"]
[745.653069, "o", "> "]
[745.653271, "o", "    preselected_df = df[df['channel'] != 'unassigned'].copy()\r\n\u001b[?2004l\r"]
[745.653298, "o", "\u001b[?2004h> "]
[745.653391, "o", "    return preselected_df\r\n\u001b[?2004l\r"]
[745.653418, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[745.653479, "o", "\u001b[?2004h> "]
[745.653531, "o", "def run_analysis():\r\n\u001b[?2004l\r"]
[745.653561, "o", "\u001b[?2004h> "]
[745.653677, "o", "    print(\"Starting pipeline...\")\r\n\u001b[?2004l\r"]
[745.653704, "o", "\u001b[?2004h> "]
[745.653872, "o", "    mc_files = get_mc_files(cfg['input_data'])\r\n\u001b[?2004l\r"]
[745.653899, "o", "\u001b[?2004h> "]
[745.654081, "o", "    data_files = get_data_files(cfg['input_data'])\r\n\u001b[?2004l\r"]
[745.654109, "o", "\u001b[?2004h> "]
[745.654139, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[745.654166, "o", "> "]
[745.654254, "o", "    all_preselected = []\r\n\u001b[?2004l\r"]
[745.654282, "o", "\u001b[?2004h> "]
[745.654362, "o", "    for f in mc_files:\r\n\u001b[?2004l\r"]
[745.65439, "o", "\u001b[?2004h> "]
[745.654515, "o", "        proc = os.path.basename(f)\r\n\u001b[?2004l\r"]
[745.654543, "o", "\u001b[?2004h> "]
[745.654684, "o", "        print(f\"Processing MC: {proc}\")\r\n\u001b[?2004l\r"]
[745.654713, "o", "\u001b[?2004h> "]
[745.65489, "o", "        with uproot.open(f) [\"analysis\"] as tree:\r\n\u001b[?2004l\r"]
[745.654917, "o", "\u001b[?2004h> "]
[745.655166, "o", "            df_sel = process_tree(tree, is_mc=True, process_name=proc)\r\n\u001b[?2004l\r"]
[745.655194, "o", "\u001b[?2004h> "]
[745.655377, "o", "            print(f\"  -> Selected: {len(df_sel)}\")\r\n\u001b[?2004l\r"]
[745.655405, "o", "\u001b[?2004h> "]
[745.655554, "o", "            all_preselected.append(df_sel)\r\n\u001b[?2004l\r"]
[745.655581, "o", "\u001b[?2004h> "]
[745.655638, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.655722, "o", "    for f in data_files:\r\n\u001b[?2004l\r"]
[745.655748, "o", "\u001b[?2004h> "]
[745.655888, "o", "        print(f\"Processing Data: {f}\")\r\n\u001b[?2004l\r"]
[745.655917, "o", "\u001b[?2004h> "]
[745.656091, "o", "        with uproot.open(f) [\"analysis\"] as tree:\r\n\u001b[?2004l\r"]
[745.65612, "o", "\u001b[?2004h> "]
[745.656377, "o", "            df_sel = process_tree(tree, is_mc=False, process_name='data')\r\n\u001b[?2004l\r"]
[745.656404, "o", "\u001b[?2004h> "]
[745.656583, "o", "            print(f\"  -> Selected: {len(df_sel)}\")\r\n\u001b[?2004l\r"]
[745.65661, "o", "\u001b[?2004h> "]
[745.656762, "o", "            all_preselected.append(df_sel)\r\n\u001b[?2004l\r"]
[745.656789, "o", "\u001b[?2004h> "]
[745.656863, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h"]
[745.656897, "o", "> "]
[745.65698, "o", "    if not all_preselected:\r\n\u001b[?2004l\r"]
[745.657007, "o", "\u001b[?2004h> "]
[745.657217, "o", "        print(\"No events passed preselection in any file.\")\r\n\u001b[?2004l\r"]
[745.657244, "o", "\u001b[?2004h> "]
[745.657303, "o", "        return\r\n\u001b[?2004l\r"]
[745.65733, "o", "\u001b[?2004h> "]
[745.657391, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.657566, "o", "    full_preselected = pd.concat(all_preselected)\r\n\u001b[?2004l\r"]
[745.657593, "o", "\u001b[?2004h> "]
[745.65785, "o", "    print(f\"Total events passing preselection: {len(full_preselected)}\")\r\n\u001b[?2004l\r"]
[745.657877, "o", "\u001b[?2004h> "]
[745.657936, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[745.658208, "o", "    had_count = len(full_preselected[full_preselected['channel'] == 'hadronic'])\r\n\u001b[?2004l\r"]
[745.658236, "o", "\u001b[?2004h> "]
[745.658521, "o", "    lep_count = len(full_preselected[full_preselected['channel'] == 'leptonic'])\r\n\u001b[?2004l\r"]
[745.65855, "o", "\u001b[?2004h> "]
[745.658754, "o", "    print(f\"Hadronic: {had_count}, Leptonic: {lep_count}\")\r\n\u001b[?2004l\r"]
[745.658781, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[745.658841, "o", "\u001b[?2004h> "]
[745.658911, "o", "    # Drop helper column\r\n\u001b[?2004l\r"]
[745.658938, "o", "\u001b[?2004h> "]
[745.659192, "o", "    full_preselected = full_preselected.drop(columns=['selected_jets'])\r\n\u001b[?2004l\r"]
[745.659219, "o", "\u001b[?2004h> "]
[745.659545, "o", "    full_preselected.to_csv(os.path.join(res_dir, 'preselected_events.csv'), index=False)\r\n\u001b[?2004l\r"]
[745.659573, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[745.65963, "o", "\u001b[?2004h> "]
[745.659706, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[745.659734, "o", "\u001b[?2004h> "]
[745.659809, "o", "    run_analysis()\r\n\u001b[?2004l\r"]
[745.659837, "o", "\u001b[?2004h> "]
[745.659896, "o", "EOF\r\n\u001b[?2004l\r"]
[745.664332, "o", "\u001b[?2004h"]
[745.66437, "o", "root@nid007078:~/submission/tth-diphoton-bdt# "]
[747.093869, "i", "cd /root/submission/tth-diphoton-bdt && python3 run_pipeline.py\n"]
[747.094536, "o", "cd /root/submission/tth-diphoton-bdt && python3 run_pipeline.py\r\n\u001b[?2004l\r"]
[747.571963, "o", "Starting pipeline...\r\n"]
[747.577599, "o", "Processing MC: ZH_preselection.root\r\n"]
[747.638096, "o", "  -> Selected: 0\r\nProcessing MC: VBF_preselection.root\r\n"]
[747.668051, "o", "  -> Selected: 0\r\nProcessing MC: ttH_preselection.root\r\n"]
[750.134136, "o", "  -> Selected: 0\r\nProcessing MC: WH_preselection.root\r\n"]
[750.196434, "o", "  -> Selected: 0\r\nProcessing MC: ggZH_preselection.root\r\n"]
[750.247642, "o", "  -> Selected: 0\r\nProcessing MC: tH_preselection.root\r\n"]
[750.552457, "o", "  -> Selected: 0\r\nProcessing MC: ggH_preselection.root\r\n"]
[750.68471, "o", "  -> Selected: 0\r\nProcessing Data: /data/GamGam/data/data_preselection.root\r\n"]
[756.890048, "o", "  -> Selected: 0\r\n"]
[756.891709, "o", "Total events passing preselection: 0\r\n"]
[756.892437, "o", "Hadronic: 0, Leptonic: 0\r\n"]
[757.063829, "o", "\u001b[?2004hroot@nid007078:~/submission/tth-diphoton-bdt# "]
[825.024974, "i", "cat << 'EOF' > /root/submission/tth-diphoton-bdt/run_pipeline.py\nimport os\nimport yaml\nimport pandas as pd\nimport numpy as np\nimport uproot\nimport json\nimport glob\nimport awkward as ak\nfrom analysis.top_categorization import *\n\nwith open('config.yaml', 'r') as f:\n    cfg = yaml.safe_load(f)\n\nres_dir = cfg['output_dir']\nos.makedirs(res_dir, exist_ok=True)\n\ndef get_mc_files(base_path):\n    targets = ['ggH', 'VBF', 'WH', 'ZH', 'ggZH', 'ttH', 'tH']\n    files = []\n    mc_dir = os.path.join(base_path, 'MC')\n    if os.path.exists(mc_dir):\n        for f in glob.glob(os.path.join(mc_dir, '*.root')):\n            if any(t in os.path.basename(f) for t in targets):\n                files.append(f)\n    return files\n\ndef get_data_files(base_path):\n    data_dir = os.path.join(base_path, 'data')\n    if os.path.exists(data_dir):\n        return glob.glob(os.path.join(data_dir, '*.root'))\n    return []\n\ndef process_tree(tree, is_mc=True, process_name='unknown'):\n    # Load all fields as Awkward Arrays\n    data = tree.arrays()\n    \n    # Preselection logic using Awkward arrays\n    # 1. Leptons > 10 GeV\n    lep_pt = data.lep_pt if 'lep_pt' in data.fields() else ak. la.zeros(len(data), type='float64')\n    n_lep_sel = ak.sum(lep_pt > cfg['lepton_pt_min'], axis=1)\n    \n    # 2. Jets > 25 GeV and b-tags\n    jet_pt = data.jet_pt if 'jet_pt' in data.fields() else ak. la.zeros(len(data), type='float64')\n    jet_eta = data.jet_eta if 'jet_eta' in data.fields() else ak. la.zeros(len(data), type='float64')\n    jet_btag = data.jet_btag_quantile if 'jet_btag_quantile' in data.fields() else ak. la.zeros(len(data), type='float64')\n    \n    # Create masks for jets passing pT cut\n    jet_pt_mask = jet_pt > cfg['jet_pt_min']\n    sel_jet_pt = jet_pt[jet_pt_mask]\n    sel_jet_eta = jet_eta[jet_pt_mask]\n    sel_jet_btag = jet_btag[jet_pt_mask]\n    \n    # Count selected jets\n    n_jets = ak.num(sel_jet_pt)\n    # Count b-jets among selected jets\n    n_bjets = ak.sum(sel_jet_btag >= cfg['btag_threshold'], axis=1)\n    # Count central jets among selected jets\n    n_central = ak.sum(np.abs(sel_jet_eta) <= cfg['central_eta_max'], axis=1)\n\n    # Define channels\n    hadronic_mask = (n_lep_sel == 0) & (n_jets >= 3) & (n_bjets >= 1)\n    leptonic_mask = (n_lep_sel >= 1) & (n_bjets >= 1)\n    \n    # Combine masks\n    sel_mask = hadronic_mask | leptonic_mask\n    \n    # Extract preselected data\n    pre_data = data[sel_mask]\n    if len(pre_data) == 0:\n        return pd.DataFrame()\n\n    # Convert to pandas\n    # We need to handle jagged arrays by taking a representation (like a list)\n    res_df = pd.DataFrame({\n        'eventNumber': pre_data.eventNumber if 'eventNumber' in pre_data.fields() else np.arange(len(pre_data)),\n        'process': process_name,\n        'n_leptons_sel': n_lep_sel[sel_mask],\n        'n_jets': n_jets[sel_mask],\n        'n_bjets': n_bjets[sel_mask],\n        'central_jets': n_central[sel_mask],\n        'channel': np.where(hadronic_mask[sel_mask], 'hadronic', 'leptonic')\n    })\n    \n    # Add weight and mass (calculated similarly)\n    if 'mcWeight' in pre_data.fields(): res_df['mcWeight'] = pre_data.mcWeight\n    if 'xsec' in pre_data.fields(): res_df['xsec'] = pre_data.xsec\n    if 'kfac' in pre_data.fields(): res_df['kfac'] = pre_data.kfac\n    if 'filteff' in pre_data.fields(): res_df['filteff'] = pre_data.filteff\n    \n    return res_df\n\ndef run_analysis():\n    print(\"Starting pipeline...\")\n    mc_files = get_mc_files(cfg['input_data'])\n    data_files = get_data_files(cfg['input_data'])\n    \n    all_preselected = []\n    for f in mc_files:\n        proc = os.path.basename(f)\n        print(f\"Processing MC: {proc}\")\n        with uproot.open(f) [\"analysis\"] as tree:\n            df_sel = process_tree(tree, is_mc=True, process_name=proc)\n            print(f\"  -> Selected: {len(df_sel)}\")\n            all_preselected.append(df_sel)\n    \n    for f in data_files:\n        print(f\"Processing Data: {f}\")\n        with uproot.open(f) [\"analysis\"] as tree:\n            df_sel = process_tree(tree, is_mc=False, process_name='data')\n            print(f\"  -> Selected: {len(df_sel)}"]
[825.025063, "i", "\")\n            all_preselected.append(df_sel)\n            \n    if not all_preselected or len(pd.concat(all_preselected)) == 0:\n        print(\"No events passed preselection.\")\n        return\n        \n    full_preselected = pd.concat(all_preselected)\n    print(f\"Total events passing preselection: {len(full_preselected)}\")\n    \n    had_count = len(full_preselected[full_preselected['channel'] == 'hadronic'])\n    lep_count = len(full_preselected[full_preselected['channel'] == 'leptonic'])\n    print(f\"Hadronic: {had_count}, Leptonic: {lep_count}\")\n\n    full_preselected.to_csv(os.path.join(res_dir, 'preselected_events.csv'), index=False)\n\nif __name__ == '__main__':\n    run_analysis()\nEOF\n"]
