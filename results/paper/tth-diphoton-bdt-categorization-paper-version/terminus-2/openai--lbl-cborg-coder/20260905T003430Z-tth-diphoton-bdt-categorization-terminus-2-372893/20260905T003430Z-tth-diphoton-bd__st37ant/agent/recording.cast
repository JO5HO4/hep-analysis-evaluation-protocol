[176.223218, "i", "cat << 'EOF' > /root/submission/tth-diphoton-bdt/run_pipeline.py\nimport os\nimport yaml\nimport pandas as pd\nimport numpy as np\nimport uproot\nimport json\nfrom analysis.top_categorization import *\n\n# Load config\nwith open('config.yaml', 'r') as f:\n    cfg = yaml.safe_load(f)\n\ndef load_data(path):\n    # Expected layout: MC/ and data/\n    mc_path = os.path.join(path, 'MC')\n    data_path = os.path.join(path, 'data')\n    \n    # This is a mockup of the loading process to fit the script structure\n    # In reality, we'd iterate through files in these directories\n    return [], [] # return mc_dfs, data_dfs\n\ndef run_analysis():\n    print(\"Starting pipeline...\")\n    # 1. Load Data\n    # 2. Preselection\n    # 3. BDT Training\n    # 4. Categorization\n    # 5. RooFit Workspace\n    # 6. Reporting\n    print(\"Pipeline completed (skeleton).\")\n\nif __name__ == '__main__':\n    run_analysis()\nEOF\n"]
