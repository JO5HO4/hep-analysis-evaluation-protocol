[116.077542, "o", "> "]
[116.07769, "o", "    n_bjets = sum(1 for b in btags if b >= 4)\r\n\u001b[?2004l\r"]
[116.077727, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[116.077763, "o", "\u001b[?2004h> "]
[116.077901, "o", "    # Central jets: |eta| <= 2.5\r\n\u001b[?2004l\r\u001b[?2004h"]
[116.07794, "o", "> "]
[116.078126, "o", "    central_jets = [j for j in jets if abs(j[1]) <= 2.5]\r\n\u001b[?2004l\r"]
[116.078163, "o", "\u001b[?2004h> "]
