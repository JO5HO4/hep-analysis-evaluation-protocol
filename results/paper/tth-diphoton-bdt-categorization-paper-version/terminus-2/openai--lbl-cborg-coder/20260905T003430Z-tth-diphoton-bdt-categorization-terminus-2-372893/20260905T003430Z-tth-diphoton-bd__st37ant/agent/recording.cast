[116.081865, "o", "\u001b[?2004h> "]
[116.081951, "o", "            return part\r\n\u001b[?2004l\r\u001b[?2004h"]
[116.081992, "o", "> "]
[116.08207, "o", "    return 'test'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[116.08211, "o", "\u001b[?2004h> "]
[116.082326, "o", "def assign_top_category(event, score=None, thresholds=None):\r\n\u001b[?2004l\r\u001b[?2004h"]
[116.082369, "o", "> "]
[116.082531, "o", "    \"\"\"Assign event to a hadronic category.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[116.082573, "o", "> "]
[116.082759, "o", "    # event is a dict containing selection flags and counts\r\n\u001b[?2004l\r\u001b[?2004h"]
[116.082798, "o", "> "]
[116.082932, "o", "    n_leptons = event.get('n_leptons', 0)\r\n\u001b[?2004l\r"]
[116.082969, "o", "\u001b[?2004h> "]
[116.083101, "o", "    n_jets = event.get('n_jets', 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[116.08314, "o", "> "]
[116.083267, "o", "    n_bjets = event.get('n_bjets', 0)\r\n\u001b[?2004l\r\u001b[?2004h"]
[116.083309, "o", "> "]
[116.083456, "o", "    central_jets = event.get('central_jets', 0)\r\n\u001b[?2004l\r"]
[116.083501, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[116.083534, "o", "> "]
[116.083654, "o", "    # 1. Hadronic BDT Categories\r\n\u001b[?2004l\r\u001b[?2004h"]
[116.083694, "o", "> "]
[116.083871, "o", "    if n_leptons == 0 and n_jets >= 3 and n_bjets >= 1:\r\n\u001b[?2004l\r"]
[116.083909, "o", "\u001b[?2004h> "]
[116.084106, "o", "        if score is not None and thresholds is not None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[116.084149, "o", "> "]
[116.084315, "o", "            for i, thresh in enumerate(thresholds):\r\n\u001b[?2004l\r\u001b[?2004h"]
[116.084355, "o", "> "]
[116.084477, "o", "                if score >= thresh:\r\n\u001b[?2004l\r\u001b[?2004h"]
[116.084517, "o", "> "]
[116.084669, "o", "                    return f'ttH_had_BDT{i+1}'\r\n\u001b[?2004l\r\u001b[?2004h"]
[116.084709, "o", "> "]
[116.084745, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[116.084955, "o", "    # 2. Cut-based tH categories (Lower Priority)\r\n\u001b[?2004l\r\u001b[?2004h"]
[116.084994, "o", "> "]
[116.085146, "o", "    if n_leptons == 0 and central_jets == 4:\r\n\u001b[?2004l\r\u001b[?2004h"]
[116.085186, "o", "> "]
[116.085273, "o", "        if n_bjets == 1:\r\n\u001b[?2004l\r\u001b[?2004h"]
[116.085311, "o", "> "]
[116.085408, "o", "            return 'tH_had_4j1b'\r\n\u001b[?2004l\r"]
[116.085448, "o", "\u001b[?2004h> "]
[116.085543, "o", "        elif n_bjets >= 2:\r\n\u001b[?2004l\r\u001b[?2004h"]
[116.085584, "o", "> "]
[116.085684, "o", "            return 'tH_had_4j2b'\r\n\u001b[?2004l\r"]
[116.085724, "o", "\u001b[?2004h> "]
[116.085766, "o", "            \r\n\u001b[?2004l\r"]
[116.085798, "o", "\u001b[?2004h> "]
[116.085914, "o", "    return 'unassigned'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[116.085954, "o", "\u001b[?2004h> "]
[116.086122, "o", "def optimize_bdt_boundaries(rows, config=None):\r\n\u001b[?2004l\r\u001b[?2004h"]
[116.086165, "o", "> "]
[116.086429, "o", "    \"\"\"Iteratively optimize BDT boundaries based on significance improvement.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[116.086469, "o", "> "]
[116.08666, "o", "    # This is a skeleton for the iterative optimization\r\n\u001b[?2004l\r\u001b[?2004h"]
[116.086698, "o", "> "]
[116.086972, "o", "    # It would normally loop through possible thresholds and calculate S/sqrt(B)\r\n\u001b[?2004l\r"]
[116.08701, "o", "\u001b[?2004h> "]
[116.087317, "o", "    return [0.2, 0.4, 0.6, 0.8], [0.1, 0.06, 0.055, 0.051] # thresholds, improvements\r\n\u001b[?2004l\r\u001b[?2004h"]
[116.087358, "o", "> EOF\r\n\u001b[?2004l\r"]
