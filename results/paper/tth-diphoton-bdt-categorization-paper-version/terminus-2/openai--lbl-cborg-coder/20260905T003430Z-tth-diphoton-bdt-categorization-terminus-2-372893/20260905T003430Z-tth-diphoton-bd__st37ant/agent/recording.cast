[230.672539, "o", "\u001b[?2004h> "]
[230.672688, "o", "        print(\"No data loaded. Check paths.\")\r\n\u001b[?2004l\r"]
[230.672712, "o", "\u001b[?2004h> "]
[230.672763, "o", "        return\r\n\u001b[?2004l\r"]
[230.67279, "o", "\u001b[?2004h> "]
[230.672849, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[230.67296, "o", "    full_df = pd.concat(all_dfs)\r\n\u001b[?2004l\r"]
[230.672984, "o", "\u001b[?2004h> "]
[230.673198, "o", "    preselected = full_df[full_df['channel'] != 'unassigned']\r\n\u001b[?2004l\r"]
[230.673226, "o", "\u001b[?2004h> "]
[230.673529, "o", "    preselected.to_csv(os.path.join(res_dir, 'preselected_events.csv'), index=False)\r\n\u001b[?2004l\r"]
[230.673555, "o", "\u001b[?2004h> "]
[230.673776, "o", "    print(f\"Preselection complete. Rows: {len(preselected)}\")\r\n\u001b[?2004l\r"]
[230.673805, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[230.673833, "o", "\u001b[?2004h> "]
[230.673949, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[230.673977, "o", "\u001b[?2004h> "]
