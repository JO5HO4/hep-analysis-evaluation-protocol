[948.262958, "i", "cat << 'EOF' > /root/submission/tth-diphoton-bdt/run_pipeline.py\nimport os\nimport yaml\nimport pandas as pd\nimport numpy as np\nimport uproot\nimport json\nimport glob\nimport awkward as ak\nfrom analysis.top_categorization import *\n\nwith open('config.yaml', 'r') as f:\n    cfg = yaml.safe_load(f)\n\nres_dir = cfg['output_dir']\nos.makedirs(res_dir, exist_ok=True)\n\ndef get_mc_files(base_path):\n    targets = ['ggH', 'VBF', 'WH', 'ZH', 'ggZH', 'ttH', 'tH']\n    files = []\n    mc_dir = os.path.join(base_path, 'MC')\n    if os.path.exists(mc_dir):\n        for f in glob.glob(os.path.join(mc_dir, '*.root')):\n            if any(t in os.path.basename(f) for t in targets):\n                files.append(f)\n    return files\n\ndef get_data_files(base_path):\n    data_dir = os.path.join(base_path, 'data')\n    if os.path.exists(data_dir):\n        return glob.glob(os.path.join(data_dir, '*.root'))\n    return []\n\ndef process_tree(tree, is_mc=True, process_name='unknown'):\n    data = tree.arrays()\n    \n    lep_pt = data.lep_pt if 'lep_pt' in data.fields else ak.zeros(len(data), type='float64')\n    n_lep_sel = ak.sum(lep_pt > cfg['lepton_pt_min'], axis=1)\n    \n    jet_pt = data.jet_pt if 'jet_pt' in data.fields else ak.zeros(len(data), type='float64')\n    jet_eta = data.jet_eta if 'jet_eta' in data.fields else ak.zeros(len(data), type='float64')\n    jet_btag = data.jet_btag_quantile if 'jet_btag_quantile' in data.fields else ak.zeros(len(data), type='float64')\n    \n    jet_pt_mask = jet_pt > cfg['jet_pt_min']\n    sel_jet_pt = jet_pt[jet_pt_mask]\n    sel_jet_eta = jet_eta[jet_pt_mask]\n    sel_jet_btag = jet_btag[jet_pt_mask]\n    \n    n_jets = ak.num(sel_jet_pt)\n    n_bjets = ak.sum(sel_jet_btag >= cfg['btag_threshold'], axis=1)\n    n_central = ak.sum(np.abs(sel_jet_eta) <= cfg['central_eta_max'], axis=1)\n\n    hadronic_mask = (n_lep_sel == 0) & (n_jets >= 3) & (n_bjets >= 1)\n    leptonic_mask = (n_lep_sel >= 1) & (n_bjets >= 1)\n    sel_mask = hadronic_mask | leptonic_mask\n    \n    pre_data = data[sel_mask]\n    if len(pre_data) == 0:\n        return pd.DataFrame()\n\n    res_df = pd.DataFrame({\n        'eventNumber': pre_data.eventNumber if 'eventNumber' in pre_data.fields else np.arange(len(pre_data)),\n        'process': process_name,\n        'n_leptons_sel': np.array(n_lep_sel[sel_mask]),\n        'n_jets': np.array(n_jets[sel_mask]),\n        'n_bjets': np.array(n_bjets[sel_mask]),\n        'central_jets': np.array(n_central[sel_mask])\n    })\n    \n    # Use pandas to assign channel based on the original masks filtered by sel_mask\n    channels = np.where(hadronic_mask[sel_mask], 'hadronic', 'leptonic')\n    res_df['channel'] = channels\n\n    if 'mcWeight' in pre_data.fields: res_df['mcWeight'] = np.array(pre_data.mcWeight)\n    if 'xsec' in pre_data.fields: res_df['xsec'] = np.array(pre_data.xsec)\n    if 'kfac' in pre_data.fields: res_df['kfac'] = np.array(pre_data.kfac)\n    if 'filteff' in pre_data.fields: res_df['filteff'] = np.array(pre_data.filteff)\n    \n    return res_df\n\ndef run_analysis():\n    print(\"Starting pipeline...\")\n    mc_files = get_mc_files(cfg['input_data'])\n    data_files = get_data_files(cfg['input_data'])\n    \n    all_preselected = []\n    for f in mc_files:\n        proc = os.path.basename(f)\n        print(f\"Processing MC: {proc}\")\n        with uproot.open(f) [\"analysis\"] as tree:\n            df_sel = process_tree(tree, is_mc=True, process_name=proc)\n            print(f\"  -> Selected: {len(df_sel)}\")\n            all_preselected.append(df_sel)\n    \n    for f in data_files:\n        print(f\"Processing Data: {f}\")\n        with uproot.open(f) [\"analysis\"] as tree:\n            df_sel = process_tree(tree, is_mc=False, process_name='data')\n            print(f\"  -> Selected: {len(df_sel)}\")\n            all_preselected.append(df_sel)\n            \n    if not all_preselected or len(pd.concat(all_preselected)) == 0:\n        print(\"No events passed preselection.\")\n        return\n        \n    full_preselected = pd.concat(all_preselected)\n    print(f\"Total events passing preselection: {len(full_preselected)}\")\n    \n    had_count = len(full_preselected[full_p"]
[948.263023, "i", "reselected['channel'] == 'hadronic'])\n    lep_count = len(full_preselected[full_preselected['channel'] == 'leptonic'])\n    print(f\"Hadronic: {had_count}, Leptonic: {lep_count}\")\n\n    full_preselected.to_csv(os.path.join(res_dir, 'preselected_events.csv'), index=False)\n\nif __name__ == '__main__':\n    run_analysis()\nEOF\n"]
[948.263847, "o", "cat << 'EOF' > /root/submission/tth-diphoton-bdt/run_pipeline.py\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h"]
[948.263983, "o", "> "]
[948.264042, "o", "import yaml\r\n\u001b[?2004l\r\u001b[?2004h> "]
[948.264182, "o", "import pandas as pd\r\n\u001b[?2004l\r"]
[948.264236, "o", "\u001b[?2004h> "]
[948.264367, "o", "import numpy as np\r\n\u001b[?2004l\r"]
[948.264397, "o", "\u001b[?2004h> "]
[948.264473, "o", "import uproot\r\n\u001b[?2004l\r"]
[948.264501, "o", "\u001b[?2004h> "]
[948.264568, "o", "import json\r\n\u001b[?2004l\r"]
[948.264597, "o", "\u001b[?2004h> "]
[948.264669, "o", "import glob\r\n\u001b[?2004l\r"]
[948.264696, "o", "\u001b[?2004h> "]
[948.264794, "o", "import awkward as ak\r\n\u001b[?2004l\r"]
[948.264854, "o", "\u001b[?2004h> "]
[948.265022, "o", "from analysis.top_categorization import *\r\n\u001b[?2004l\r"]
[948.26505, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[948.26508, "o", "\u001b[?2004h> "]
[948.265239, "o", "with open('config.yaml', 'r') as f:\r\n\u001b[?2004l\r"]
[948.265267, "o", "\u001b[?2004h> "]
[948.265383, "o", "    cfg = yaml.safe_load(f)\r\n\u001b[?2004l\r"]
[948.26541, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[948.26547, "o", "\u001b[?2004h> "]
[948.265569, "o", "res_dir = cfg['output_dir']\r\n\u001b[?2004l\r"]
[948.265596, "o", "\u001b[?2004h> "]
[948.265721, "o", "os.makedirs(res_dir, exist_ok=True)\r\n\u001b[?2004l\r"]
[948.26575, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[948.265811, "o", "\u001b[?2004h> "]
[948.265891, "o", "def get_mc_files(base_path):\r\n\u001b[?2004l\r"]
[948.26592, "o", "\u001b[?2004h> "]
[948.266139, "o", "    targets = ['ggH', 'VBF', 'WH', 'ZH', 'ggZH', 'ttH', 'tH']\r\n\u001b[?2004l\r"]
[948.266168, "o", "\u001b[?2004h> "]
[948.266225, "o", "    files = []\r\n\u001b[?2004l\r"]
[948.266254, "o", "\u001b[?2004h> "]
[948.266404, "o", "    mc_dir = os.path.join(base_path, 'MC')\r\n\u001b[?2004l\r"]
[948.266431, "o", "\u001b[?2004h> "]
[948.266546, "o", "    if os.path.exists(mc_dir):\r\n\u001b[?2004l\r"]
[948.266572, "o", "\u001b[?2004h> "]
[948.266792, "o", "        for f in glob.glob(os.path.join(mc_dir, '*.root')):\r\n\u001b[?2004l\r\u001b[?2004h"]
[948.26682, "o", "> "]
[948.267037, "o", "            if any(t in os.path.basename(f) for t in targets):\r\n\u001b[?2004l\r"]
[948.267065, "o", "\u001b[?2004h> "]
[948.267182, "o", "                files.append(f)\r\n\u001b[?2004l\r"]
[948.267209, "o", "\u001b[?2004h> "]
[948.267276, "o", "    return files\r\n\u001b[?2004l\r"]
[948.267319, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[948.267345, "o", "> "]
[948.26745, "o", "def get_data_files(base_path):\r\n\u001b[?2004l\r"]
[948.267478, "o", "\u001b[?2004h> "]
[948.267649, "o", "    data_dir = os.path.join(base_path, 'data')\r\n\u001b[?2004l\r"]
[948.267675, "o", "\u001b[?2004h> "]
[948.267798, "o", "    if os.path.exists(data_dir):\r\n\u001b[?2004l\r"]
[948.267825, "o", "\u001b[?2004h> "]
[948.268033, "o", "        return glob.glob(os.path.join(data_dir, '*.root'))\r\n\u001b[?2004l\r"]
[948.268062, "o", "\u001b[?2004h> "]
[948.268117, "o", "    return []\r\n\u001b[?2004l\r"]
[948.268145, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[948.268204, "o", "\u001b[?2004h> "]
[948.268392, "o", "def process_tree(tree, is_mc=True, process_name='unknown'):\r\n\u001b[?2004l\r"]
[948.268419, "o", "\u001b[?2004h> "]
[948.26852, "o", "    data = tree.arrays()\r\n\u001b[?2004l\r"]
[948.268547, "o", "\u001b[?2004h> "]
[948.268603, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[948.268929, "o", "    lep_pt = data.lep_pt if 'lep_pt' in data.fields else ak.zeros(len(data), type='float64')\r\n\u001b[?2004l\r"]
[948.268959, "o", "\u001b[?2004h> "]
[948.269183, "o", "    n_lep_sel = ak.sum(lep_pt > cfg['lepton_pt_min'], axis=1)\r\n\u001b[?2004l\r"]
[948.269211, "o", "\u001b[?2004h> "]
[948.269269, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[948.269583, "o", "    jet_pt = data.jet_pt if 'jet_pt' in data.fields else ak.zeros(len(data), type='float64')\r\n\u001b[?2004l\r"]
[948.269611, "o", "\u001b[?2004h> "]
[948.269949, "o", "    jet_eta = data.jet_eta if 'jet_eta' in data.fields else ak.zeros(len(data), type='float64')\r\n\u001b[?2004l\r"]
[948.269979, "o", "\u001b[?2004h> "]
[948.270379, "o", "    jet_btag = data.jet_btag_quantile if 'jet_btag_quantile' in data.fields else ak.zeros(len(data), type='float64')\r\n\u001b[?2004l\r"]
[948.270408, "o", "\u001b[?2004h> "]
[948.270436, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[948.27051, "o", "> "]
[948.270619, "o", "    jet_pt_mask = jet_pt > cfg['jet_pt_min']\r\n\u001b[?2004l\r"]
[948.270647, "o", "\u001b[?2004h> "]
[948.270783, "o", "    sel_jet_pt = jet_pt[jet_pt_mask]\r\n\u001b[?2004l\r"]
[948.270811, "o", "\u001b[?2004h> "]
[948.27095, "o", "    sel_jet_eta = jet_eta[jet_pt_mask]\r\n\u001b[?2004l\r"]
[948.270977, "o", "\u001b[?2004h> "]
[948.271125, "o", "    sel_jet_btag = jet_btag[jet_pt_mask]\r\n\u001b[?2004l\r"]
[948.271152, "o", "\u001b[?2004h> "]
[948.271208, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[948.271319, "o", "    n_jets = ak.num(sel_jet_pt)\r\n\u001b[?2004l\r"]
[948.271346, "o", "\u001b[?2004h> "]
[948.271588, "o", "    n_bjets = ak.sum(sel_jet_btag >= cfg['btag_threshold'], axis=1)\r\n\u001b[?2004l\r"]
[948.271616, "o", "\u001b[?2004h> "]
[948.27189, "o", "    n_central = ak.sum(np.abs(sel_jet_eta) <= cfg['central_eta_max'], axis=1)\r\n\u001b[?2004l\r"]
[948.271919, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[948.271947, "o", "\u001b[?2004h> "]
[948.272201, "o", "    hadronic_mask = (n_lep_sel == 0) & (n_jets >= 3) & (n_bjets >= 1)\r\n\u001b[?2004l\r"]
[948.27223, "o", "\u001b[?2004h> "]
[948.272422, "o", "    leptonic_mask = (n_lep_sel >= 1) & (n_bjets >= 1)\r\n\u001b[?2004l\r"]
[948.27245, "o", "\u001b[?2004h> "]
[948.272611, "o", "    sel_mask = hadronic_mask | leptonic_mask\r\n\u001b[?2004l\r"]
[948.272639, "o", "\u001b[?2004h> "]
[948.272666, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[948.272738, "o", "> "]
[948.272794, "o", "    pre_data = data[sel_mask]\r\n\u001b[?2004l\r"]
[948.272825, "o", "\u001b[?2004h> "]
[948.272934, "o", "    if len(pre_data) == 0:\r\n\u001b[?2004l\r"]
[948.272962, "o", "\u001b[?2004h> "]
[948.273067, "o", "        return pd.DataFrame()\r\n\u001b[?2004l\r"]
[948.27311, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[948.273137, "o", "> "]
[948.27323, "o", "    res_df = pd.DataFrame({\r\n\u001b[?2004l\r"]
[948.273259, "o", "\u001b[?2004h> "]
[948.273646, "o", "        'eventNumber': pre_data.eventNumber if 'eventNumber' in pre_data.fields else np.arange(len(pre_data)),\r\n\u001b[?2004l\r"]
[948.273675, "o", "\u001b[?2004h> "]
[948.273796, "o", "        'process': process_name,\r\n\u001b[?2004l\r"]
[948.273847, "o", "\u001b[?2004h> "]
[948.27402, "o", "        'n_leptons_sel': np.array(n_lep_sel[sel_mask]),\r\n\u001b[?2004l\r"]
[948.274048, "o", "\u001b[?2004h> "]
[948.274212, "o", "        'n_jets': np.array(n_jets[sel_mask]),\r\n\u001b[?2004l\r"]
[948.27424, "o", "\u001b[?2004h> "]
[948.274414, "o", "        'n_bjets': np.array(n_bjets[sel_mask]),\r\n\u001b[?2004l\r"]
[948.274442, "o", "\u001b[?2004h> "]
[948.274631, "o", "        'central_jets': np.array(n_central[sel_mask])\r\n\u001b[?2004l\r"]
[948.274657, "o", "\u001b[?2004h> "]
[948.274717, "o", "    })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[948.274746, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[948.274807, "o", "> "]
[948.275059, "o", "    # Use pandas to assign channel based on the original masks filtered by sel_mask\r\n\u001b[?2004l\r"]
[948.275101, "o", "\u001b[?2004h> "]
[948.275346, "o", "    channels = np.where(hadronic_mask[sel_mask], 'hadronic', 'leptonic')\r\n\u001b[?2004l\r"]
[948.275372, "o", "\u001b[?2004h> "]
[948.275493, "o", "    res_df['channel'] = channels\r\n\u001b[?2004l\r"]
[948.275535, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[948.275563, "o", "> "]
[948.275862, "o", "    if 'mcWeight' in pre_data.fields: res_df['mcWeight'] = np.array(pre_data.mcWeight)\r\n\u001b[?2004l\r"]
[948.27589, "o", "\u001b[?2004h> "]
[948.276152, "o", "    if 'xsec' in pre_data.fields: res_df['xsec'] = np.array(pre_data.xsec)\r\n\u001b[?2004l\r"]
[948.27618, "o", "\u001b[?2004h> "]
[948.276444, "o", "    if 'kfac' in pre_data.fields: res_df['kfac'] = np.array(pre_data.kfac)\r\n\u001b[?2004l\r"]
[948.276472, "o", "\u001b[?2004h> "]
[948.276768, "o", "    if 'filteff' in pre_data.fields: res_df['filteff'] = np.array(pre_data.filteff)\r\n\u001b[?2004l\r"]
[948.276795, "o", "\u001b[?2004h> "]
[948.276857, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[948.276917, "o", "    return res_df\r\n\u001b[?2004l\r"]
[948.276943, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[948.276971, "o", "\u001b[?2004h> "]
[948.277062, "o", "def run_analysis():\r\n\u001b[?2004l\r"]
[948.277091, "o", "\u001b[?2004h> "]
[948.27721, "o", "    print(\"Starting pipeline...\")\r\n\u001b[?2004l\r"]
[948.277237, "o", "\u001b[?2004h> "]
[948.277403, "o", "    mc_files = get_mc_files(cfg['input_data'])\r\n\u001b[?2004l\r"]
[948.277431, "o", "\u001b[?2004h> "]
[948.277612, "o", "    data_files = get_data_files(cfg['input_data'])\r\n\u001b[?2004l\r"]
[948.27764, "o", "\u001b[?2004h> "]
[948.277666, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[948.277742, "o", "> "]
[948.277782, "o", "    all_preselected = []\r\n\u001b[?2004l\r"]
[948.277809, "o", "\u001b[?2004h> "]
[948.277896, "o", "    for f in mc_files:\r\n\u001b[?2004l\r"]
[948.277924, "o", "\u001b[?2004h> "]
[948.278051, "o", "        proc = os.path.basename(f)\r\n\u001b[?2004l\r"]
[948.278078, "o", "\u001b[?2004h> "]
[948.278219, "o", "        print(f\"Processing MC: {proc}\")\r\n\u001b[?2004l\r"]
[948.278246, "o", "\u001b[?2004h> "]
[948.278427, "o", "        with uproot.open(f) [\"analysis\"] as tree:\r\n\u001b[?2004l\r"]
[948.278454, "o", "\u001b[?2004h> "]
[948.278704, "o", "            df_sel = process_tree(tree, is_mc=True, process_name=proc)\r\n\u001b[?2004l\r"]
[948.278731, "o", "\u001b[?2004h> "]
[948.278914, "o", "            print(f\"  -> Selected: {len(df_sel)}\")\r\n\u001b[?2004l\r"]
[948.278941, "o", "\u001b[?2004h> "]
[948.279095, "o", "            all_preselected.append(df_sel)\r\n\u001b[?2004l\r"]
[948.279124, "o", "\u001b[?2004h> "]
[948.279153, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[948.27922, "o", "> "]
[948.279264, "o", "    for f in data_files:\r\n\u001b[?2004l\r"]
[948.27929, "o", "\u001b[?2004h> "]
[948.279437, "o", "        print(f\"Processing Data: {f}\")\r\n\u001b[?2004l\r"]
[948.279464, "o", "\u001b[?2004h> "]
[948.279641, "o", "        with uproot.open(f) [\"analysis\"] as tree:\r\n\u001b[?2004l\r"]
[948.279669, "o", "\u001b[?2004h> "]
[948.279931, "o", "            df_sel = process_tree(tree, is_mc=False, process_name='data')\r\n\u001b[?2004l\r"]
[948.27996, "o", "\u001b[?2004h> "]
[948.280141, "o", "            print(f\"  -> Selected: {len(df_sel)}\")\r\n\u001b[?2004l\r"]
[948.28017, "o", "\u001b[?2004h> "]
[948.280323, "o", "            all_preselected.append(df_sel)\r\n\u001b[?2004l\r"]
[948.280349, "o", "\u001b[?2004h> "]
[948.280402, "o", "            \r\n\u001b[?2004l\r"]
[948.280428, "o", "\u001b[?2004h> "]
[948.280668, "o", "    if not all_preselected or len(pd.concat(all_preselected)) == 0:\r\n\u001b[?2004l\r"]
[948.280695, "o", "\u001b[?2004h> "]
[948.280875, "o", "        print(\"No events passed preselection.\")\r\n\u001b[?2004l\r"]
[948.280905, "o", "\u001b[?2004h> "]
[948.280963, "o", "        return\r\n\u001b[?2004l\r"]
[948.280992, "o", "\u001b[?2004h> "]
[948.281019, "o", "        \r\n\u001b[?2004l\r"]
[948.281098, "o", "\u001b[?2004h> "]
[948.281233, "o", "    full_preselected = pd.concat(all_preselected)\r\n\u001b[?2004l\r"]
[948.281261, "o", "\u001b[?2004h> "]
[948.281515, "o", "    print(f\"Total events passing preselection: {len(full_preselected)}\")\r\n\u001b[?2004l\r"]
[948.281542, "o", "\u001b[?2004h> "]
[948.281594, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[948.281876, "o", "    had_count = len(full_preselected[full_preselected['channel'] == 'hadronic'])\r\n\u001b[?2004l\r"]
[948.281919, "o", "\u001b[?2004h> "]
[948.282189, "o", "    lep_count = len(full_preselected[full_preselected['channel'] == 'leptonic'])\r\n\u001b[?2004l\r"]
[948.282217, "o", "\u001b[?2004h> "]
[948.282424, "o", "    print(f\"Hadronic: {had_count}, Leptonic: {lep_count}\")\r\n\u001b[?2004l\r"]
[948.282453, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[948.28248, "o", "\u001b[?2004h> "]
[948.282819, "o", "    full_preselected.to_csv(os.path.join(res_dir, 'preselected_events.csv'), index=False)\r\n\u001b[?2004l\r"]
[948.282848, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[948.282877, "o", "\u001b[?2004h> "]
[948.282981, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[948.283008, "o", "\u001b[?2004h> "]
[948.283076, "o", "    run_analysis()\r\n\u001b[?2004l\r"]
[948.283103, "o", "\u001b[?2004h> "]
[948.283165, "o", "EOF\r\n\u001b[?2004l\r"]
[948.287471, "o", "\u001b[?2004hroot@nid007078:~/submission/tth-diphoton-bdt# "]
[949.725457, "i", "cd /root/submission/tth-diphoton-bdt && python3 run_pipeline.py\n"]
[949.726072, "o", "cd /root/submission/tth-diphoton-bdt && python3 run_pipeline.py\r\n\u001b[?2004l\r"]
[950.212148, "o", "Starting pipeline...\r\n"]
[950.214549, "o", "Processing MC: ZH_preselection.root\r\n"]
