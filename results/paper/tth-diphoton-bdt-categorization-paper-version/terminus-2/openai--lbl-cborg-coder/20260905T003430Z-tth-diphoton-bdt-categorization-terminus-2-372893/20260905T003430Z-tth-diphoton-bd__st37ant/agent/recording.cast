[825.031649, "o", "\u001b[?2004h> "]
[825.031958, "o", "    lep_pt = data.lep_pt if 'lep_pt' in data.fields() else ak. la.zeros(len(data), type='float64')\r\n\u001b[?2004l\r"]
[825.031984, "o", "\u001b[?2004h> "]
