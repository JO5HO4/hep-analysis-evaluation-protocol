Sending keys: ['cat << \'EOF\' > /root/submission/tth-diphoton-bdt/run_pipeline.py\nimport os\nimport yaml\nimport pandas as pd\nimport numpy as np\nimport uproot\nimport json\nimport glob\nfrom analysis.top_categorization import *\n\n# Load config\nwith open(\'config.yaml\', \'r\') as f:\n    cfg = yaml.safe_load(f)\n\n# Setup results dir\nres_dir = cfg[\'output_dir\']\nos.makedirs(res_dir, exist_ok=True)\n\ndef get_mc_files(base_path):\n    # Target Higgs samples: ggH, VBF, WH, ZH, ggZH, ttH, tH\n    targets = [\'ggH\', \'VBF\', \'WH\', \'ZH\', \'ggZH\', \'ttH\', \'tH\']\n    files = []\n    mc_dir = os.path.join(base_path, \'MC\')\n    if os.path.exists(mc_dir):\n        for f in glob.glob(os.path.join(mc_dir, \'*.root\')):\n            if any(t in os.path.basename(f) for t in targets):\n                files.append(f)\n    return files\n\ndef get_data_files(base_path):\n    data_dir = os.path.join(base_path, \'data\')\n    if os.path.exists(data_dir):\n        return glob.glob(os.path.join(data_dir, \'*.root\'))\n    return []\n\ndef process_tree(tree, is_mc=True, process_name=\'unknown\'):\n    # Load required columns\n    # Note: Actual column names depend on the ATLAS GamGam dataset schema\n    # Standard expected names for this preselection:\n    # Photons: pT, eta, phi, mass, tightID, tightIso\n    # Leptons: pT, eta, phi, mass, charge\n    # Jets: pT, eta, phi, mass, btag_quantile\n    \n    # We will use common aliases if they exist, otherwise we assume standard names\n    cols = [\n        \'event_id\', \'m_gammagamma\', \n        \'photon_pt\', \'photon_eta\', \'photon_phi\', \'photon_tightID\', \'photon_tightIso\', \n        \'electron_pt\', \'electron_eta\', \'electron_phi\', \n        \'muon_pt\', \'muon_eta\', \'muon_phi\', \n        \'jet_pt\', \'jet_eta\', \'jet_phi\', \'jet_btag_quantile\', \n        \'gen_weight\', \'cross_section\', \'filter_efficiency\', \'k_factor\'\n    ]\n    \n    # Use a subset of columns that actually exist in the tree\n    available_cols = [c for c in cols if c in tree.fields()]\n    df = tree.arrays(available_cols, library=\'pd\')\n    \n    # Preselection\n    # 1. Photons: Kinematic acceptance (already filtered by GamGam usually, but we check pT)\n    # Requirement: Build candidate from 2 photons. (We assume GamGam provided a pre-selected diphoton)\n    \n    # 2. Leptons: pT > 10 GeV\n    df[\'n_leptons\'] = 0\n    if \'electron_pt\' in df.columns:\n        df[\'n_leptons\'] += df[\'electron_pt\'].apply(lambda x: sum(1 for p in x if p > cfg[\'lepton_pt_min]) if isinstance(x, (list, np.ndarray)) else 0)\n    if \'muon_pt\' in df.columns:\n        df[\'n_leptons\'] += df[\'muon_pt\'].apply(lambda x: sum(1 for p in x if p > cfg[\'lepton_pt_min]) if isinstance(x, (list, np.ndarray)) else 0)\n\n    # 3. Jets: pT > 25 GeV\n    # we create a list of selected jets per event\n    def filter_jets(pts, etas, btags):\n        jets = []\n        if pts is None or etas is None: return jets\n        for p, e, b in zip(pts, etas, btags):\n            if p > cfg[\'jet_pt_min\']:\n                jets.append({\'pt\': p, \'eta\': e, \'btag\': b})\n        return jets\n\n    df[\'selected_jets\'] = df.apply(lambda row: filter_jets(\n        row.get(\'jet_pt\', []), row.get(\'jet_eta\', []), row.get(\'jet_btag_quantile\', [])), axis=1)\n    \n    df[\'n_jets\'] = df[\'selected_jets\'].apply(len)\n    df[\'n_bjets\'] = df[\'selected_jets\'].apply(lambda js: sum(1 for j in js if j[\'btag\'] >= cfg[\'btag_threshold\']))\n    df[\'central_jets\'] = df[\'selected_jets\'].apply(lambda js: sum(1 for j in js if abs(j[\'eta\']) <= cfg[\'central_eta_max\']))\n\n    # Channel Labeling\n    df[\'channel\'] = \'unassigned\'\n    # Hadronic: 0 leptons, >=3 jets, >=1 b-jet\n    had_mask = (df[\'n_leptons\'] == 0) & (df[\'n_jets\'] >= 3) & (df[\'n_bjets\'] >= 1)\n    df.loc[had_mask, \'channel\'] = \'hadronic\'\n    # Leptonic Bookkeeping: >=1 lepton, >=1 b-jet\n    lep_mask = (df[\'n_leptons\'] >= 1) & (df[\'n_bjets\'] >= 1)\n    df.loc[lep_mask & (df[\'channel\'] == \'unassigned\'), \'channel\'] = \'leptonic\'\n\n    df[\'process\'] = process_name\n    return df\n\ndef run_analysis():\n    print("Starting pipeline...")\n    mc_files = get_mc_files(cfg[\'input_data\'])\n    data_files = get_data_files(cfg[\'input_data\'])\n    \n    all_dfs = []\n    for f in mc_files:\n        proc = os.path.basename(f)\n        with uproot.open(f) ["Events"] as tree:\n            all_dfs.append(process_tree(tree, is_mc=True, process_name=proc))\n    \n    for f in data_files:\n        with uproot.open(f) ["Events"] as tree:\n            all_dfs.append(process_tree(tree, is_mc=False, process_name=\'data\'))\n            \n    if not all_dfs: \n        print("No data loaded. Check paths.")\n        return\n        \n    full_df = pd.concat(all_dfs)\n    # Keep only hadronic and leptonic bookkeeping\n    preselected = full_df[full_df[\'channel\'] != \'unassigned\']\n    preselected.to_csv(os.path.join(res_dir, \'preselected_events.csv\'), index=False)\n    print(f"Preselection complete. Rows: {len(preselected)}")\n\nif __name__ == \'__main__\':\n    run_analysis()\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
