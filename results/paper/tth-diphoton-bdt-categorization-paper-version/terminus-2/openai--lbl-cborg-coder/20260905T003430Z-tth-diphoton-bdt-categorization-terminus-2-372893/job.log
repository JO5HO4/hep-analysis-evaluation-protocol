Sending keys: ['cat << \'EOF\' > /root/submission/tth-diphoton-bdt/run_pipeline.py\nimport os\nimport yaml\nimport pandas as pd\nimport numpy as np\nimport uproot\nimport json\nimport glob\nimport awkward as ak\nfrom analysis.top_categorization import *\n\nwith open(\'config.yaml\', \'r\') as f:\n    cfg = yaml.safe_load(f)\n\nres_dir = cfg[\'output_dir\']\nos.makedirs(res_dir, exist_ok=True)\n\ndef get_mc_files(base_path):\n    targets = [\'ggH\', \'VBF\', \'WH\', \'ZH\', \'ggZH\', \'ttH\', \'tH\']\n    files = []\n    mc_dir = os.path.join(base_path, \'MC\')\n    if os.path.exists(mc_dir):\n        for f in glob.glob(os.path.join(mc_dir, \'*.root\')):\n            if any(t in os.path.basename(f) for t in targets):\n                files.append(f)\n    return files\n\ndef get_data_files(base_path):\n    data_dir = os.path.join(base_path, \'data\')\n    if os.path.exists(data_dir):\n        return glob.glob(os.path.join(data_dir, \'*.root\'))\n    return []\n\ndef process_tree(tree, is_mc=True, process_name=\'unknown\'):\n    # Load all fields as Awkward Arrays\n    data = tree.arrays()\n    \n    # Preselection logic using Awkward arrays\n    # 1. Leptons > 10 GeV\n    lep_pt = data.lep_pt if \'lep_pt\' in data.fields() else ak. la.zeros(len(data), type=\'float64\')\n    n_lep_sel = ak.sum(lep_pt > cfg[\'lepton_pt_min\'], axis=1)\n    \n    # 2. Jets > 25 GeV and b-tags\n    jet_pt = data.jet_pt if \'jet_pt\' in data.fields() else ak. la.zeros(len(data), type=\'float64\')\n    jet_eta = data.jet_eta if \'jet_eta\' in data.fields() else ak. la.zeros(len(data), type=\'float64\')\n    jet_btag = data.jet_btag_quantile if \'jet_btag_quantile\' in data.fields() else ak. la.zeros(len(data), type=\'float64\')\n    \n    # Create masks for jets passing pT cut\n    jet_pt_mask = jet_pt > cfg[\'jet_pt_min\']\n    sel_jet_pt = jet_pt[jet_pt_mask]\n    sel_jet_eta = jet_eta[jet_pt_mask]\n    sel_jet_btag = jet_btag[jet_pt_mask]\n    \n    # Count selected jets\n    n_jets = ak.num(sel_jet_pt)\n    # Count b-jets among selected jets\n    n_bjets = ak.sum(sel_jet_btag >= cfg[\'btag_threshold\'], axis=1)\n    # Count central jets among selected jets\n    n_central = ak.sum(np.abs(sel_jet_eta) <= cfg[\'central_eta_max\'], axis=1)\n\n    # Define channels\n    hadronic_mask = (n_lep_sel == 0) & (n_jets >= 3) & (n_bjets >= 1)\n    leptonic_mask = (n_lep_sel >= 1) & (n_bjets >= 1)\n    \n    # Combine masks\n    sel_mask = hadronic_mask | leptonic_mask\n    \n    # Extract preselected data\n    pre_data = data[sel_mask]\n    if len(pre_data) == 0:\n        return pd.DataFrame()\n\n    # Convert to pandas\n    # We need to handle jagged arrays by taking a representation (like a list)\n    res_df = pd.DataFrame({\n        \'eventNumber\': pre_data.eventNumber if \'eventNumber\' in pre_data.fields() else np.arange(len(pre_data)),\n        \'process\': process_name,\n        \'n_leptons_sel\': n_lep_sel[sel_mask],\n        \'n_jets\': n_jets[sel_mask],\n        \'n_bjets\': n_bjets[sel_mask],\n        \'central_jets\': n_central[sel_mask],\n        \'channel\': np.where(hadronic_mask[sel_mask], \'hadronic\', \'leptonic\')\n    })\n    \n    # Add weight and mass (calculated similarly)\n    if \'mcWeight\' in pre_data.fields(): res_df[\'mcWeight\'] = pre_data.mcWeight\n    if \'xsec\' in pre_data.fields(): res_df[\'xsec\'] = pre_data.xsec\n    if \'kfac\' in pre_data.fields(): res_df[\'kfac\'] = pre_data.kfac\n    if \'filteff\' in pre_data.fields(): res_df[\'filteff\'] = pre_data.filteff\n    \n    return res_df\n\ndef run_analysis():\n    print("Starting pipeline...")\n    mc_files = get_mc_files(cfg[\'input_data\'])\n    data_files = get_data_files(cfg[\'input_data\'])\n    \n    all_preselected = []\n    for f in mc_files:\n        proc = os.path.basename(f)\n        print(f"Processing MC: {proc}")\n        with uproot.open(f) ["analysis"] as tree:\n            df_sel = process_tree(tree, is_mc=True, process_name=proc)\n            print(f"  -> Selected: {len(df_sel)}")\n            all_preselected.append(df_sel)\n    \n    for f in data_files:\n        print(f"Processing Data: {f}")\n        with uproot.open(f) ["analysis"] as tree:\n            df_sel = process_tree(tree, is_mc=False, process_name=\'data\')\n            print(f"  -> Selected: {len(df_sel)}")\n            all_preselected.append(df_sel)\n            \n    if not all_preselected or len(pd.concat(all_preselected)) == 0:\n        print("No events passed preselection.")\n        return\n        \n    full_preselected = pd.concat(all_preselected)\n    print(f"Total events passing preselection: {len(full_preselected)}")\n    \n    had_count = len(full_preselected[full_preselected[\'channel\'] == \'hadronic\'])\n    lep_count = len(full_preselected[full_preselected[\'channel\'] == \'leptonic\'])\n    print(f"Hadronic: {had_count}, Leptonic: {lep_count}")\n\n    full_preselected.to_csv(os.path.join(res_dir, \'preselected_events.csv\'), index=False)\n\nif __name__ == \'__main__\':\n    run_analysis()\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
