[?2004l[?2004h> """Hadronic H->gamma gamma top-associated categorization utilities."""
[?2004l[?2004h> import hashlib, math
[?2004l[?2004h> CATEGORY_ORDER=['ttH_had_BDT1','ttH_had_BDT2','ttH_had_BDT3','ttH_had_BDT4','tH_had_4j1b','tH_had_4j2b']
[?2004l[?2004h> BDT_FEATURES=['n_jets','n_bjets','leading_jet_pt','subleading_jet_pt','ht_jets']
[?2004l[?2004h> def invariant_mass(objects):
[?2004l[?2004h>  p=[0.,0.,0.,0.]
[?2004l[?2004h>  for o in objects:
[?2004l[?2004h>   pt,eta,phi,e=o[:4]; p[0]+=pt*math.cos(phi);p[1]+=pt*math.sin(phi);p[2]+=pt*math.sinh(eta);p[3]+=e
[?2004l[?2004h>  return math.sqrt(max(0,p[3]*p[3]-p[0]*p[0]-p[1]*p[1]-p[2]*p[2]))
[?2004l[?2004h> def build_jet_features(jets, central_eta=2.5):
[?2004l[?2004h>  # jets iterable of (pt,eta,phi,e,btag); assumes pT >25 selection already if supplied
[?2004l[?2004h>  j=[x for x in jets if x[0]>25]; c=[x for x in j if abs(x[1])<=central_eta]; b=[x for x in j if x[4]>=4]
[?2004l[?2004h>  pts=sorted((x[0] for x in j),reverse=True)
[?2004l[?2004h>  return {'n_jets':len(j),'n_central_jets':len(c),'n_forward_jets':len(j)-len(c),'n_bjets':len(b),'leading_jet_pt':pts[0] if pts else 0.,'subleading_jet_pt':pts[1] if len(pts)>1 else 0.,'ht_jets':sum(pts)}
[?2004l[?2004h> def stable_partition(event_id,seed=20240517,fractions=(.6,.2,.2)):
[?2004l[?2004h>  x=int(hashlib.sha256((str(seed)+'|'+str(event_id)).encode()).hexdigest()[:16],16)/2**64
[?2004l[?2004h>  return 'train' if x<fractions[0] else ('validation' if x<fractions[0]+fractions[1] else 'test')
[?2004l[?2004h> def assign_top_category(event,score=None,thresholds=None):
[?2004l[?2004h>  score=event.get('bdt_score',score); thresholds=thresholds or [0.85,0.70,0.55,0.40]
[?2004l[?2004h>  if event.get('channel')=='hadronic' and score is not None:
[?2004l[?2004h>   for i,t in enumerate(thresholds):
[?2004l[?2004h>    if score>=t:return CATEGORY_ORDER[i]
[?2004l[?2004h>   if event.get('n_leptons',0)==0 and event.get('n_central_jets')==4:
[?2004l[?2004h>    if event.get('n_bjets')==1:return 'tH_had_4j1b'
[?2004l[?2004h>    if event.get('n_bjets')>=2:return 'tH_had_4j2b'
[?2004l[?2004h>  return 'unassigned'
[?2004l[?2004h> def optimize_bdt_boundaries(rows,config=None):
[?2004l[?2004h>  # deterministic quantile scan, returns greedy splits satisfying >=5% expected-Z gain
[?2004l[?2004h>  import numpy as np
[?2004l[?2004h>  cfg=config or {}; minimp=cfg.get('min_relative_improvement',.05)
[?2004l[?2004h>  a=np.asarray(rows['score'] if hasattr(rows,'__getitem__') else [r['bdt_score'] for r in rows],float)
[?2004l[?2004h>  s=np.asarray(rows.get('signal_weight',np.ones(len(a))) if hasattr(rows,'get') else [r.get('signal_weight',0) for r in rows],float)
[?2004l[?2004h>  b=np.asarray(rows.get('background_weight',np.ones(len(a))) if hasattr(rows,'get') else [r.get('background_weight',0) for r in rows],float)
[?2004l[?2004h>  def z(edges):
[?2004l[?2004h>   ix=np.digitize(a,[-np.inf]+sorted(edges)+[np.inf]); return math.sqrt(sum((s[ix==k].sum())**2/max(b[ix==k].sum(),1e-9) for k in np.unique(ix)))
[?2004l[?2004h>  edges=[]; old=z(edges); accepted=[]
[?2004l[?2004h>  for _ in range(3):
[?2004l[?2004h>   choices=[]
[?2004l[?2004h>   for q in np.linspace(.1,.9,33):
[?2004l[?2004h>    t=float(np.quantile(a,q))
[?2004l[?2004h>    if t in edges:continue
[?2004l[?2004h>    zz=z(edges+[t]); choices.append((zz,t))
[?2004l[?2004h>   if not choices:break
[?2004l[?2004h>   zz,t=max(choices)
[?2004l[?2004h>   imp=(zz-old)/max(old,1e-12)
[?2004l[?2004h>   if imp<minimp:break
[?2004l[?2004h>   edges.append(t);edges.sort();accepted.append({'boundary':t,'expected_z':zz,'relative_improvement':imp});old=zz
[?2004l[?2004h>  return sorted(edges,reverse=True),accepted
