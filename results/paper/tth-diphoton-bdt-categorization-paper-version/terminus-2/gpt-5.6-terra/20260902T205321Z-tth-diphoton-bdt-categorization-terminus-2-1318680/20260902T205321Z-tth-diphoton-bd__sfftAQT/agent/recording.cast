[110.673574, "o", "import hashlib, math\r\n\u001b[?2004l\r"]
[110.673616, "o", "\u001b[?2004h> "]
[110.674229, "o", "CATEGORY_ORDER=['ttH_had_BDT1','ttH_had_BDT2','ttH_had_BDT3','ttH_had_BDT4','tH_had_4j1b','tH_had_4j2b']\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.674268, "o", "> "]
[110.674728, "o", "BDT_FEATURES=['n_jets','n_bjets','leading_jet_pt','subleading_jet_pt','ht_jets']\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.674769, "o", "> "]
[110.674925, "o", "def invariant_mass(objects):\r\n\u001b[?2004l\r"]
[110.674961, "o", "\u001b[?2004h> "]
[110.675046, "o", " p=[0.,0.,0.,0.]\r\n\u001b[?2004l\r"]
[110.675082, "o", "\u001b[?2004h> "]
[110.675168, "o", " for o in objects:\r\n\u001b[?2004l\r"]
[110.675203, "o", "\u001b[?2004h> "]
[110.675748, "o", "  pt,eta,phi,e=o[:4]; p[0]+=pt*math.cos(phi);p[1]+=pt*math.sin(phi);p[2]+=pt*math.sinh(eta);p[3]+=e\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.675783, "o", "> "]
[110.676132, "o", " return math.sqrt(max(0,p[3]*p[3]-p[0]*p[0]-p[1]*p[1]-p[2]*p[2]))\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.676167, "o", "> "]
[110.676405, "o", "def build_jet_features(jets, central_eta=2.5):\r\n\u001b[?2004l\r"]
[110.67644, "o", "\u001b[?2004h> "]
[110.676889, "o", " # jets iterable of (pt,eta,phi,e,btag); assumes pT >25 selection already if supplied\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.67693, "o", "> "]
[110.677539, "o", " j=[x for x in jets if x[0]>25]; c=[x for x in j if abs(x[1])<=central_eta]; b=[x for x in j if x[4]>=4]\r\n\u001b[?2004l\r"]
[110.677576, "o", "\u001b[?2004h> "]
[110.677832, "o", " pts=sorted((x[0] for x in j),reverse=True)\r\n\u001b[?2004l\r"]
[110.67787, "o", "\u001b[?2004h> "]
[110.678975, "o", " return {'n_jets':len(j),'n_central_jets':len(c),'n_forward_jets':len(j)-len(c),'n_bjets':len(b),'leading_jet_pt':pts[0] if pts else 0.,'subleading_jet_pt':pts[1] if len(pts)>1 else 0.,'ht_jets':sum(pts)}\r\n\u001b[?2004l\r"]
[110.679012, "o", "\u001b[?2004h> "]
[110.679371, "o", "def stable_partition(event_id,seed=20240517,fractions=(.6,.2,.2)):\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.679442, "o", "> "]
[110.679876, "o", " x=int(hashlib.sha256((str(seed)+'|'+str(event_id)).encode()).hexdigest()[:16],16)/2**64\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.67992, "o", "> "]
[110.680416, "o", " return 'train' if x<fractions[0] else ('validation' if x<fractions[0]+fractions[1] else 'test')\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.680488, "o", "> "]
[110.680764, "o", "def assign_top_category(event,score=None,thresholds=None):\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.680801, "o", "> "]
[110.681259, "o", " score=event.get('bdt_score',score); thresholds=thresholds or [0.85,0.70,0.55,0.40]\r\n\u001b[?2004l\r"]
[110.681297, "o", "\u001b[?2004h> "]
[110.681634, "o", " if event.get('channel')=='hadronic' and score is not None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.681668, "o", "> "]
[110.681865, "o", "  for i,t in enumerate(thresholds):\r\n\u001b[?2004l\r"]
[110.681897, "o", "\u001b[?2004h> "]
[110.682132, "o", "   if score>=t:return CATEGORY_ORDER[i]\r\n\u001b[?2004l\r"]
[110.682219, "o", "\u001b[?2004h> "]
[110.68256, "o", "  if event.get('n_leptons',0)==0 and event.get('n_central_jets')==4:\r\n\u001b[?2004l\r"]
[110.682628, "o", "\u001b[?2004h> "]
[110.682865, "o", "   if event.get('n_bjets')==1:return 'tH_had_4j1b'\r\n\u001b[?2004l\r"]
[110.682933, "o", "\u001b[?2004h> "]
[110.683172, "o", "   if event.get('n_bjets')>=2:return 'tH_had_4j2b'\r\n\u001b[?2004l\r"]
[110.683199, "o", "\u001b[?2004h> "]
[110.683309, "o", " return 'unassigned'\r\n\u001b[?2004l\r"]
[110.683336, "o", "\u001b[?2004h> "]
[110.683586, "o", "def optimize_bdt_boundaries(rows,config=None):\r\n\u001b[?2004l\r"]
[110.683611, "o", "\u001b[?2004h> "]
[110.684052, "o", " # deterministic quantile scan, returns greedy splits satisfying >=5% expected-Z gain\r\n\u001b[?2004l\r"]
[110.684078, "o", "\u001b[?2004h> "]
[110.684177, "o", " import numpy as np\r\n\u001b[?2004l\r"]
[110.684204, "o", "\u001b[?2004h> "]
[110.684559, "o", " cfg=config or {}; minimp=cfg.get('min_relative_improvement',.05)\r\n\u001b[?2004l\r"]
[110.684609, "o", "\u001b[?2004h> "]
[110.685112, "o", " a=np.asarray(rows['score'] if hasattr(rows,'__getitem__') else [r['bdt_score'] for r in rows],float)\r\n\u001b[?2004l\r"]
[110.685166, "o", "\u001b[?2004h> "]
[110.685906, "o", " s=np.asarray(rows.get('signal_weight',np.ones(len(a))) if hasattr(rows,'get') else [r.get('signal_weight',0) for r in rows],float)\r\n\u001b[?2004l\r"]
[110.685936, "o", "\u001b[?2004h> "]
[110.686764, "o", " b=np.asarray(rows.get('background_weight',np.ones(len(a))) if hasattr(rows,'get') else [r.get('background_weight',0) for r in rows],float)\r\n\u001b[?2004l\r"]
[110.686795, "o", "\u001b[?2004h> "]
[110.68688, "o", " def z(edges):\r\n\u001b[?2004l\r"]
[110.686909, "o", "\u001b[?2004h> "]
[110.687767, "o", "  ix=np.digitize(a,[-np.inf]+sorted(edges)+[np.inf]); return math.sqrt(sum((s[ix==k].sum())**2/max(b[ix==k].sum(),1e-9) for k in np.unique(ix)))\r\n\u001b[?2004l\r"]
[110.687796, "o", "\u001b[?2004h> "]
[110.688017, "o", " edges=[]; old=z(edges); accepted=[]\r\n\u001b[?2004l\r"]
[110.688045, "o", "\u001b[?2004h> "]
[110.68816, "o", " for _ in range(3):\r\n\u001b[?2004l\r"]
[110.688204, "o", "\u001b[?2004h> "]
[110.688266, "o", "  choices=[]\r\n\u001b[?2004l\r"]
[110.688294, "o", "\u001b[?2004h> "]
[110.688499, "o", "  for q in np.linspace(.1,.9,33):\r\n\u001b[?2004l\r"]
[110.688524, "o", "\u001b[?2004h> "]
[110.688673, "o", "   t=float(np.quantile(a,q))\r\n\u001b[?2004l\r"]
[110.688762, "o", "\u001b[?2004h> "]
[110.688844, "o", "   if t in edges:continue\r\n\u001b[?2004l\r"]
[110.688872, "o", "\u001b[?2004h> "]
[110.689125, "o", "   zz=z(edges+[t]); choices.append((zz,t))\r\n\u001b[?2004l\r"]
[110.689157, "o", "\u001b[?2004h> "]
[110.689289, "o", "  if not choices:break\r\n\u001b[?2004l\r"]
[110.68932, "o", "\u001b[?2004h> "]
[110.689438, "o", "  zz,t=max(choices)\r\n\u001b[?2004l\r"]
[110.689468, "o", "\u001b[?2004h> "]
[110.689646, "o", "  imp=(zz-old)/max(old,1e-12)\r\n\u001b[?2004l\r"]
[110.689677, "o", "\u001b[?2004h> "]
[110.689794, "o", "  if imp<minimp:break\r\n\u001b[?2004l\r"]
[110.689823, "o", "\u001b[?2004h> "]
[110.690469, "o", "  edges.append(t);edges.sort();accepted.append({'boundary':t,'expected_z':zz,'relative_improvement':imp});old=zz\r\n\u001b[?2004l\r"]
[110.690498, "o", "\u001b[?2004h> "]
[110.690755, "o", " return sorted(edges,reverse=True),accepted\r\n\u001b[?2004l\r"]
[110.690785, "o", "\u001b[?2004h> "]
[110.690846, "o", "PY\r\n\u001b[?2004l\r"]
[110.699503, "o", "\u001b[?2004h"]
[110.699545, "o", "root@nid004247:~/submission/tth-diphoton-bdt# "]
[110.699762, "o", "cat > run_analysis.py <<'PY'\r\n\u001b[?2004l\r"]
[110.699817, "o", "\u001b[?2004h> "]
[110.700125, "o", "import os,json,math,time,glob,shutil\r\n\u001b[?2004l\r"]
[110.70016, "o", "\u001b[?2004h"]
[110.700229, "o", "> "]
[110.70038, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[110.700409, "o", "\u001b[?2004h"]
[110.700436, "o", "> "]
[110.700678, "o", "import numpy as np,pandas as pd,uproot,yaml\r\n\u001b[?2004l\r"]
[110.700715, "o", "\u001b[?2004h> "]
[110.701036, "o", "from sklearn.ensemble import GradientBoostingClassifier\r\n\u001b[?2004l\r"]
[110.701068, "o", "\u001b[?2004h> "]
[110.701344, "o", "from sklearn.preprocessing import StandardScaler\r\n\u001b[?2004l\r"]
[110.701374, "o", "\u001b[?2004h> "]
[110.701557, "o", "import matplotlib.pyplot as plt\r\n\u001b[?2004l\r"]
[110.701586, "o", "\u001b[?2004h> "]
[110.701831, "o", "from analysis.top_categorization import *\r\n\u001b[?2004l\r"]
[110.70186, "o", "\u001b[?2004h> "]
[110.702657, "o", "OUT=Path('/root/results/tth-diphoton-bdt'); IN=Path(os.getenv('TB_HYY_INPUTS','/data/GamGam')); OUT.mkdir(parents=True,exist_ok=True)\r\n\u001b[?2004l\r"]
[110.702686, "o", "\u001b[?2004h> "]
[110.703664, "o", "for d in ['model','optimization','plots','inference','categorization/histograms','categorization/plots','fit/FIT1/plots']: (OUT/d).mkdir(parents=True,exist_ok=True)\r\n\u001b[?2004l\r"]
[110.703693, "o", "\u001b[?2004h> "]
[110.704357, "o", "mc_names=['ggH','VBF','WH','ZH','ggZH','ttH','tH']; maxn=int(os.getenv('TTH_MAX_SELECTED_PER_SAMPLE','0') or 0)\r\n\u001b[?2004l\r"]
[110.704387, "o", "\u001b[?2004h> "]
[110.704806, "o", "# read required RNTuple branches, source files are nominal Higgs only\r\n\u001b[?2004l\r"]
[110.704837, "o", "\u001b[?2004h> "]
[110.706998, "o", "branches=['eventNumber','runNumber','mcWeight','xsec','filteff','kfac','sum_of_weights','ScaleFactor_PILEUP','ScaleFactor_PHOTON','ScaleFactor_BTAG','ScaleFactor_JVT','ScaleFactor_ELE','ScaleFactor_MUON','photon_pt','photon_eta','photon_phi','photon_e','photon_isTightID','photon_isTightIso','jet_pt','jet_eta','jet_phi','jet_e','jet_btag_quantile','lep_pt','lep_type']\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.707061, "o", "> rows=[]\r\n\u001b[?2004l\r"]
[110.707098, "o", "\u001b[?2004h> "]
[110.707253, "o", "def val(a,i,name,default=1):\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.70729, "o", "> "]
[110.70741, "o", " try:return a[name][i]\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.707446, "o", "> "]
[110.707569, "o", " except:return default\r\n\u001b[?2004l\r"]
[110.707603, "o", "\u001b[?2004h> "]
[110.707762, "o", "def load(path,proc,isdata):\r\n\u001b[?2004l\r"]
[110.707798, "o", "\u001b[?2004h> "]
[110.707832, "o", " nsel=0\r\n\u001b[?2004l\r"]
[110.707865, "o", "\u001b[?2004h> "]
[110.708349, "o", " for arr in uproot.iterate(str(path)+':analysis',branches,step_size='25 MB',library='ak'):\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.708378, "o", "> "]
[110.7085, "o", "  import awkward as ak\r\n\u001b[?2004l\r"]
[110.708528, "o", "\u001b[?2004h> "]
[110.708793, "o", "  for i in range(len(arr['eventNumber'])):\r\n\u001b[?2004l\r"]
[110.708846, "o", "\u001b[?2004h> "]
[110.710763, "o", "   ph=[(float(arr['photon_pt'][i][j]),float(arr['photon_eta'][i][j]),float(arr['photon_phi'][i][j]),float(arr['photon_e'][i][j]),bool(arr['photon_isTightID'][i][j]),bool(arr['photon_isTightIso'][i][j])) for j in range(len(arr['photon_pt'][i])) if float(arr['photon_pt'][i][j])>25 and abs(float(arr['photon_eta'][i][j]))<2.37]\r\n\u001b[?2004l\r"]
[110.710799, "o", "\u001b[?2004h> "]
[110.710946, "o", "   if len(ph)<2: continue\r\n\u001b[?2004l\r"]
[110.710981, "o", "\u001b[?2004h> "]
[110.711616, "o", "   ph=sorted(ph,key=lambda x:x[0],reverse=True)[:2]; m=invariant_mass(ph); ti=all(x[4] and x[5] for x in ph)\r\n\u001b[?2004l\r"]
[110.711646, "o", "\u001b[?2004h> "]
[110.712813, "o", "   jets=[(float(arr['jet_pt'][i][j]),float(arr['jet_eta'][i][j]),float(arr['jet_phi'][i][j]),float(arr['jet_e'][i][j]),int(arr['jet_btag_quantile'][i][j])) for j in range(len(arr['jet_pt'][i]))]\r\n\u001b[?2004l\r"]
[110.712844, "o", "\u001b[?2004h> "]
[110.713783, "o", "   f=build_jet_features(jets); nl=sum(float(x)>10 for x in arr['lep_pt'][i]); had=nl==0 and f['n_jets']>=3 and f['n_bjets']>=1; lep=nl>=1 and f['n_bjets']>=1\r\n\u001b[?2004l\r"]
[110.713812, "o", "\u001b[?2004h> "]
[110.713998, "o", "   if not (had or lep):continue\r\n\u001b[?2004l\r"]
[110.714028, "o", "\u001b[?2004h> "]
[110.714217, "o", "   if maxn and nsel>=maxn:break\r\n\u001b[?2004l\r"]
[110.714247, "o", "\u001b[?2004h> "]
[110.715626, "o", "   eid=f\"{int(arr['runNumber'][i])}:{int(arr['eventNumber'][i])}\"; sf=np.prod([float(val(arr,i,x,1)) for x in ['ScaleFactor_PILEUP','ScaleFactor_PHOTON','ScaleFactor_BTAG','ScaleFactor_JVT','ScaleFactor_ELE','ScaleFactor_MUON']])\r\n\u001b[?2004l\r"]
[110.715656, "o", "\u001b[?2004h> "]
[110.716195, "o", "   # pb * fb^-1 *1000 / signed sum weights. File per-event sum values provide denominator.\r\n\u001b[?2004l\r"]
[110.716224, "o", "\u001b[?2004h> "]
[110.717336, "o", "   sw=float(arr['sum_of_weights'][i]); phys=1. if isdata else float(arr['xsec'][i])*float(arr['filteff'][i])*float(arr['kfac'][i])*1000*36*float(arr['mcWeight'][i])*sf/(sw if sw else 1)\r\n\u001b[?2004l\r"]
[110.717367, "o", "\u001b[?2004h> "]
[110.719276, "o", "   r={'event_id':eid,'process':proc,'sample':proc,'is_data':isdata,'m_gammagamma':m,'diphoton_ti':ti,'diphoton_region':'TI' if ti else 'NTI','channel':'hadronic' if had else 'leptonic_bookkeeping','n_leptons':nl,'partition':stable_partition(eid),'event_weight_signed':phys,'observed_data_weight':1. if isdata else 0.,**f}\r\n\u001b[?2004l\r"]
[110.719306, "o", "\u001b[?2004h> "]
[110.71972, "o", "   r.update({x:r[x] for x in BDT_FEATURES}); rows.append(r);nsel+=1\r\n\u001b[?2004l\r"]
[110.719758, "o", "\u001b[?2004h> "]
[110.719919, "o", "  if maxn and nsel>=maxn:break\r\n\u001b[?2004l\r"]
[110.719957, "o", "\u001b[?2004h> "]
[110.72033, "o", "for p in mc_names:load(IN/'MC'/f'{p}_preselection.root',p,False)\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.720367, "o", "> "]
[110.720656, "o", "load(IN/'data'/'data_preselection.root','data',True)\r\n\u001b[?2004l\r"]
[110.720684, "o", "\u001b[?2004h> "]
[110.721124, "o", "df=pd.DataFrame(rows); df.to_csv(OUT/'preselected_events.csv',index=False)\r\n\u001b[?2004l\r"]
[110.721154, "o", "\u001b[?2004h> "]
[110.721577, "o", "# NTI sideband factors, data only. no TI window observation ever counted\r\n\u001b[?2004l\r"]
[110.721607, "o", "\u001b[?2004h> "]
[110.722377, "o", "side=((df.m_gammagamma>=105)&(df.m_gammagamma<120))|((df.m_gammagamma>130)&(df.m_gammagamma<=160)); win=abs(df.m_gammagamma-125)<=2\r\n\u001b[?2004l\r"]
[110.722406, "o", "\u001b[?2004h> "]
[110.723134, "o", "dat=df[df.is_data]; nti_sb=dat[(~dat.diphoton_ti)&side]; ti_sb=dat[dat.diphoton_ti&side]; nti_win=dat[(~dat.diphoton_ti)&win]\r\n\u001b[?2004l\r"]
[110.723163, "o", "\u001b[?2004h> "]
[110.723663, "o", "sf1=len(ti_sb)/max(len(nti_sb),1);sf2=len(nti_win)/max(len(nti_sb),1); proxy=sf1*sf2\r\n\u001b[?2004l\r"]
[110.723693, "o", "\u001b[?2004h> "]
[110.724419, "o", "# only hadronic finite feature events score; construct training mixture ttH/tH TI signal, ggH TI window and NTI sideband data\r\n\u001b[?2004l\r"]
[110.724449, "o", "\u001b[?2004h> "]
[110.725579, "o", "had=df[(df.channel=='hadronic') & np.isfinite(df[BDT_FEATURES]).all(axis=1)].copy(); had['training_role']='inference_only';had['nti_proxy_weight']=0.;had['significance_model_weight_36fb']=0.\r\n\u001b[?2004l\r"]
[110.725609, "o", "\u001b[?2004h> "]
[110.726114, "o", "modelmask=(had.diphoton_ti & win & ~had.is_data) | ((~had.diphoton_ti)&had.is_data&side)\r\n\u001b[?2004l\r"]
[110.726146, "o", "\u001b[?2004h> "]
[110.726984, "o", "had.loc[(~had.is_data)&had.diphoton_ti&win,'significance_model_weight_36fb']=had.loc[(~had.is_data)&had.diphoton_ti&win,'event_weight_signed']\r\n\u001b[?2004l\r"]
[110.727014, "o", "\u001b[?2004h> "]
[110.727926, "o", "had.loc[had.is_data&(~had.diphoton_ti)&side,'nti_proxy_weight']=proxy;had.loc[had.is_data&(~had.diphoton_ti)&side,'significance_model_weight_36fb']=proxy\r\n\u001b[?2004l\r"]
[110.727956, "o", "\u001b[?2004h> "]
[110.728866, "o", "train=had[((had.process.isin(['ttH','tH']))&had.diphoton_ti&win)|((had.process=='ggH')&had.diphoton_ti&win)|((had.is_data)&(~had.diphoton_ti)&side)].copy()\r\n\u001b[?2004l\r"]
[110.728896, "o", "\u001b[?2004h> "]
[110.729765, "o", "train['label']=train.process.isin(['ttH','tH']).astype(int);train['training_role']=np.where(train.label==1,'signal_ttH_tH','background_ggH_or_NTI')\r\n\u001b[?2004l\r"]
[110.729794, "o", "\u001b[?2004h> "]
[110.730357, "o", "train['physical_training_weight']=np.where(train.is_data,proxy,train.event_weight_signed.abs())\r\n\u001b[?2004l\r"]
[110.730388, "o", "\u001b[?2004h> "]
[110.732052, "o", "pre=train.groupby('label').physical_training_weight.sum().to_dict(); target=max(pre.values()) if pre else 1; train['bdt_fit_weight']=train.apply(lambda x:x.physical_training_weight*target/max(pre.get(x.label,1),1e-12),axis=1);post=train.groupby('label').bdt_fit_weight.sum().to_dict()\r\n\u001b[?2004l\r"]
[110.732081, "o", "\u001b[?2004h> "]
[110.732551, "o", "# Fit robustly, split deterministic but permit all train if partition undersized\r\n\u001b[?2004l\r\u001b[?2004h"]
