[703.13263, "o", "    15\t try:return a[name][i]\r\n    16\t except:return default\r\n    17\tdef load(path,proc,isdata):\r\n    18\t nsel=0\r\n    19\t for arr in uproot.iterate(str(path)+':analysis',branches,step_size='25 MB',library='ak'):\r\n    20\t  import awkward as ak\r\n    21\t  for i in range(len(arr['eventNumber'])):\r\n    22\t   ph=[(float(arr['photon_pt'][i][j]),float(arr['photon_eta'][i][j]),float(arr['photon_phi'][i][j]),float(arr['photon_e'][i][j]),bool(arr['photon_isTightID'][i][j]),bool(arr['photon_isTightIso'][i][j])) for j in range(len(arr['photon_pt'][i])) if float(arr['photon_pt'][i][j])>25 and abs(float(arr['photon_eta'][i][j]))<2.37]\r\n    23\t   if len(ph)<2: continue\r\n    24\t   ph=sorted(ph,key=lambda x:x[0],reverse=True)[:2]; m=invariant_mass(ph); ti=all(x[4] and x[5] for x in ph)\r\n    25\t   jets=[(float(arr['jet_pt'][i][j]),float(arr['jet_eta'][i][j]),float(arr['jet_phi'][i][j]),float(arr['jet_e'][i][j]),int(arr['jet_btag_quantile'][i][j])) for j in range(len(arr['jet_pt'][i]))]\r\n    26\t   f=build_jet_features(jets); nl=sum(float(x)>10 for x in arr['lep_pt'][i]); had=nl==0 and f['n_jets']>=3 and f['n_bjets']>=1; lep=nl>=1 and f['n_bjets']>=1\r\n    27\t   if not (had or lep):continue\r\n    28\t   if maxn and nsel>=maxn:break\r\n    29\t   eid=f\"{int(arr['runNumber'][i])}:{int(arr['eventNumber'][i])}\"; sf=np.prod([float(val(arr,i,x,1)) for x in ['ScaleFactor_PILEUP','ScaleFactor_PHOTON','ScaleFactor_BTAG','ScaleFactor_JVT','ScaleFactor_ELE','ScaleFactor_MUON']])\r\n    30\t   # pb * fb^-1 *1000 / signed sum weights. File per-event sum values provide denominator.\r\n    31\t   sw=float(arr['sum_of_weights'][i]); phys=1. if isdata else float(arr['xsec'][i])*float(arr['filteff'][i])*float(arr['kfac'][i])*1000*36*float(arr['mcWeight'][i])*sf/(sw if sw else 1)\r\n    32\t   r={'event_id':eid,'process':proc,'sample':proc,'is_data':isdata,'m_gammagamma':m,'diphoton_ti':ti,'diphoton_region':'TI' if ti else 'NTI','channel':'hadronic' if had else 'leptonic_bookkeeping','n_leptons':nl,'partition':stable_partition(eid),'event_weight_signed':phys,'observed_data_weight':1. if isdata else 0.,**f}\r\n    33\t   r.update({x:r[x] for x in BDT_FEATURES}); rows.append(r);nsel+=1\r\n    34\t  if maxn and nsel>=maxn:break\r\n    35\tfor p in mc_names:load(IN/'MC'/f'{p}_preselection.root',p,False)\r\n    36\tload(IN/'data'/'data_preselection.root','data',True)\r\n    37\tdf=pd.DataFrame(rows); df.to_csv(OUT/'preselected_events.csv',index=False)\r\n    38\t# NTI sideband factors, data only. no TI window observation ever counted\r\n    39\tside=((df.m_gammagamma>=105)&(df.m_gammagamma<120))|((df.m_gammagamma>130)&(df.m_gammagamma<=160)); win=abs(df.m_gammagamma-125)<=2\r\n    40\tdat=df[df.is_data]; nti_sb=dat[(~dat.diphoton_ti)&side]; ti_sb=dat[dat.diphoton_ti&side]; nti_win=dat[(~dat.diphoton_ti)&win]\r\n    41\tsf1=len(ti_sb)/max(len(nti_sb),1);sf2=len(nti_win)/max(len(nti_sb),1); proxy=sf1*sf2\r\n    42\t# only hadronic finite feature events score; construct training mixture ttH/tH TI signal, ggH TI window and NTI sideband data\r\n"]
