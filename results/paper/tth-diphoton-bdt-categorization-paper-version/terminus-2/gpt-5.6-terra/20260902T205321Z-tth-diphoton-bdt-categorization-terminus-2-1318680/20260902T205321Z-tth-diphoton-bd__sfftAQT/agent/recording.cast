[947.007535, "i", "cd /root/submission/tth-diphoton-bdt && python3 - <<'PY'\nimport pandas as pd,numpy as np,json\nfrom pathlib import Path\nout=Path('/root/results/tth-diphoton-bdt'); h=pd.read_csv(out/'hadronic_features.csv'); edges=np.linspace(105,160,28); payload={}\nfor cat in ['ttH_had_BDT1','ttH_had_BDT2','ttH_had_BDT3','ttH_had_BDT4','tH_had_4j1b','tH_had_4j2b','unassigned']:\n q=h[h.assigned_category==cat]; payload[cat]={'bin_edges':edges.tolist(),'components':{}}\n for name,mask in {'ttH_tH':q.process.isin(['ttH','tH']),'resonant_higgs':(~q.is_data)&(~q.process.isin(['ttH','tH'])),'NTI_continuum_proxy':q.is_data}.items():\n  x=q[mask]; w=x.significance_model_weight_36fb.to_numpy(); a,_=np.histogram(x.m_gammagamma,bins=edges,weights=w); b,_=np.histogram(x.m_gammagamma,bins=edges,weights=w*w); payload[cat]['components'][name]={'bin_contents':a.tolist(),'sumw2':b.tolist()}\n(out/'categorization/histograms/category_mgg_control_histograms.json').write_text(json.dumps(payload,indent=2))\n# record globally stable event-ID convention\nm=json.loads((out/'inference/inference_manifest.json').read_text());m['event_identifier']='process:runNumber:eventNumber (stable sample-qualified identifier)';(out/'inference/inference_manifest.json').write_text(json.dumps(m,indent=2))\nPY\npython3 - <<'PY'\nimport pandas as pd, pathlib\nout=pathlib.Path('/root/results/tth-diphoton-bdt'); d=pd.read_csv(out/'predictions.csv'); h=d[d.channel=='hadronic']\nprint('rows=',len(d),'hadronic=',len(h),'unique_hadronic_ids=',h.event_id.nunique(),'finite_scores=',h.bdt_score.between(0,1).sum())\nreq=['config_resolved.yaml','input_data_contract.json','object_definition_record.json','preselection_summary.json','cutflow.json','metrics.json','preselected_events.csv','predictions.csv','hadronic_features.csv','inference/inference_manifest.json','inference/events_with_bdt_scores.csv','category_yields_36fb.json','categorization/category_summary.csv','fit/FIT1/workspace.root','report.md','run_manifest.json']\nprint('missing=',[x for x in req if not (out/x).exists()])\nPY\n"]
