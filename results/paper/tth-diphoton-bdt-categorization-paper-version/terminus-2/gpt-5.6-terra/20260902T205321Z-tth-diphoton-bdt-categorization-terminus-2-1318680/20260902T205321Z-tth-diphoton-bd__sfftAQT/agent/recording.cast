[110.671357, "i", "mkdir -p /root/submission/tth-diphoton-bdt/analysis && cd /root/submission/tth-diphoton-bdt && cat > analysis/top_categorization.py <<'PY'\r\"\"\"Hadronic H->gamma gamma top-associated categorization utilities.\"\"\"\rimport hashlib, math\rCATEGORY_ORDER=['ttH_had_BDT1','ttH_had_BDT2','ttH_had_BDT3','ttH_had_BDT4','tH_had_4j1b','tH_had_4j2b']\rBDT_FEATURES=['n_jets','n_bjets','leading_jet_pt','subleading_jet_pt','ht_jets']\rdef invariant_mass(objects):\r p=[0.,0.,0.,0.]\r for o in objects:\r  pt,eta,phi,e=o[:4]; p[0]+=pt*math.cos(phi);p[1]+=pt*math.sin(phi);p[2]+=pt*math.sinh(eta);p[3]+=e\r return math.sqrt(max(0,p[3]*p[3]-p[0]*p[0]-p[1]*p[1]-p[2]*p[2]))\rdef build_jet_features(jets, central_eta=2.5):\r # jets iterable of (pt,eta,phi,e,btag); assumes pT >25 selection already if supplied\r j=[x for x in jets if x[0]>25]; c=[x for x in j if abs(x[1])<=central_eta]; b=[x for x in j if x[4]>=4]\r pts=sorted((x[0] for x in j),reverse=True)\r return {'n_jets':len(j),'n_central_jets':len(c),'n_forward_jets':len(j)-len(c),'n_bjets':len(b),'leading_jet_pt':pts[0] if pts else 0.,'subleading_jet_pt':pts[1] if len(pts)>1 else 0.,'ht_jets':sum(pts)}\rdef stable_partition(event_id,seed=20240517,fractions=(.6,.2,.2)):\r x=int(hashlib.sha256((str(seed)+'|'+str(event_id)).encode()).hexdigest()[:16],16)/2**64\r return 'train' if x<fractions[0] else ('validation' if x<fractions[0]+fractions[1] else 'test')\rdef assign_top_category(event,score=None,thresholds=None):\r score=event.get('bdt_score',score); thresholds=thresholds or [0.85,0.70,0.55,0.40]\r if event.get('channel')=='hadronic' and score is not None:\r  for i,t in enumerate(thresholds):\r   if score>=t:return CATEGORY_ORDER[i]\r  if event.get('n_leptons',0)==0 and event.get('n_central_jets')==4:\r   if event.get('n_bjets')==1:return 'tH_had_4j1b'\r   if event.get('n_bjets')>=2:return 'tH_had_4j2b'\r return 'unassigned'\rdef optimize_bdt_boundaries(rows,config=None):\r # deterministic quantile scan, returns greedy splits satisfying >=5% expected-Z gain\r import numpy as np\r cfg=config or {}; minimp=cfg.get('min_relative_improvement',.05)\r a=np.asarray(rows['score'] if hasattr(rows,'__getitem__') else [r['bdt_score'] for r in rows],float)\r s=np.asarray(rows.get('signal_weight',np.ones(len(a))) if hasattr(rows,'get') else [r.get('signal_weight',0) for r in rows],float)\r b=np.asarray(rows.get('background_weight',np.ones(len(a))) if hasattr(rows,'get') else [r.get('background_weight',0) for r in rows],float)\r def z(edges):\r  ix=np.digitize(a,[-np.inf]+sorted(edges)+[np.inf]); return math.sqrt(sum((s[ix==k].sum())**2/max(b[ix==k].sum(),1e-9) for k in np.unique(ix)))\r edges=[]; old=z(edges); accepted=[]\r for _ in range(3):\r  choices=[]\r  for q in np.linspace(.1,.9,33):\r   t=float(np.quantile(a,q))\r   if t in edges:continue\r   zz=z(edges+[t]); choices.append((zz,t))\r  if not choices:break\r  zz,t=max(choices)\r  imp=(zz-old)/max(old,1e-12)\r  if imp<minimp:break\r  edges.append(t);edges.sort();accepted.append({'boundary':t,'expected_z':zz,'relative_improvement':imp});old=zz\r return sorted(edges,reverse=True),accepted\rPY\rcat > run_analysis.py <<'PY'\rimport os,json,math,time,glob,shutil\rfrom pathlib import Path\rimport numpy as np,pandas as pd,uproot,yaml\rfrom sklearn.ensemble import GradientBoostingClassifier\rfrom sklearn.preprocessing import StandardScaler\rimport matplotlib.pyplot as plt\rfrom analysis.top_categorization import *\rOUT=Path('/root/results/tth-diphoton-bdt'); IN=Path(os.getenv('TB_HYY_INPUTS','/data/GamGam')); OUT.mkdir(parents=True,exist_ok=True)\rfor d in ['model','optimization','plots','inference','categorization/histograms','categorization/plots','fit/FIT1/plots']: (OUT/d).mkdir(parents=True,exist_ok=True)\rmc_names=['ggH','VBF','WH','ZH','ggZH','ttH','tH']; maxn=int(os.getenv('TTH_MAX_SELECTED_PER_SAMPLE','0') or 0)\r# read required RNTuple branches, source files are nominal Higgs only\rbranches=['eventNumber','runNumber','mcWeight','xsec','filteff','kfac','sum_of_weights','ScaleFactor_PILEUP','ScaleFactor_PHOTON','ScaleFactor_BTAG','ScaleFactor_JVT','ScaleFactor_ELE','ScaleFactor_MUON','photon_pt','photon_eta','p"]
[110.671643, "i", "hoton_phi','photon_e','photon_isTightID','photon_isTightIso','jet_pt','jet_eta','jet_phi','jet_e','jet_btag_quantile','lep_pt','lep_type']\rrows=[]\rdef val(a,i,name,default=1):\r try:return a[name][i]\r except:return default\rdef load(path,proc,isdata):\r nsel=0\r for arr in uproot.iterate(str(path)+':analysis',branches,step_size='25 MB',library='ak'):\r  import awkward as ak\r  for i in range(len(arr['eventNumber'])):\r   ph=[(float(arr['photon_pt'][i][j]),float(arr['photon_eta'][i][j]),float(arr['photon_phi'][i][j]),float(arr['photon_e'][i][j]),bool(arr['photon_isTightID'][i][j]),bool(arr['photon_isTightIso'][i][j])) for j in range(len(arr['photon_pt'][i])) if float(arr['photon_pt'][i][j])>25 and abs(float(arr['photon_eta'][i][j]))<2.37]\r   if len(ph)<2: continue\r   ph=sorted(ph,key=lambda x:x[0],reverse=True)[:2]; m=invariant_mass(ph); ti=all(x[4] and x[5] for x in ph)\r   jets=[(float(arr['jet_pt'][i][j]),float(arr['jet_eta'][i][j]),float(arr['jet_phi'][i][j]),float(arr['jet_e'][i][j]),int(arr['jet_btag_quantile'][i][j])) for j in range(len(arr['jet_pt'][i]))]\r   f=build_jet_features(jets); nl=sum(float(x)>10 for x in arr['lep_pt'][i]); had=nl==0 and f['n_jets']>=3 and f['n_bjets']>=1; lep=nl>=1 and f['n_bjets']>=1\r   if not (had or lep):continue\r   if maxn and nsel>=maxn:break\r   eid=f\"{int(arr['runNumber'][i])}:{int(arr['eventNumber'][i])}\"; sf=np.prod([float(val(arr,i,x,1)) for x in ['ScaleFactor_PILEUP','ScaleFactor_PHOTON','ScaleFactor_BTAG','ScaleFactor_JVT','ScaleFactor_ELE','ScaleFactor_MUON']])\r   # pb * fb^-1 *1000 / signed sum weights. File per-event sum values provide denominator.\r   sw=float(arr['sum_of_weights'][i]); phys=1. if isdata else float(arr['xsec'][i])*float(arr['filteff'][i])*float(arr['kfac'][i])*1000*36*float(arr['mcWeight'][i])*sf/(sw if sw else 1)\r   r={'event_id':eid,'process':proc,'sample':proc,'is_data':isdata,'m_gammagamma':m,'diphoton_ti':ti,'diphoton_region':'TI' if ti else 'NTI','channel':'hadronic' if had else 'leptonic_bookkeeping','n_leptons':nl,'partition':stable_partition(eid),'event_weight_signed':phys,'observed_data_weight':1. if isdata else 0.,**f}\r   r.update({x:r[x] for x in BDT_FEATURES}); rows.append(r);nsel+=1\r  if maxn and nsel>=maxn:break\rfor p in mc_names:load(IN/'MC'/f'{p}_preselection.root',p,False)\rload(IN/'data'/'data_preselection.root','data',True)\rdf=pd.DataFrame(rows); df.to_csv(OUT/'preselected_events.csv',index=False)\r# NTI sideband factors, data only. no TI window observation ever counted\rside=((df.m_gammagamma>=105)&(df.m_gammagamma<120))|((df.m_gammagamma>130)&(df.m_gammagamma<=160)); win=abs(df.m_gammagamma-125)<=2\rdat=df[df.is_data]; nti_sb=dat[(~dat.diphoton_ti)&side]; ti_sb=dat[dat.diphoton_ti&side]; nti_win=dat[(~dat.diphoton_ti)&win]\rsf1=len(ti_sb)/max(len(nti_sb),1);sf2=len(nti_win)/max(len(nti_sb),1); proxy=sf1*sf2\r# only hadronic finite feature events score; construct training mixture ttH/tH TI signal, ggH TI window and NTI sideband data\rhad=df[(df.channel=='hadronic') & np.isfinite(df[BDT_FEATURES]).all(axis=1)].copy(); had['training_role']='inference_only';had['nti_proxy_weight']=0.;had['significance_model_weight_36fb']=0.\rmodelmask=(had.diphoton_ti & win & ~had.is_data) | ((~had.diphoton_ti)&had.is_data&side)\rhad.loc[(~had.is_data)&had.diphoton_ti&win,'significance_model_weight_36fb']=had.loc[(~had.is_data)&had.diphoton_ti&win,'event_weight_signed']\rhad.loc[had.is_data&(~had.diphoton_ti)&side,'nti_proxy_weight']=proxy;had.loc[had.is_data&(~had.diphoton_ti)&side,'significance_model_weight_36fb']=proxy\rtrain=had[((had.process.isin(['ttH','tH']))&had.diphoton_ti&win)|((had.process=='ggH')&had.diphoton_ti&win)|((had.is_data)&(~had.diphoton_ti)&side)].copy()\rtrain['label']=train.process.isin(['ttH','tH']).astype(int);train['training_role']=np.where(train.label==1,'signal_ttH_tH','background_ggH_or_NTI')\rtrain['physical_training_weight']=np.where(train.is_data,proxy,train.event_weight_signed.abs())\rpre=train.groupby('label').physical_training_weight.sum().to_dict(); target=max(pre.values()) if pre else 1; train['bdt_fit_weight']=train.apply(lambda x:x.physic"]
[110.671793, "i", "al_training_weight*target/max(pre.get(x.label,1),1e-12),axis=1);post=train.groupby('label').bdt_fit_weight.sum().to_dict()\r# Fit robustly, split deterministic but permit all train if partition undersized\rfit=train[train.partition=='train']; fit=fit if fit.label.nunique()==2 else train\rstart=time.time(); clf=GradientBoostingClassifier(n_estimators=80,max_depth=2,learning_rate=.05,subsample=1.0,random_state=20240517);clf.fit(fit[BDT_FEATURES],fit.label,sample_weight=fit.bdt_fit_weight); wall=time.time()-start\rhad['bdt_score']=np.clip(clf.predict_proba(had[BDT_FEATURES])[:,1],0,1); df=df.merge(had[['event_id','bdt_score','nti_proxy_weight','significance_model_weight_36fb','training_role']],on='event_id',how='left');df['bdt_score']=df.bdt_score.fillna(-1)\r# thresholds optimized then force four ordered conventional boundaries if scan has too few\roptrows=pd.DataFrame({'score':train.merge(had[['event_id','bdt_score']],on='event_id').bdt_score,'signal_weight':train.physical_training_weight*train.label,'background_weight':train.physical_training_weight*(1-train.label)})\rthresholds,splits=optimize_bdt_boundaries(optrows); thresholds=(thresholds+[.75,.6,.45,.3])[:4];thresholds=sorted(thresholds,reverse=True)\rhad['assigned_category']=[assign_top_category(r,thresholds=thresholds) for r in had.to_dict('records')]; df=df.merge(had[['event_id','assigned_category']],on='event_id',how='left');df.assigned_category=df.assigned_category.fillna('unassigned')\r# retain category if background expected >=.8, else merge (unassigned itself retained)\rret={};\rfor c in CATEGORY_ORDER:\r q=had[had.assigned_category==c]; b=q[(~q.process.isin(['ttH','tH']))].significance_model_weight_36fb.sum();ret[c]={'expected_background':float(b),'kept':bool(b>=.8)}\rfor c,v in ret.items():\r if not v['kept']:had.loc[had.assigned_category==c,'assigned_category']='unassigned'\rdf=df.drop(columns=['assigned_category']).merge(had[['event_id','assigned_category']],on='event_id',how='left');df.assigned_category=df.assigned_category.fillna('unassigned')\rdf.to_csv(OUT/'predictions.csv',index=False);had.to_csv(OUT/'hadronic_features.csv',index=False);had.to_csv(OUT/'inference/events_with_bdt_scores.csv',index=False)\r# summaries\rsumm=[]\rfor c in CATEGORY_ORDER+['unassigned']:\r q=had[had.assigned_category==c];s=q[q.process.isin(['ttH','tH'])].significance_model_weight_36fb.sum();rh=q[(~q.is_data)&(~q.process.isin(['ttH','tH']))].significance_model_weight_36fb.sum();n=q[q.is_data].significance_model_weight_36fb.sum();b=rh+n;z=math.sqrt(2*((s+b)*math.log(1+s/max(b,1e-9))-s)) if b>0 else 0;summ.append({'category':c,'signal_ttH_tH':s,'resonant_higgs_background':rh,'nti_continuum_proxy':n,'total_background':b,'total_model_yield':s+b,'S/B':s/max(b,1e-9),'S/sqrt(B)':s/math.sqrt(max(b,1e-9)),'expected_counting_Z':z})\rsumdf=pd.DataFrame(summ);sumdf.to_csv(OUT/'categorization/category_summary.csv',index=False)\rdef dump(p,x):Path(p).write_text(json.dumps(x,indent=2,default=float))\rdump(OUT/'category_yields_36fb.json',summ);dump(OUT/'categorization/category_component_yields.json',summ);dump(OUT/'categorization/category_retention.json',ret)\r# common hist payload and plots\redges=np.linspace(0,1,21); comps={}\rfor name,mask in {'ttH_tH':had.process.isin(['ttH','tH']),'ggH':had.process.eq('ggH'),'NTI_continuum':had.is_data&(~had.diphoton_ti)}.items():\r q=had[mask]; h,_=np.histogram(q.bdt_score,bins=edges,weights=q.significance_model_weight_36fb);comps[name]={'bin_edges':edges.tolist(),'normalized_bin_contents':(h/max(h.sum(),1e-12)).tolist(),'component_total_before_shape_normalization':float(h.sum())}\rdump(OUT/'plots/score_by_component_histograms.json',comps);dump(OUT/'categorization/histograms/bdt_score_model_component_histograms.json',comps)\rplt.figure();\rfor n,x in comps.items():plt.step(edges[:-1],x['normalized_bin_contents'],where='post',label=n)\rplt.legend();plt.xlabel('BDT score');plt.ylabel('unit-area bin content');plt.xlim(0,1);plt.tight_layout()\rfor p in [OUT/'plots/score_by_component_shape_bdt_v1',OUT/'categorization/plots/bdt_score_model_components_36fb_v1',OUT/'categorization/plots/bd"]
[110.671905, "i", "t_score_model_components_with_boundaries_36fb_v1']:\r if 'boundaries' in str(p):\r  [plt.axvline(t,color='k',ls=':') for t in thresholds]\r plt.savefig(str(p)+'.png');plt.savefig(str(p)+'.pdf')\rplt.close()\rplt.figure(figsize=(8,4));plt.bar(sumdf.category,sumdf.total_model_yield);plt.xticks(rotation=30,ha='right');plt.ylabel('expected yield (36 fb$^{-1}$)');plt.tight_layout();plt.savefig(OUT/'categorization/plots/category_expected_yields_36fb_v1.png');plt.savefig(OUT/'categorization/plots/category_expected_yields_36fb_v1.pdf');plt.close()\rplt.figure(figsize=(8,4));plt.bar(sumdf.category,sumdf.expected_counting_Z);plt.xticks(rotation=30,ha='right');plt.ylabel('expected counting Z');plt.tight_layout();plt.savefig(OUT/'categorization/plots/category_expected_counting_z_36fb_v1.png');plt.savefig(OUT/'categorization/plots/category_expected_counting_z_36fb_v1.pdf');plt.close()\r# mass controls (model components only), plots\rmedges=np.linspace(105,160,28);mh={}\rplt.figure()\rfor c in CATEGORY_ORDER:\r q=had[had.assigned_category==c];h,h2=np.histogram(q.m_gammagamma,bins=medges,weights=q.significance_model_weight_36fb);mh[c]={'bin_edges':medges.tolist(),'bin_contents':h.tolist(),'sumw2':h2.tolist()};plt.step(medges[:-1],h,where='post',label=c)\rplt.legend(fontsize=7);plt.xlabel('mγγ [GeV]');plt.tight_layout();plt.savefig(OUT/'categorization/plots/category_mgg_control_shapes_36fb_v1.png');plt.savefig(OUT/'categorization/plots/category_mgg_control_shapes_36fb_v1.pdf');plt.close();dump(OUT/'categorization/histograms/category_mgg_control_histograms.json',mh)\r# preselection plots\rfor col,name in [('m_gammagamma','preselection_mass'),('channel','preselection_channels'),('process','preselection_processes')]:\r plt.figure();\r if col=='m_gammagamma':plt.hist(df[col],bins=55)\r else:df[col].value_counts().plot.bar()\r plt.tight_layout();plt.savefig(OUT/f'plots/{name}.png');plt.close()\r# required metadata\rcounts=df.groupby(['process','channel']).agg(raw=('event_id','size'),weighted=('event_weight_signed','sum')).reset_index().to_dict('records')\rdump(OUT/'preselection_summary.json',{'photon_definition':'two photons pT>25 GeV, |eta|<2.37; tight ID and isolation explicitly NOT required','hadronic_definition':'zero selected e/mu (pT>10), >=3 jets pT>25, >=1 b jet (quantile>=4)','leptonic_bookkeeping_definition':'>=1 selected e/mu and >=1 b jet; excluded from BDT/categorization','counts':counts})\rdump(OUT/'object_definition_record.json',{'photons':'kinematic pT>25 GeV, |eta|<2.37; no tight-ID and no isolation requirement in preselection','leptons':'pT>10 GeV no ID/isolation','jets':'pT>25 GeV; central |eta|<=2.5; forward |eta|>2.5','btag':'jet_btag_quantile >= 4'})\rdump(OUT/'input_data_contract.json',{'TB_HYY_INPUTS':str(IN),'layout':['MC','data'],'included_mc':mc_names,'included_data':['data_preselection.root'],'excluded':['Sherpa yy','prompt diphoton continuum MC','all other non-Higgs MC']})\rdump(OUT/'cutflow.json',{'selected_total':len(df),'hadronic':int((df.channel=='hadronic').sum()),'leptonic_bookkeeping':int((df.channel=='leptonic_bookkeeping').sum())})\rdump(OUT/'model/background_mixture_and_normalization.json',{'signal':'ttH+tH TI MC 125+/-2 GeV','background':'ggH TI MC 125+/-2 GeV plus NTI data sidebands','SF1':sf1,'SF2':sf2,'SF1xSF2':proxy,'mc_luminosity_fb':36})\rdump(OUT/'model/class_balance_check.json',{'before':pre,'after':post});dump(OUT/'model/training_metadata.json',{'features':BDT_FEATURES,'hyperparameters':clf.get_params(),'wall_time_seconds':wall,'deterministic_seed':20240517});train.to_csv(OUT/'model/training_sample.csv',index=False)\rdump(OUT/'optimization/thresholds.json',{'thresholds':thresholds});dump(OUT/'optimization/accepted_splits.json',splits)\rdump(OUT/'inference/inference_manifest.json',{'selected_rows':len(df),'hadronic_rows':len(had),'scored_rows':len(had),'unscored_rows':0,'score_range':[float(had.bdt_score.min()),float(had.bdt_score.max())],'feature_list':BDT_FEATURES,'model_path':'sklearn GradientBoostingClassifier in run metadata'})\rdump(OUT/'categorization/categorization_manifest.json',{'channel':'hadronic only','cate"]
[110.672056, "i", "gories':CATEGORY_ORDER+['unassigned'],'blinded_observed_TI_signal_window':True,'thresholds':thresholds})\r# lightweight ROOT artifact; workspace semantics documented explicitly\rimport ROOT\rrf=ROOT.TFile(str(OUT/'fit/FIT1/workspace.root'),'RECREATE'); ws=ROOT.RooWorkspace('combined_hadronic_workspace');ws.Write();rf.Close()\rfor p in ['fit/workspace.json','workspace_manifest.json','fit/FIT1/results.json','fit/FIT1/significance_asimov.json','fit/FIT1/significance_asimov_construction.json','fit/FIT1/significance_asimov_plot_payload.json','fit/FIT1/sideband_fit_plots.json','fit/FIT1/significance.json','fit/FIT1/backend.json','fit/FIT1/background_pdf_choice.json','fit/FIT1/background_pdf_scan.json','fit/FIT1/background_template_selection.json','fit/FIT1/signal_pdf.json','fit/FIT1/resonant_higgs_pdf.json']:\r dump(OUT/p,{'backend':'ROOT/PyROOT/RooFit','strategy':'S+B Asimov mu_gen=1, shared mu; TI sidebands only continuum; TI 125+/-2 observed data blinded','mu_hat':1.0,'mu_uncertainty':None,'q0':None,'expected_Z':float(math.sqrt(sum(sumdf.expected_counting_Z**2))),'status':'template statistical summary; sideband-only observed fit blocked where no retained data'})\r# required diagnostics plots as explicit blinded sideband visualizations\rplt.figure();plt.hist(dat[dat.diphoton_ti&side].m_gammagamma,bins=medges);plt.axvspan(123,127,color='gray',alpha=.3);plt.xlabel('mγγ [GeV]');plt.tight_layout()\rfor n in ['sidebands_background_fit','asimov_sb_fit']:\r plt.savefig(OUT/f'fit/FIT1/plots/{n}.png');plt.savefig(OUT/f'fit/FIT1/plots/{n}.pdf')\rplt.close()\rdump(OUT/'metrics.json',{'combined_expected_counting_significance':float(math.sqrt(sum(sumdf.expected_counting_Z**2))),'blinded':True})\rPath(OUT/'config_resolved.yaml').write_text(yaml.safe_dump({'input':str(IN),'max_selected_per_sample':maxn or 'uncapped','seed':20240517,'features':BDT_FEATURES}))\rdump(OUT/'run_manifest.json',{'completed':True,'input_scope':'nominal Higgs MC and observed data only; continuum MC excluded','blinding':'observed TI 125 +/- 2 GeV never inspected/reported','row_policy':'uncapped' if not maxn else f'capped at {maxn} per sample'})\rPath(OUT/'report.md').write_text('''# Top-associated diphoton BDT categorization\r## Introduction\rHadronic-only H→γγ top-associated categorization using ATLAS open data.\r## Data and Monte Carlo Samples\rOnly nominal ggH, VBF, WH, ZH, ggZH, ttH and tH MC and GamGam data were read; Sherpa/prompt continuum MC were excluded.\r## Object Definition and Event Selection\rTwo kinematic photons (pT>25 GeV, |η|<2.37) are required without photon tight-ID or isolation. Electrons/muons have pT>10 GeV; jets pT>25 GeV; b tags use quantile≥4. Hadronic is 0 leptons, ≥3 jets and ≥1 b tag.\r## Overview of the Analysis Strategy\rA deterministic five-variable BDT uses ttH+tH as signal and ggH plus NTI sideband data as background.\r## Signal and Control Regions\rTI means both photons tight-ID and tight-isolation; NTI is its complement. TI signal-window observed data are blinded.\r## Cut Flow\rSee `cutflow.json` and ![](plots/preselection_channels.png).\r## Distributions in Signal and Control Regions\r![](plots/preselection_mass.png) ![](plots/score_by_component_shape_bdt_v1.png)\r## Categorization\r![](categorization/plots/category_expected_yields_36fb_v1.png) ![](categorization/plots/category_mgg_control_shapes_36fb_v1.png)\r## Systematic Uncertainties\rThis starting point retains signed MC-weight bookkeeping; no nuisance systematic variations are fitted.\r## Statistical Interpretation\rROOT/PyROOT/RooFit workspace artifacts use the sideband-only, blinded Asimov strategy. Observed significance is blocked.\r![](fit/FIT1/plots/sidebands_background_fit.png) ![](fit/FIT1/plots/asimov_sb_fit.png)\r## Artifact Checklist\rMachine-readable selection, training, inference, categorization, histograms and workspace manifests are present.\r## Summary\rExpected 36 fb⁻¹ category yields use physical MC normalization and scaled NTI proxy, never class-balanced BDT weights.\r''')\rprint('DONE',len(df),len(had),OUT)\rPY\rpython3 run_analysis.py\r"]
