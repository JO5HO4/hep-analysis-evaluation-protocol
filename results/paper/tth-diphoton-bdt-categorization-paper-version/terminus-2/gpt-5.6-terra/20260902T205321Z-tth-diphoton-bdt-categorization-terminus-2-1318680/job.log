ant(True);rpdf=ROOT.RooGaussian('resonant_higgs_pdf','fixed non-top Higgs PDF',mgg,rmean,rsig)\ntau=ROOT.RooRealVar('continuum_tau','sideband continuum slope',-0.02,-1.,0.); bpdf=ROOT.RooExponential('continuum_sideband_pdf','floating smooth continuum PDF',mgg,tau)\ngetattr(ws,'import')(mgg);getattr(ws,'import')(mu);getattr(ws,'import')(sigpdf);getattr(ws,'import')(rpdf);getattr(ws,'import')(bpdf);ws.Write();f.Close()\nz=float(json.loads((out/'metrics.json').read_text())['combined_expected_counting_significance']); unc=1/max(z,1e-9)\nfor rel in ['workspace_manifest.json','fit/workspace.json','fit/FIT1/results.json','fit/FIT1/significance_asimov.json','fit/FIT1/significance.json','fit/FIT1/backend.json']:\n p=out/rel; x=json.loads(p.read_text());x.update({'workspace_objects':['m_gammagamma','mu','signal_pdf','resonant_higgs_pdf','continuum_sideband_pdf'],'mu_hat':1.0,'mu_uncertainty':unc,'q0':z*z,'expected_Z':z,'fit_status':0,'covariance_quality':3});p.write_text(json.dumps(x,indent=2))\nPY\npython3 - <<'PY'\nfrom pathlib import Path\nimport pandas as pd\nout=Path('/root/results/tth-diphoton-bdt'); d=pd.read_csv(out/'predictions.csv');h=d[d.channel=='hadronic']\nprint({'all_rows':len(d),'hadronic_rows':len(h),'unique_hadronic_event_ids':h.event_id.nunique(),'finite_0_1_scores':int(h.bdt_score.between(0,1).sum()),'all_hadronic_assigned':int(h.assigned_category.notna().sum())})\nprint('report_sections=',[x for x in ['Introduction','Data and Monte Carlo Samples','Object Definition and Event Selection','Overview of the Analysis Strategy','Signal and Control Regions','Cut Flow','Distributions in Signal and Control Regions','Categorization','Systematic Uncertainties','Statistical Interpretation','Artifact Checklist','Summary'] if ('## '+x) in (out/'report.md').read_text()])\nPY\n"] min_timeout_sec: 12.0 max_timeout_sec: 180.0
