[?2004l[?2004h>         c+=f
[?2004l[?2004h>         if h<c: return name
[?2004l[?2004h>     return "test"
[?2004l[?2004h> 
[?2004l[?2004h> def assign_top_category(event, score=None, thresholds=None):
[?2004l[?2004h>     """Apply BDT categories first, then lower-priority exactly-four-central-jet tH cuts."""
[?2004l[?2004h>     if not bool(_get(event,"passes_hadronic_preselection",True)): return "unassigned"
[?2004l[?2004h>     if int(_get(event,"n_leptons",0))!=0: return "unassigned"
[?2004l[?2004h>     s=float(score if score is not None else _get(event,"bdt_score",float("nan")))
[?2004l[?2004h>     th=list(thresholds or DEFAULT_THRESHOLDS)
[?2004l[?2004h>     while len(th)<4: th.append(0.0)
[?2004l[?2004h>     if math.isfinite(s):
[?2004l[?2004h>         for cat,t in zip(CATEGORY_ORDER[:4],th[:4]):
[?2004l[?2004h>             if s>=float(t): return cat
[?2004l[?2004h>     if int(_get(event,"n_central_jets",0))==4:
[?2004l[?2004h>         nb=int(_get(event,"n_bjets",0))
[?2004l[?2004h>         if nb==1: return "tH_had_4j1b"
[?2004l[?2004h>         if nb>=2: return "tH_had_4j2b"
[?2004l[?2004h>     return "unassigned"
[?2004l[?2004h> 
[?2004l[?2004h> def _z(s,b):
[?2004l[?2004h>     s=max(0.0,float(s)); b=max(1e-12,float(b))
[?2004l[?2004h>     return math.sqrt(max(0.0,2*((s+b)*math.log1p(s/b)-s)))
[?2004l[?2004h> 
[?2004l[?2004h> def optimize_bdt_boundaries(rows, config=None):
[?2004l[?2004h>     """Greedy boundary addition maximizing quadrature Asimov Z; accept only >=5% improvement.
[?2004l[?2004h> 
[?2004l[?2004h>     Rows may be records or a DataFrame and must provide score, signal/yield indicator and
[?2004l[?2004h>     physical (not class-balanced) significance weights. Deterministic candidate grid is used.
[?2004l[?2004h>     """
[?2004l[?2004h>     cfg={"min_relative_improvement":0.05,"max_categories":4,"min_background":0.8,"candidate_quantiles":np.linspace(.05,.95,37).tolist()}
[?2004l[?2004h>     if config: cfg.update(config)
[?2004l[?2004h>     def col(name,alts=()):
[?2004l[?2004h>         if hasattr(rows,"columns"):
[?2004l[?2004h>             for n in (name,)+alts:
[?2004l[?2004h>                 if n in rows.columns:return np.asarray(rows[n])
[?2004l[?2004h>         out=[]
[?2004l[?2004h>         for r in rows:
[?2004l[?2004h>             out.append(_get(r,name,next((_get(r,a,None) for a in alts if _get(r,a,None) is not None),None)))
[?2004l[?2004h>         return np.asarray(out)
[?2004l[?2004h>     score=col("bdt_score",("score",)).astype(float); sig=col("is_signal",("signal",)).astype(bool)
[?2004l[?2004h>     w=col("significance_model_weight_36fb",("yield_weight","weight")).astype(float)
[?2004l[?2004h>     ok=np.isfinite(score)&np.isfinite(w); score,sig,w=score[ok],sig[ok],w[ok]
[?2004l[?2004h>     cand=sorted(set(float(x) for x in np.quantile(score,cfg["candidate_quantiles"]))) if len(score) else []
[?2004l[?2004h>     bounds=[]
[?2004l[?2004h>     def total_z(bs):
[?2004l[?2004h>         edges=[-np.inf]+sorted(bs)+[np.inf]; z2=0.0
[?2004l[?2004h>         for lo,hi in zip(edges[:-1],edges[1:]):
[?2004l[?2004h>             m=(score>=lo)&(score<hi); s=w[m&sig].sum(); b=w[m&~sig].sum()
[?2004l[?2004h>             if b>=cfg["min_background"]: z2+=_z(s,b)**2
[?2004l[?2004h>         return math.sqrt(z2)
[?2004l[?2004h>     prev=total_z(bounds); accepted=[]
[?2004l[?2004h>     while len(bounds)<cfg["max_categories"]-1:
[?2004l[?2004h>         choices=[]
[?2004l[?2004h>         for x in cand:
[?2004l[?2004h>             if x in bounds: continue
[?2004l[?2004h>             z=total_z(bounds+[x]); choices.append((z,x))
[?2004l[?2004h>         if not choices: break
[?2004l[?2004h>         best,x=max(choices,key=lambda q:(q[0],q[1])); rel=(best-prev)/prev if prev>0 else (float("inf") if best>0 else 0)
[?2004l[?2004h>         if rel+1e-12<cfg["min_relative_improvement"]: break
[?2004l[?2004h>         bounds.append(x); bounds.sort(); accepted.append({"boundary":x,"expected_z":best,"previous_z":prev,"relative_improvement":rel})
[?2004l[?2004h>         prev=best
[?2004l[?2004h>     # category thresholds are descending; pad only for API assignment bookkeeping
[?2004l[?2004h>     return {"boundaries":sorted(bounds),"thresholds_descending":sorted(bounds,reverse=True)+[0.0],"accepted_splits":accepted,
[?2004l[?2004h>             "final_expected_z":prev,"stop_rule":"best additional relative improvement < 5%","config":cfg}
