[?2004l[?2004h> def stable_partition(event_id, seed=1729, fractions=(0.6,0.2,0.2)):
[?2004l[?2004h>     """Stable hash partition independent of input or row order."""
[?2004l[?2004h>     if not math.isclose(sum(fractions),1.0,rel_tol=0,abs_tol=1e-9): raise ValueError("fractions must sum to one")
[?2004l[?2004h>     h=int.from_bytes(hashlib.sha256(f"{seed}:{event_id}".encode()).digest()[:8],"big")/2**64
[?2004l[?2004h>     c=0.0
