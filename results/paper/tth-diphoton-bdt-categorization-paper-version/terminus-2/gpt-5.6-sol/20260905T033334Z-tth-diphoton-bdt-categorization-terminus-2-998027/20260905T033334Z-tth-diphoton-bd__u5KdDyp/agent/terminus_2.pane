[?2004l[?2004h>             "ht_jets":sum(float(_get(j,"pt")) for j in js),"leading_jet_pt":max([float(_get(j,"pt")) for j in js] or [0.0]),
[?2004l[?2004h>             "min_dr_gam_jet":mindr}
