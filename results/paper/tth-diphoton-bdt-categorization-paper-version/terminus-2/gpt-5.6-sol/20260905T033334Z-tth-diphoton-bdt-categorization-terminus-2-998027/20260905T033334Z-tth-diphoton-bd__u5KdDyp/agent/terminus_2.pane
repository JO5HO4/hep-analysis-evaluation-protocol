[?2004l[?2004h> BDT_FEATURES = ["n_jets", "n_bjets", "ht_jets", "leading_jet_pt", "min_dr_gam_jet"]
[?2004l[?2004h> CATEGORY_ORDER = ["ttH_had_BDT1", "ttH_had_BDT2", "ttH_had_BDT3", "ttH_had_BDT4", "tH_had_4j1b", "tH_had_4j2b"]
[?2004l[?2004h> DEFAULT_THRESHOLDS = [0.75, 0.50, 0.25, 0.0]
[?2004l[?2004h> 
[?2004l[?2004h> def _get(o, key, default=0.0):
[?2004l[?2004h>     return o.get(key, default) if isinstance(o, dict) else getattr(o, key, default)
[?2004l[?2004h> 
[?2004l[?2004h> def invariant_mass(objects):
[?2004l[?2004h>     """Invariant mass from objects having pt, eta, phi and either e or mass (consistent units)."""
[?2004l[?2004h>     E=px=py=pz=0.0
[?2004l[?2004h>     for o in objects:
[?2004l[?2004h>         pt=float(_get(o,"pt")); eta=float(_get(o,"eta")); phi=float(_get(o,"phi"))
[?2004l[?2004h>         mass=float(_get(o,"mass",_get(o,"m",0.0)))
[?2004l[?2004h>         en=float(_get(o,"e",math.sqrt(max(0.0,(pt*math.cosh(eta))**2+mass**2))))
[?2004l[?2004h>         E+=en; px+=pt*math.cos(phi); py+=pt*math.sin(phi); pz+=pt*math.sinh(eta)
[?2004l[?2004h>     return math.sqrt(max(0.0,E*E-px*px-py*py-pz*pz))
[?2004l[?2004h> 
[?2004l[?2004h> def build_jet_features(jets, photons=None, pt_min=25.0, central_eta=2.5, btag_quantile=4):
[?2004l[?2004h>     """Build the five BDT inputs and documented jet counts from selected pT>25 GeV jets."""
[?2004l[?2004h>     js=[j for j in jets if float(_get(j,"pt"))>pt_min]
[?2004l[?2004h>     central=[j for j in js if abs(float(_get(j,"eta")))<=central_eta]
[?2004l[?2004h>     forward=[j for j in js if abs(float(_get(j,"eta")))>central_eta]
[?2004l[?2004h>     b=[j for j in js if int(_get(j,"btag_quantile",_get(j,"btag",0)))>=btag_quantile]
[?2004l[?2004h>     mindr=9.0
[?2004l[?2004h>     for p in photons or []:
[?2004l[?2004h>         for j in js:
[?2004l[?2004h>             de=float(_get(p,"eta"))-float(_get(j,"eta")); dp=abs(float(_get(p,"phi"))-float(_get(j,"phi")); dp=min(dp,2*math.pi-dp)
[?2004l[?2004h>             mindr=min(mindr,math.hypot(de,dp))
