[193.451646, "o", " jets=a.jet_pt>25; nlep=ak.sum(a.lep_pt>10,axis=1); nj=ak.sum(jets,axis=1); nb=ak.sum(jets&(a.jet_btag_quantile>=4),axis=1); had=cand&(nlep==0)&(nj>=3)&(nb>=1)\r\n\u001b[?2004l\r"]
[193.451677, "o", "\u001b[?2004h> "]
[193.451995, "o", " sel=np.where(np.asarray(had))[0]; raw=int(len(sel));\r\n\u001b[?2004l\r"]
[193.452026, "o", "\u001b[?2004h> "]
[193.452139, "o", " if MAX: sel=sel[:MAX]\r\n\u001b[?2004l\r"]
[193.452166, "o", "\u001b[?2004h> "]
[193.452392, "o", " def arr(name): return np.asarray(a[name][sel])\r\n\u001b[?2004l\r"]
[193.452418, "o", "\u001b[?2004h> "]
[193.452729, "o", " ii=idx[sel,0]; jj=idx[sel,1]; row=ak.local_index(a.photon_pt[sel],axis=0)\r\n\u001b[?2004l\r"]
[193.452771, "o", "\u001b[?2004h> "]
[193.452991, "o", " def jag(name,ind): return np.asarray(a[name][sel][row,ind])\r\n\u001b[?2004l\r"]
[193.453018, "o", "\u001b[?2004h> "]
[193.453772, "o", " pt1,pt2=jag('photon_pt',ii),jag('photon_pt',jj); eta1,eta2=jag('photon_eta',ii),jag('photon_eta',jj); phi1,phi2=jag('photon_phi',ii),jag('photon_phi',jj); e1,e2=jag('photon_e',ii),jag('photon_e',jj)\r\n\u001b[?2004l\r"]
[193.453802, "o", "\u001b[?2004h> "]
[193.454556, "o", " m=np.sqrt(np.maximum(0,(e1+e2)**2-(pt1*np.cos(phi1)+pt2*np.cos(phi2))**2-(pt1*np.sin(phi1)+pt2*np.sin(phi2))**2-(pt1*np.sinh(eta1)+pt2*np.sinh(eta2))**2))\r\n\u001b[?2004l\r"]
[193.454586, "o", "\u001b[?2004h> "]
[193.455537, "o", " ti=jag('photon_isTightID',ii).astype(bool)&jag('photon_isTightIso',ii).astype(bool)&jag('photon_isTightID',jj).astype(bool)&jag('photon_isTightIso',jj).astype(bool)\r\n\u001b[?2004l\r"]
[193.455566, "o", "\u001b[?2004h> "]
[193.456375, "o", " jpt=a.jet_pt[sel][jets[sel]]; jeta=a.jet_eta[sel][jets[sel]]; jphi=a.jet_phi[sel][jets[sel]]; jb=a.jet_btag_quantile[sel][jets[sel]]\r\n\u001b[?2004l\r"]
[193.456404, "o", "\u001b[?2004h> "]
[193.456911, "o", " ncentral=np.asarray(ak.sum(abs(jeta)<=2.5,axis=1)); ht=np.asarray(ak.sum(jpt,axis=1)); lead=np.asarray(ak.max(jpt,axis=1))\r\n\u001b[?2004l\r"]
[193.456939, "o", "\u001b[?2004h> "]
[193.457162, "o", " # all photon-jet delta R combinations\r\n\u001b[?2004l\r"]
[193.45719, "o", "\u001b[?2004h> "]
[193.458417, "o", " dr1=np.sqrt((jeta-eta1[:,None])**2+np.minimum(abs(jphi-phi1[:,None]),2*np.pi-abs(jphi-phi1[:,None]))**2); dr2=np.sqrt((jeta-eta2[:,None])**2+np.minimum(abs(jphi-phi2[:,None]),2*np.pi-abs(jphi-phi2[:,None]))**2); mindr=np.asarray(ak.min(ak.concatenate([dr1,dr2],axis=1),axis=1))\r\n\u001b[?2004l\r"]
[193.458448, "o", "\u001b[?2004h> "]
[193.458802, "o", " eid=[f'{int(r)}:{int(e)}:{sample}' for r,e in zip(arr('runNumber'),arr('eventNumber'))]\r\n\u001b[?2004l\r"]
[193.458833, "o", "\u001b[?2004h> "]
[193.459218, "o", " if sample=='data': phys=np.zeros(len(sel)); obs=np.ones(len(sel))\r\n\u001b[?2004l\r"]
[193.459248, "o", "\u001b[?2004h> "]
[193.459283, "o", " else:\r\n\u001b[?2004l\r"]
[193.459313, "o", "\u001b[?2004h> "]
[193.459882, "o", "  sf=arr('ScaleFactor_PILEUP')*arr('ScaleFactor_PHOTON')*arr('ScaleFactor_BTAG')*arr('ScaleFactor_JVT'); sf=np.where(np.isfinite(sf),sf,1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[193.459912, "o", "> "]
[193.460353, "o", "  phys=LUMI*arr('xsec')*arr('kfac')*arr('filteff')*arr('mcWeight')*sf/arr('sum_of_weights'); obs=np.zeros(len(sel))\r\n\u001b[?2004l\r\u001b[?2004h"]
[193.460393, "o", "> "]
[193.462664, "o", " df=pd.DataFrame({'event_id':eid,'run_number':arr('runNumber'),'event_number':arr('eventNumber'),'sample':sample,'process':sample,'is_data':sample=='data','is_signal':sample in ['ttH','tH'],'m_gammagamma':m,'diphoton_ti':ti,'diphoton_nti':~ti,'photon1_pt':pt1,'photon2_pt':pt2,'n_leptons':np.asarray(nlep[sel]),'n_jets':np.asarray(nj[sel]),'n_central_jets':ncentral,'n_forward_jets':np.asarray(nj[sel])-ncentral,'n_bjets':np.asarray(nb[sel]),'ht_jets':ht,'leading_jet_pt':lead,'min_dr_gam_jet':mindr,'passes_hadronic_preselection':True,'preselection_channel':'hadronic','sm_mc_weight_36fb':phys,'event_weight':phys,'observed_data_weight':obs})\r\n\u001b[?2004l\r"]
[193.462704, "o", "\u001b[?2004h> "]
[193.463008, "o", " df['partition']=[stable_partition(x) for x in eid]; return df,raw,str(f)\r\n\u001b[?2004l\r"]
[193.463039, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[193.463074, "o", "> "]
[193.463325, "o", "start=time.time(); frames=[]; raw={}; files=[]\r\n\u001b[?2004l\r"]
[193.463354, "o", "\u001b[?2004h> "]
[193.463444, "o", "for s in SAMPLES:\r\n\u001b[?2004l\r"]
[193.463473, "o", "\u001b[?2004h> "]
[193.464058, "o", " d,n,f=read_sample(s); frames.append(d);raw[s]=n;files.append(f);print(s,len(d),'of',n,flush=True)\r\n\u001b[?2004l\r"]
[193.464084, "o", "\u001b[?2004h> "]
[193.464697, "o", "df=pd.concat(frames,ignore_index=True); side=((df.m_gammagamma>=105)&(df.m_gammagamma<120))|((df.m_gammagamma>130)&(df.m_gammagamma<=160)); win=abs(df.m_gammagamma-125)<=2\r\n\u001b[?2004l\r"]
[193.464724, "o", "\u001b[?2004h> "]
[193.464934, "o", "data=df.is_data; nti=df.diphoton_nti; ti=df.diphoton_ti\r\n\u001b[?2004l\r"]
[193.46496, "o", "\u001b[?2004h> "]
[193.465554, "o", "TI_sb=float((data&ti&side).sum()); NTI_sb=float((data&nti&side).sum()); NTI_win=float((data&nti&win).sum()); SF1=TI_sb/NTI_sb; SF2=NTI_win/NTI_sb; SF=SF1*SF2\r\n\u001b[?2004l\r"]
[193.465584, "o", "\u001b[?2004h> "]
[193.466539, "o", "df['nti_continuum_proxy_weight']=np.where(data&nti&side,SF,0.0); df['significance_model_weight_36fb']=df.sm_mc_weight_36fb+df.nti_continuum_proxy_weight\r\n\u001b[?2004l\r"]
[193.466572, "o", "\u001b[?2004h> "]
[193.467217, "o", "# Training: top TI window, ggH TI window, and data NTI sidebands. Signed physical weights remain explicit; nonnegative magnitudes are needed by sklearn.\r\n\u001b[?2004l\r"]
[193.467247, "o", "\u001b[?2004h> "]
[193.4683, "o", "role=np.full(len(df),'not_training',object); role[(~data)&df.is_signal&ti&win]='signal_top_higgs'; role[(df['sample']=='ggH')&ti&win]='background_resonant_ggH'; role[data&nti&side]='background_nti_sideband'\r\n\u001b[?2004l\r"]
[193.468327, "o", "\u001b[?2004h> "]
[193.4689, "o", "df['training_role']=role; tr=df[(df.partition=='train')&(df.training_role!='not_training')].copy(); tr['target']=(tr.training_role=='signal_top_higgs').astype(int)\r\n\u001b[?2004l\r"]
[193.468927, "o", "\u001b[?2004h> "]
[193.469631, "o", "base=np.where(tr.target==1,np.abs(tr.sm_mc_weight_36fb),np.where(tr.training_role=='background_resonant_ggH',np.abs(tr.sm_mc_weight_36fb),tr.nti_continuum_proxy_weight)); tr['mixture_weight']=base\r\n\u001b[?2004l\r"]
[193.46968, "o", "\u001b[?2004h> "]
[193.470776, "o", "pre={str(k):float(base[tr.target.values==k].sum()) for k in [0,1]}; factors={k:(0.5/pre[str(k)] if pre[str(k)]>0 else 0) for k in [0,1]}; tr['bdt_fit_weight']=[base[i]*factors[int(y)] for i,y in enumerate(tr.target)]; post={str(k):float(tr.loc[tr.target==k,'bdt_fit_weight'].sum()) for k in [0,1]}\r\n\u001b[?2004l\r"]
[193.470808, "o", "\u001b[?2004h> "]
[193.471936, "o", "t0=time.time(); model=HistGradientBoostingClassifier(max_iter=180,learning_rate=.055,max_leaf_nodes=15,l2_regularization=1.0,random_state=1729).fit(tr[BDT_FEATURES],tr.target,sample_weight=tr.bdt_fit_weight); train_seconds=time.time()-t0; joblib.dump(model,OUT/'model/bdt_model.joblib')\r\n\u001b[?2004l\r"]
[193.471966, "o", "\u001b[?2004h> "]
[193.47248, "o", "df['bdt_score']=model.predict_proba(df[BDT_FEATURES])[:,1]; tr['bdt_score']=model.predict_proba(tr[BDT_FEATURES])[:,1]\r\n\u001b[?2004l\r"]
[193.472508, "o", "\u001b[?2004h> "]
[193.472816, "o", "# Optimize on validation physical model rows only, never nominal TI data window.\r\n\u001b[?2004l\r"]
[193.472841, "o", "\u001b[?2004h> "]
[193.473552, "o", "optrows=df[(df.partition=='validation')&(((~data)&ti&win)|(data&nti&side))].copy(); opt=optimize_bdt_boundaries(optrows,{'max_categories':4,'min_background':0.8}); bounds=sorted(opt['boundaries'],reverse=True)\r\n\u001b[?2004l\r"]
[193.473578, "o", "\u001b[?2004h> "]
[193.474051, "o", "# Four reported BDT labels; only optimized regions are kept. Missing labels are empty/not kept. Lowest accepted edge defines failure region for tH cuts.\r\n\u001b[?2004l\r"]
[193.474124, "o", "\u001b[?2004h> "]
[193.474193, "o", "thresholds=bounds[:]; cats=[]\r\n\u001b[?2004l\r"]
