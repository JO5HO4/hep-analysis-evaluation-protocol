[42.510306, "o", "\u001b[?2004hroot@nid004390:~# "]
[62.276322, "i", "python3 - <<'PY'\nimport uproot, awkward as ak, numpy as np, glob, os\nfiles=sorted(glob.glob('/data/GamGam/*/*.root'))\nneed=['eventNumber','runNumber','num_events','sum_of_weights','xsec','kfac','filteff','mcWeight','photon_n','photon_pt','photon_eta','photon_phi','photon_e','photon_isTightID','photon_isTightIso','lep_pt','lep_type','jet_pt','jet_eta','jet_phi','jet_e','jet_btag_quantile','passes_hadronic_preselection','passes_leptonic_preselection']\nfor f in files:\n t=uproot.open(f)['analysis']; a=t.arrays(need,entry_stop=min(20000,t.num_entries),library='ak')\n print('\\n',os.path.basename(f),'entries',t.num_entries)\n for k in ['num_events','sum_of_weights','xsec','kfac','filteff']:\n  z=ak.to_numpy(a[k]); print(k, np.unique(z[:100])[:8])\n print('mcWeight range',float(ak.min(a.mcWeight)),float(ak.max(a.mcWeight)))\n print('photon_n',dict(zip(*np.unique(ak.to_numpy(a.photon_n),return_counts=True))))\n print('pt first',ak.to_list(a.photon_pt[:2]),'eta first',ak.to_list(a.photon_eta[:2]))\n pkin=(a.photon_pt>25000)&(abs(a.photon_eta)<2.37)&~((abs(a.photon_eta)>1.37)&(abs(a.photon_eta)<1.52))\n nti=ak.sum(pkin,axis=1)>=2\n had=(ak.sum(a.lep_pt>10000,axis=1)==0)&(ak.sum(a.jet_pt>25000,axis=1)>=3)&(ak.sum((a.jet_pt>25000)&(a.jet_btag_quantile>=4),axis=1)>=1)&nti\n print('recomputed basic had',int(ak.sum(had)),'stored had',int(ak.sum(a.passes_hadronic_preselection)),'stored lep',int(ak.sum(a.passes_leptonic_preselection)))\nPY\n"]
[62.276692, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[62.276749, "o", "\u001b[?2004h> "]
