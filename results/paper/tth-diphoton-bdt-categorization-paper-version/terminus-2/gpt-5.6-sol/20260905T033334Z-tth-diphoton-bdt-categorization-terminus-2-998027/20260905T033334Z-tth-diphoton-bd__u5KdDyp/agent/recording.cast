[72.296502, "i", "python3 - <<'PY'\nimport uproot, awkward as ak, numpy as np\nf='/data/GamGam/data/data_preselection.root'; t=uproot.open(f)['analysis']\na=t.arrays(['eventNumber','runNumber','photon_pt','photon_eta','photon_phi','photon_e','photon_isTightID','photon_isTightIso'],entry_stop=100000,library='ak')\n# two leading kinematic photons and vector mass, diagnostic only\nm=[]; ti=[]\nfor pt,eta,phi,e,tight,iso in zip(*[a[x] for x in ['photon_pt','photon_eta','photon_phi','photon_e','photon_isTightID','photon_isTightIso']]):\n idx=[i for i in range(len(pt)) if pt[i]>25000 and abs(eta[i])<2.37 and not (1.37<abs(eta[i])<1.52)]\n if len(idx)<2: continue\n i,j=idx[:2]; px=pt[i]*np.cos(phi[i])+pt[j]*np.cos(phi[j]); py=pt[i]*np.sin(phi[i])+pt[j]*np.sin(phi[j]); pz=pt[i]*np.sinh(eta[i])+pt[j]*np.sinh(eta[j]); E=e[i]+e[j]\n m.append(np.sqrt(max(0,E*E-px*px-py*py-pz*pz))/1000); ti.append(bool(tight[i] and iso[i] and tight[j] and iso[j]))\nm=np.array(m);ti=np.array(ti)\nprint('candidate count',len(m),'mass quantiles',np.quantile(m,[0,.01,.5,.99,1]))\nfor label,mask in [('TI',ti),('NTI',~ti)]:\n print(label,'all',mask.sum(),'sidebands',np.sum(mask&(((m>=105)&(m<120))|((m>130)&(m<=160)))),'window',np.sum(mask&(abs(m-125)<=2)))\nPY\n"]
