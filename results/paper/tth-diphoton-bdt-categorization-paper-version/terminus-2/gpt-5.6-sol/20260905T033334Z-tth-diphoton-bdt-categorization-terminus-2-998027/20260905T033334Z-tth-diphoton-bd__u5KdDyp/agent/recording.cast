[116.892755, "i", "python3 - <<'PY'\nimport uproot, awkward as ak, numpy as np\nfor f in ['/data/GamGam/MC/ttH_preselection.root','/data/GamGam/data/data_preselection.root']:\n t=uproot.open(f)['analysis']; keys=[k for k in t.keys() if k.startswith('ScaleFactor_')]+['mcWeight','xsec','filteff','kfac','sum_of_weights']\n a=t.arrays(keys,entry_stop=10000,library='np')\n print('\\n',f)\n for k,v in a.items():\n  try: print(k, v.dtype, 'finite',np.isfinite(v).mean(),'min/max/mean',np.nanmin(v),np.nanmax(v),np.nanmean(v))\n  except Exception as e: print(k,e)\nPY\n"]
