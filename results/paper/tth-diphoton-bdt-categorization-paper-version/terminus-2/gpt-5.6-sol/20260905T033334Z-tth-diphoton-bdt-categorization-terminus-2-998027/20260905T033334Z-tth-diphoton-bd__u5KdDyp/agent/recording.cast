[323.71098, "o", "rows=[]; comp={}; z2=0\r\n\u001b[?2004l\r"]
[323.711009, "o", "\u001b[?2004h> "]
[323.71109, "o", "for c in ALL:\r\n\u001b[?2004l\r"]
[323.711119, "o", "\u001b[?2004h> "]
[323.712684, "o", " m=p.assigned_category.eq(c); s=float(p.loc[m&signal,'significance_model_weight_36fb'].sum()); r=float(p.loc[m&reson,'significance_model_weight_36fb'].sum()); n=float(p.loc[m&cont,'nti_continuum_proxy_weight'].sum()); b=r+n; z=az(max(s,0),max(b,1e-12)); z2+=z*z if c!='unassigned' else 0\r\n\u001b[?2004l\r"]
[323.712712, "o", "\u001b[?2004h> "]
