[94.616602, "o", "  File \u001b[35m\"<stdin>\"\u001b[0m, line \u001b[35m12\u001b[0m, in \u001b[35m<module>\u001b[0m\r\n  File \u001b[35m\"/usr/lib/python3/dist-packages/numpy/lib/_function_base_impl.py\"\u001b[0m, line \u001b[35m4537\u001b[0m, in \u001b[35mquantile\u001b[0m\r\n    return _quantile_unchecked(\r\n        a, q, axis, out, overwrite_input, method, keepdims, weights)\r\n  File \u001b[35m\"/usr/lib/python3/dist-packages/numpy/lib/_function_base_impl.py\"\u001b[0m, line \u001b[35m4550\u001b[0m, in \u001b[35m_quantile_unchecked\u001b[0m\r\n    return _ureduce(a,\r\n                    func=_quantile_ureduce_func,\r\n    ...<5 lines>...\r\n                    overwrite_input=overwrite_input,\r\n                    method=method)\r\n  File \u001b[35m\"/usr/lib/python3/dist-packages/numpy/lib/_function_base_impl.py\"\u001b[0m, line \u001b[35m3894\u001b[0m, in \u001b[35m_ureduce\u001b[0m\r\n    r = func(a, **kwargs)\r\n  File \u001b[35m\"/usr/lib/python3/dist-packages/numpy/lib/_function_base_impl.py\"\u001b[0m, line \u001b[35m4727\u001b[0m, in \u001b[35m_quantile_ureduce_func\u001b[0m\r\n    result = _quantile(arr,\r\n                       quantiles=q,\r\n    ...<2 lines>...\r\n                       out=out,\r\n                       weights=wgt)\r\n  File \u001b[35m\"/usr/lib/python3/dist-packages/numpy/lib/_function_base_impl.py\"\u001b[0m, line \u001b[35m4849\u001b[0m, in \u001b[35m_quantile\u001b[0m\r\n    slices_having_nans = np.isnan(\u001b[31marr\u001b[0m\u001b[1;31m[-1, ...]\u001b[0m)\r\n                                  \u001b[31m~~~\u001b[0m\u001b[1;31m^^^^^^^^^\u001b[0m\r\n"]
