[323.707024, "o", "\u001b[?2004h> "]
[323.707524, "o", " h=np.histogram(x,bins=e,weights=w)[0];h2=np.histogram(x,bins=e,weights=np.asarray(w)**2)[0]\r\n\u001b[?2004l\r"]
[323.707553, "o", "\u001b[?2004h> "]
[323.708453, "o", " return {'bin_edges':list(map(float,e)),'bin_contents':list(map(float,h)),'sumw2':list(map(float,h2)),'component_total_before_shape_normalization':float(np.sum(w))}\r\n\u001b[?2004l\r"]
[323.708482, "o", "\u001b[?2004h> "]
[323.709176, "o", "side=((p.m_gammagamma>=105)&(p.m_gammagamma<120))|((p.m_gammagamma>130)&(p.m_gammagamma<=160));win=abs(p.m_gammagamma-125)<=2\r\n\u001b[?2004l\r"]
[323.709205, "o", "\u001b[?2004h> "]
[323.709678, "o", "ti=p.diphoton_ti.astype(bool);nti=p.diphoton_nti.astype(bool);data=p.is_data.astype(bool);sig=p.is_signal.astype(bool)\r\n\u001b[?2004l\r"]
[323.709707, "o", "\u001b[?2004h> "]
