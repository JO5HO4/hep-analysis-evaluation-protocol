),p.bdt_score.max(),p.assigned_category.value_counts().to_dict())\nf=ROOT.TFile.Open(str((O/'fit/FIT1/workspace.root').resolve()));w=f.Get('combined_hadronic');assert w and w.var('mu');print('works"]
