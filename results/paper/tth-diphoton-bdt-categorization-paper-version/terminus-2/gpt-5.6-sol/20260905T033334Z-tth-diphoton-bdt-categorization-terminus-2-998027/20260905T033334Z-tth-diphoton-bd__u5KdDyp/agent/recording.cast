[151.17891, "o", "> "]
[151.179144, "o", "def stable_partition(event_id, seed=1729, fractions=(0.6,0.2,0.2)):\r\n\u001b[?2004l\r"]
[151.179192, "o", "\u001b[?2004h> "]
[151.179408, "o", "    \"\"\"Stable hash partition independent of input or row order.\"\"\"\r\n\u001b[?2004l\r"]
[151.179435, "o", "\u001b[?2004h> "]
[151.179837, "o", "    if not math.isclose(sum(fractions),1.0,rel_tol=0,abs_tol=1e-9): raise ValueError(\"fractions must sum to one\")\r\n\u001b[?2004l\r"]
[151.179866, "o", "\u001b[?2004h> "]
[151.180191, "o", "    h=int.from_bytes(hashlib.sha256(f\"{seed}:{event_id}\".encode()).digest()[:8],\"big\")/2**64\r\n\u001b[?2004l\r"]
[151.18022, "o", "\u001b[?2004h> "]
[151.180263, "o", "    c=0.0\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.180295, "o", "> "]
[151.180515, "o", "    for name,f in zip((\"train\",\"validation\",\"test\"),fractions):\r\n\u001b[?2004l\r"]
[151.180542, "o", "\u001b[?2004h> "]
[151.180584, "o", "        c+=f\r\n\u001b[?2004l\r"]
[151.180612, "o", "\u001b[?2004h> "]
[151.180704, "o", "        if h<c: return name\r\n\u001b[?2004l\r"]
[151.180749, "o", "\u001b[?2004h> "]
[151.180789, "o", "    return \"test\"\r\n\u001b[?2004l\r"]
[151.18083, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[151.180855, "o", "> "]
[151.18104, "o", "def assign_top_category(event, score=None, thresholds=None):\r\n\u001b[?2004l\r"]
[151.181089, "o", "\u001b[?2004h> "]
[151.181356, "o", "    \"\"\"Apply BDT categories first, then lower-priority exactly-four-central-jet tH cuts.\"\"\"\r\n\u001b[?2004l\r"]
[151.181396, "o", "\u001b[?2004h> "]
[151.181647, "o", "    if not bool(_get(event,\"passes_hadronic_preselection\",True)): return \"unassigned\"\r\n\u001b[?2004l\r"]
[151.181673, "o", "\u001b[?2004h> "]
[151.181871, "o", "    if int(_get(event,\"n_leptons\",0))!=0: return \"unassigned\"\r\n\u001b[?2004l\r"]
[151.181895, "o", "\u001b[?2004h> "]
[151.182164, "o", "    s=float(score if score is not None else _get(event,\"bdt_score\",float(\"nan\")))\r\n\u001b[?2004l\r"]
[151.18219, "o", "\u001b[?2004h> "]
[151.182341, "o", "    th=list(thresholds or DEFAULT_THRESHOLDS)\r\n\u001b[?2004l\r"]
[151.18237, "o", "\u001b[?2004h> "]
[151.182504, "o", "    while len(th)<4: th.append(0.0)\r\n\u001b[?2004l\r"]
[151.182533, "o", "\u001b[?2004h> "]
[151.182624, "o", "    if math.isfinite(s):\r\n\u001b[?2004l\r"]
[151.182676, "o", "\u001b[?2004h> "]
[151.182838, "o", "        for cat,t in zip(CATEGORY_ORDER[:4],th[:4]):\r\n\u001b[?2004l\r"]
[151.182882, "o", "\u001b[?2004h> "]
[151.183013, "o", "            if s>=float(t): return cat\r\n\u001b[?2004l\r"]
[151.18304, "o", "\u001b[?2004h> "]
[151.183204, "o", "    if int(_get(event,\"n_central_jets\",0))==4:\r\n\u001b[?2004l\r"]
[151.183249, "o", "\u001b[?2004h> "]
[151.183376, "o", "        nb=int(_get(event,\"n_bjets\",0))\r\n\u001b[?2004l\r"]
[151.18342, "o", "\u001b[?2004h> "]
[151.183545, "o", "        if nb==1: return \"tH_had_4j1b\"\r\n\u001b[?2004l\r"]
[151.183573, "o", "\u001b[?2004h> "]
[151.18372, "o", "        if nb>=2: return \"tH_had_4j2b\"\r\n\u001b[?2004l\r"]
[151.183765, "o", "\u001b[?2004h> "]
[151.183836, "o", "    return \"unassigned\"\r\n\u001b[?2004l\r"]
[151.183864, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[151.183897, "o", "\u001b[?2004h> "]
[151.18396, "o", "def _z(s,b):\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.18399, "o", "> "]
[151.184157, "o", "    s=max(0.0,float(s)); b=max(1e-12,float(b))\r\n\u001b[?2004l\r"]
[151.184188, "o", "\u001b[?2004h> "]
[151.184395, "o", "    return math.sqrt(max(0.0,2*((s+b)*math.log1p(s/b)-s)))\r\n\u001b[?2004l\r"]
[151.184425, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[151.184456, "o", "\u001b[?2004h> "]
[151.184622, "o", "def optimize_bdt_boundaries(rows, config=None):\r\n\u001b[?2004l\r"]
[151.184648, "o", "\u001b[?2004h> "]
[151.184958, "o", "    \"\"\"Greedy boundary addition maximizing quadrature Asimov Z; accept only >=5% improvement.\r\n\u001b[?2004l\r"]
[151.184986, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[151.18502, "o", "\u001b[?2004h> "]
[151.185338, "o", "    Rows may be records or a DataFrame and must provide score, signal/yield indicator and\r\n\u001b[?2004l\r"]
[151.185367, "o", "\u001b[?2004h> "]
[151.185697, "o", "    physical (not class-balanced) significance weights. Deterministic candidate grid is used.\r\n\u001b[?2004l\r"]
[151.185726, "o", "\u001b[?2004h> "]
[151.185759, "o", "    \"\"\"\r\n\u001b[?2004l\r"]
[151.185788, "o", "\u001b[?2004h> "]
[151.186279, "o", "    cfg={\"min_relative_improvement\":0.05,\"max_categories\":4,\"min_background\":0.8,\"candidate_quantiles\":np.linspace(.05,.95,37).tolist()}\r\n\u001b[?2004l\r"]
[151.186308, "o", "\u001b[?2004h> "]
[151.186422, "o", "    if config: cfg.update(config)\r\n\u001b[?2004l\r"]
[151.186453, "o", "\u001b[?2004h> "]
[151.186552, "o", "    def col(name,alts=()):\r\n\u001b[?2004l\r"]
[151.186597, "o", "\u001b[?2004h> "]
[151.186711, "o", "        if hasattr(rows,\"columns\"):\r\n\u001b[?2004l\r"]
[151.186739, "o", "\u001b[?2004h> "]
[151.186865, "o", "            for n in (name,)+alts:\r\n\u001b[?2004l\r"]
[151.18691, "o", "\u001b[?2004h> "]
[151.187119, "o", "                if n in rows.columns:return np.asarray(rows[n])\r\n\u001b[?2004l\r"]
[151.187148, "o", "\u001b[?2004h> "]
[151.187207, "o", "        out=[]\r\n\u001b[?2004l\r"]
[151.187236, "o", "\u001b[?2004h> "]
[151.187321, "o", "        for r in rows:\r\n\u001b[?2004l\r"]
[151.187366, "o", "\u001b[?2004h> "]
[151.187728, "o", "            out.append(_get(r,name,next((_get(r,a,None) for a in alts if _get(r,a,None) is not None),None)))\r\n\u001b[?2004l\r"]
[151.187757, "o", "\u001b[?2004h> "]
[151.187881, "o", "        return np.asarray(out)\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.18791, "o", "> "]
[151.188244, "o", "    score=col(\"bdt_score\",(\"score\",)).astype(float); sig=col(\"is_signal\",(\"signal\",)).astype(bool)\r\n\u001b[?2004l\r"]
[151.188289, "o", "\u001b[?2004h> "]
[151.188566, "o", "    w=col(\"significance_model_weight_36fb\",(\"yield_weight\",\"weight\")).astype(float)\r\n\u001b[?2004l\r"]
[151.188611, "o", "\u001b[?2004h> "]
[151.188874, "o", "    ok=np.isfinite(score)&np.isfinite(w); score,sig,w=score[ok],sig[ok],w[ok]\r\n\u001b[?2004l\r"]
[151.188903, "o", "\u001b[?2004h> "]
[151.189273, "o", "    cand=sorted(set(float(x) for x in np.quantile(score,cfg[\"candidate_quantiles\"]))) if len(score) else []\r\n\u001b[?2004l\r"]
[151.189303, "o", "\u001b[?2004h> "]
[151.189371, "o", "    bounds=[]\r\n\u001b[?2004l\r\u001b[?2004h"]
[151.189416, "o", "> "]
[151.189464, "o", "    def total_z(bs):\r\n\u001b[?2004l\r"]
[151.189493, "o", "\u001b[?2004h> "]
[151.18968, "o", "        edges=[-np.inf]+sorted(bs)+[np.inf]; z2=0.0\r\n\u001b[?2004l\r"]
[151.189718, "o", "\u001b[?2004h> "]
[151.189882, "o", "        for lo,hi in zip(edges[:-1],edges[1:]):\r\n\u001b[?2004l\r"]
[151.189911, "o", "\u001b[?2004h> "]
[151.190182, "o", "            m=(score>=lo)&(score<hi); s=w[m&sig].sum(); b=w[m&~sig].sum()\r\n\u001b[?2004l\r"]
[151.190213, "o", "\u001b[?2004h> "]
[151.190408, "o", "            if b>=cfg[\"min_background\"]: z2+=_z(s,b)**2\r\n\u001b[?2004l\r"]
[151.19044, "o", "\u001b[?2004h> "]
[151.190545, "o", "        return math.sqrt(z2)\r\n\u001b[?2004l\r"]
[151.190574, "o", "\u001b[?2004h> "]
[151.190707, "o", "    prev=total_z(bounds); accepted=[]\r\n\u001b[?2004l\r"]
[151.190735, "o", "\u001b[?2004h> "]
[151.190906, "o", "    while len(bounds)<cfg[\"max_categories\"]-1:\r\n\u001b[?2004l\r"]
[151.190935, "o", "\u001b[?2004h> "]
[151.191005, "o", "        choices=[]\r\n\u001b[?2004l\r"]
[151.191034, "o", "\u001b[?2004h> "]
[151.191119, "o", "        for x in cand:\r\n\u001b[?2004l\r"]
[151.191163, "o", "\u001b[?2004h> "]
[151.19128, "o", "            if x in bounds: continue\r\n\u001b[?2004l\r"]
[151.191309, "o", "\u001b[?2004h> "]
[151.191511, "o", "            z=total_z(bounds+[x]); choices.append((z,x))\r\n\u001b[?2004l\r"]
[151.191555, "o", "\u001b[?2004h> "]
[151.19165, "o", "        if not choices: break\r\n\u001b[?2004l\r"]
[151.19168, "o", "\u001b[?2004h> "]
[151.192101, "o", "        best,x=max(choices,key=lambda q:(q[0],q[1])); rel=(best-prev)/prev if prev>0 else (float(\"inf\") if best>0 else 0)\r\n\u001b[?2004l\r"]
[151.192131, "o", "\u001b[?2004h> "]
[151.192342, "o", "        if rel+1e-12<cfg[\"min_relative_improvement\"]: break\r\n\u001b[?2004l\r"]
[151.19237, "o", "\u001b[?2004h> "]
[151.192847, "o", "        bounds.append(x); bounds.sort(); accepted.append({\"boundary\":x,\"expected_z\":best,\"previous_z\":prev,\"relative_improvement\":rel})\r\n\u001b[?2004l\r"]
[151.192876, "o", "\u001b[?2004h> "]
[151.192943, "o", "        prev=best\r\n\u001b[?2004l\r"]
[151.192973, "o", "\u001b[?2004h> "]
[151.193259, "o", "    # category thresholds are descending; pad only for API assignment bookkeeping\r\n\u001b[?2004l\r"]
[151.193303, "o", "\u001b[?2004h> "]
[151.193725, "o", "    return {\"boundaries\":sorted(bounds),\"thresholds_descending\":sorted(bounds,reverse=True)+[0.0],\"accepted_splits\":accepted,\r\n\u001b[?2004l\r"]
[151.193754, "o", "\u001b[?2004h> "]
[151.194135, "o", "            \"final_expected_z\":prev,\"stop_rule\":\"best additional relative improvement < 5%\",\"config\":cfg}\r\n\u001b[?2004l\r"]
[151.194166, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[151.206528, "o", "\u001b[?2004h"]
[151.206564, "o", "root@nid004390:~# "]
[151.206761, "o", "cd /root/submission/tth-diphoton-bdt && python3 - <<'PY'\r\n\u001b[?2004l\r"]
[151.206796, "o", "\u001b[?2004h> "]
[151.206952, "o", "from analysis.top_categorization import *\r\n\u001b[?2004l\r"]
[151.206987, "o", "\u001b[?2004h> "]
[151.207538, "o", "print(BDT_FEATURES, CATEGORY_ORDER, stable_partition('1:2:x'), invariant_mass([{'pt':50,'eta':0,'phi':0,'e':50},{'pt':50,'eta':0,'phi':3.1415926535,'e':50}])) \r\u001bM\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[K)\r\n\u001b[?2004l\r"]
[151.207565, "o", "\u001b[?2004h> "]
[151.207598, "o", "PY\r\n\u001b[?2004l\r"]
[151.232518, "o", "Traceback (most recent call last):\r\n  File \u001b[35m\"<stdin>\"\u001b[0m, line \u001b[35m1\u001b[0m, in \u001b[35m<module>\u001b[0m\r\n  File \u001b[35m\"/root/submission/tth-diphoton-bdt/analysis/top_categorization.py\"\u001b[0m, line \u001b[35m32\u001b[0m\r\n    de=float(_get(p,\"eta\"))-float(_get(j,\"eta\")); dp=abs(float(_get(p,\"phi\"))-float(_get(j,\"phi\"))\u001b[1;31m;\u001b[0m dp=min(dp,2*math.pi-dp)\r\n"]
[151.232618, "o", "                                                                                                  \u001b[1;31m^\u001b[0m\r\n\u001b[1;35mSyntaxError\u001b[0m: \u001b[35minvalid syntax\u001b[0m\r\n"]
[151.235933, "o", "\u001b[?2004hroot@nid004390:~/submission/tth-diphoton-bdt# "]
[191.9213, "i", "cd /root/submission/tth-diphoton-bdt && python3 - <<'PY'\np='analysis/top_categorization.py'\ns=open(p).read().replace('dp=abs(float(_get(p,\"phi\"))-float(_get(j,\"phi\"));','dp=abs(float(_get(p,\"phi\"))-float(_get(j,\"phi\"))) ;')\nopen(p,'w').write(s)\nPY\npython3 -m py_compile analysis/top_categorization.py && python3 - <<'PY'\nfrom analysis.top_categorization import *\nprint(BDT_FEATURES, CATEGORY_ORDER, stable_partition('1:2:x'))\nprint(invariant_mass([{'pt':50,'eta':0,'phi':0,'e':50},{'pt':50,'eta':0,'phi':3.1415926535,'e':50}]))\nPY\n"]
[191.921916, "o", "cd /root/submission/tth-diphoton-bdt && python3 - <<'PY'\r\n\u001b[?2004l\r"]
