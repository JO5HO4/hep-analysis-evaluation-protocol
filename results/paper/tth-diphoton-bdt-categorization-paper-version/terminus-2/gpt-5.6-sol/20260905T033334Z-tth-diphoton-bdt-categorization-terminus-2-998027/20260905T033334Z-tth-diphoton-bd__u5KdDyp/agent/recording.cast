[193.474337, "o", "\u001b[?2004h> "]
[193.474455, "o", " s=r.bdt_score; c='unassigned'\r\n\u001b[?2004l\r"]
[193.474488, "o", "\u001b[?2004h> "]
[193.474622, "o", " for i,t in enumerate(thresholds[:4]):\r\n\u001b[?2004l\r"]
[193.47465, "o", "\u001b[?2004h> "]
[193.474788, "o", "  if s>=t: c=CATEGORY_ORDER[i]; break\r\n\u001b[?2004l\r"]
[193.474818, "o", "\u001b[?2004h> "]
[193.475237, "o", " if c=='unassigned' and r.n_central_jets==4: c='tH_had_4j1b' if r.n_bjets==1 else ('tH_had_4j2b' if r.n_bjets>=2 else c)\r\n\u001b[?2004l\r"]
[193.475269, "o", "\u001b[?2004h> "]
[193.475327, "o", " cats.append(c)\r\n\u001b[?2004l\r"]
[193.475355, "o", "\u001b[?2004h> "]
