[193.476745, "o", " b=float(df.loc[(df.assigned_category==c)&bkgmask,'significance_model_weight_36fb'].sum()); keep=b>=.8; retention[c]={'expected_background_36fb':b,'minimum':.8,'kept':keep}\r\n\u001b[?2004l\r"]
[193.476771, "o", "\u001b[?2004h> "]
