,-0.2,0.05])')\n w.factory(f'nsignal_sm_{safe}[{r[\\\"signal_yield_36fb\\\"]}]');w.var('nsignal_sm_'+safe).setConstant(True)\n w.factory(f'nresonant_{safe}[{r[\\\"resonant_higgs_yield_36fb\\\"]}]');w.var('nresonant_'+safe).setConstant(True)\n nf=r['extrapolated_full_continuum_yield'];w.factory(f'ncontinuum_{safe}[{nf},{max(.01,.2*nf)},{max(10.,3*nf+10)}]')\n w.factory(f'prod::nsignal_{safe}(mu,nsignal_sm_{safe})')\n w.factory(f'SUM::model_{safe}(nsignal_{safe}*signal_pdf_{safe},nresonant_{safe}*resonant_pdf_{safe},ncontinuum_{safe}*continuum_{safe})')\nw.writeToFile(str(D/'workspace.root'))\"\"\"\ns=s.replace(old2,new2)\nopen(p,'w').write(s)\nPY\npython3 -m py_compile scripts/build_workspace.py && python3 scripts/build_workspace.py\n"]
