[101.963288, "i", "python3 - <<'PY'\nimport uproot, awkward as ak, numpy as np, glob, os\nfor f in sorted(glob.glob('/data/GamGam/*/*.root')):\n t=uproot.open(f)['analysis']; names=['eventNumber','runNumber','photon_pt','photon_eta','photon_phi','photon_e','photon_isTightID','photon_isTightIso','lep_pt','jet_pt','jet_eta','jet_btag_quantile']\n a=t.arrays(names,library='ak')\n pk=(a.photon_pt>25)&(abs(a.photon_eta)<2.37)&~((abs(a.photon_eta)>1.37)&(abs(a.photon_eta)<1.52))\n # first two accepted photon indices, inputs are pT ordered\n idx=ak.local_index(a.photon_pt)[pk]; good=ak.num(idx)>=2\n i=idx[good,0]; j=idx[good,1]\n def take(x,ix): return x[good][ak.local_index(x[good],axis=0),ix]\n pt1,pt2=take(a.photon_pt,i),take(a.photon_pt,j); e1,e2=take(a.photon_e,i),take(a.photon_e,j); eta1,eta2=take(a.photon_eta,i),take(a.photon_eta,j); phi1,phi2=take(a.photon_phi,i),take(a.photon_phi,j)\n m=np.sqrt(np.maximum(0,(e1+e2)**2-(pt1*np.cos(phi1)+pt2*np.cos(phi2))**2-(pt1*np.sin(phi1)+pt2*np.sin(phi2))**2-(pt1*np.sinh(eta1)+pt2*np.sinh(eta2))**2))\n ti=np.asarray(take(a.photon_isTightID,i)&take(a.photon_isTightIso,i)&take(a.photon_isTightID,j)&take(a.photon_isTightIso,j))\n lep=ak.sum(a.lep_pt>10,axis=1); jets=(a.jet_pt>25); had=(lep==0)&(ak.sum(jets,axis=1)>=3)&(ak.sum(jets&(a.jet_btag_quantile>=4),axis=1)>=1)&good\n side=((m>=105)&(m<120))|((m>130)&(m<=160)); win=abs(m-125)<=2\n print(os.path.basename(f), 'rows',t.num_entries,'candidates',int(ak.sum(good)),'had',int(ak.sum(had)),'mrange',float(ak.min(m)),float(ak.max(m)),'TI/NTI',int(ti.sum()),int((~ti).sum()),'TI_sb/win',int(np.sum(ti&side)),int(np.sum(ti&win)),'NTI_sb/win',int(np.sum(~ti&side)),int(np.sum(~ti&win)))\nPY\n"]
