      },
      "require_id": false,
      "require_isolation": false,
      "explicit_statement": "No lepton ID and no lepton isolation requirement is applied for this preselection sample."
    },
    "jet_selection": {
      "collection": "jet_*",
      "pt_min_gev": 25.0,
      "pt_operator": ">",
      "central_definition": "|eta| <= 2.5",
