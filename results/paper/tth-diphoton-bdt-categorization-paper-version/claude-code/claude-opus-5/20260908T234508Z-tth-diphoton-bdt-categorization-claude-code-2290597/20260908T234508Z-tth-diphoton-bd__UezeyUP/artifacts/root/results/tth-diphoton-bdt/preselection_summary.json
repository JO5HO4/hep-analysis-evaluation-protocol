{
  "definitions": {
    "photon_selection": {
      "collection": "photon_*",
      "pt_min_gev": 25.0,
      "pt_operator": ">",
      "abs_eta_max": 2.37,
      "crack_veto_abs_eta": [
        1.37,
        1.52
      ],
      "require_tight_id": false,
      "require_isolation": false,
      "photon_tight_id_required": false,
      "photon_isolation_required": false,
      "explicit_statement": "Photon tight ID (photon_isTightID) is NOT required and photon isolation (photon_isTightIso) is NOT required for this preselection sample. Both flags are read and stored, but only to define the TI / NTI diphoton control categories used for the data-driven continuum estimate; neither is applied as an event selection cut at preselection.",
      "higgs_candidate": "two leading-pT photons passing kinematic acceptance; relative-pT cuts lead pT/m_yy > 0.35 and sublead pT/m_yy > 0.25",
      "ti_definition": "TI diphoton: BOTH photons pass tight ID AND tight isolation.",
      "nti_definition": "NTI diphoton: at least one of the two photons FAILS tight ID or FAILS tight isolation.",
      "m_gammagamma": "retained for bookkeeping and later validation; never a BDT input"
    },
    "hadronic_event_selection": {
      "statement": "n_leptons == 0 AND n_jets >= 3 AND n_bjets >= 1",
      "n_leptons": 0,
      "min_n_jets": 3,
      "min_n_bjets": 1,
      "required_channel": true
    },
    "leptonic_bookkeeping_selection": {
      "retained": true,
      "statement": "n_leptons >= 1 AND n_bjets >= 1 (provenance only; excluded from BDT training, boundary optimisation, categorization metrics and the workspace)",
      "min_n_leptons": 1,
      "min_n_bjets": 1,
      "role": "bookkeeping / provenance only",
      "excluded_from": [
        "hadronic BDT training",
        "BDT boundary optimisation",
        "categorization metrics and category yields",
        "RooFit statistical workspace"
      ],
      "reason": "The current open-data ROOT inputs contain no reconstructed forward jets, so leptonic top-associated categories are out of scope for this analysis."
    },
    "lepton_selection": {
      "collection": "lep_*",
      "pt_min_gev": 10.0,
      "pt_operator": ">",
      "flavours": {
