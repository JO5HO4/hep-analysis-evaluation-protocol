[51.24119, "o", "    fig, ax = plt.subplots(figsize=(7, 4.5))\r\n\u001b[?2004l\r"]
[51.241218, "o", "\u001b[?2004h> "]
[51.241581, "o", "    ax.hist(q_toys, bins=100, density=True, color='#4c78a8', alpha=0.8, label='Background-only toys')\r\n\u001b[?2004l\r"]
[51.24161, "o", "\u001b[?2004h> "]
[51.241908, "o", "    ax.axvline(q_obs, color='#e45756', lw=2, label=f'Observed q = {q_obs:.3f}')\r\n\u001b[?2004l\r"]
[51.241939, "o", "\u001b[?2004h> "]
[51.242361, "o", "    ax.set(xlabel=r'$q=-2\\ln(L_{s+b}/L_b)$', ylabel='Density', title='Background-only pseudo-experiment distribution')\r\n\u001b[?2004l\r"]
[51.242391, "o", "\u001b[?2004h> "]
[51.242452, "o", "    ax.legend()\r\n\u001b[?2004l\r"]
[51.242482, "o", "\u001b[?2004h> "]
[51.242568, "o", "    fig.tight_layout()\r\n\u001b[?2004l\r"]
[51.242596, "o", "\u001b[?2004h> "]
[51.242883, "o", "    fig.savefig(os.path.join(diagnostics, 'test_statistic_toys.png'), dpi=150)\r\n\u001b[?2004l\r"]
[51.242911, "o", "\u001b[?2004h> "]
[51.242987, "o", "    plt.close(fig)\r\n\u001b[?2004l\r"]
[51.243015, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.243041, "o", "\u001b[?2004h> "]
[51.243194, "o", "    scan_max = max(mu_hi * 1.25, 2.0)\r\n\u001b[?2004l\r"]
[51.243223, "o", "\u001b[?2004h> "]
[51.24339, "o", "    mu_scan = np.linspace(0.0, scan_max, 800)\r\n\u001b[?2004l\r"]
[51.243418, "o", "\u001b[?2004h> "]
[51.243784, "o", "    profile = np.array([-2.0 * (loglike(x, observed, background, signal) - ll_hat) for x in mu_scan])\r\n\u001b[?2004l\r"]
[51.243813, "o", "\u001b[?2004h> "]
[51.243982, "o", "    fig, ax = plt.subplots(figsize=(7, 4.5))\r\n\u001b[?2004l\r"]
[51.244011, "o", "\u001b[?2004h> "]
[51.244205, "o", "    ax.plot(mu_scan, profile, color='#4c78a8', lw=2)\r\n\u001b[?2004l\r"]
[51.244233, "o", "\u001b[?2004h> "]
[51.244494, "o", "    ax.axhline(1.0, color='gray', ls='--', label=r'$1\\sigma$ threshold')\r\n\u001b[?2004l\r"]
[51.244523, "o", "\u001b[?2004h> "]
[51.244838, "o", "    ax.axvline(mu_hat, color='#e45756', ls='-', label=rf'$\\hat{{\\mu}}={mu_hat:.3f}$')\r\n\u001b[?2004l\r"]
[51.244868, "o", "\u001b[?2004h> "]
[51.245106, "o", "    ax.scatter([mu_lo, mu_hi], [1, 1], color='#e45756', zorder=3)\r\n\u001b[?2004l\r"]
[51.245136, "o", "\u001b[?2004h> "]
[51.245784, "o", "    ax.set(xlabel=r'Signal strength $\\mu$', ylabel=r'$-2\\Delta\\log L(\\mu)$', ylim=(0, max(3.0, min(float(profile.max()) * 1.05, 10.0))), title='Signal-strength likelihood profile')\r\n\u001b[?2004l\r"]
[51.245815, "o", "\u001b[?2004h> "]
[51.245885, "o", "    ax.legend()\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.245931, "o", "> "]
[51.245995, "o", "    fig.tight_layout()\r\n\u001b[?2004l\r"]
[51.246022, "o", "\u001b[?2004h> "]
[51.246278, "o", "    fig.savefig(os.path.join(diagnostics, 'mu_profile.png'), dpi=150)\r\n\u001b[?2004l\r"]
[51.246306, "o", "\u001b[?2004h> "]
[51.246379, "o", "    plt.close(fig)\r\n\u001b[?2004l\r"]
[51.246407, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.246433, "o", "\u001b[?2004h> "]
[51.246509, "o", "    result = {\r\n\u001b[?2004l\r"]
[51.246537, "o", "\u001b[?2004h> "]
[51.246637, "o", "        'logL_b': logL_b,\r\n\u001b[?2004l\r"]
[51.246665, "o", "\u001b[?2004h> "]
[51.246768, "o", "        'logL_sb': logL_sb,\r\n\u001b[?2004l\r"]
[51.246797, "o", "\u001b[?2004h> "]
[51.246921, "o", "        'test_statistic': q_obs,\r\n\u001b[?2004l\r"]
[51.24695, "o", "\u001b[?2004h> "]
[51.247057, "o", "        'p_value': p_value,\r\n\u001b[?2004l\r"]
[51.247087, "o", "\u001b[?2004h> "]
[51.247231, "o", "        'significance': significance,\r\n\u001b[?2004l\r"]
[51.247259, "o", "\u001b[?2004h> "]
[51.247358, "o", "        'mu_hat': mu_hat,\r\n\u001b[?2004l\r"]
[51.247387, "o", "\u001b[?2004h> "]
[51.247477, "o", "        'mu_lo': mu_lo,\r\n\u001b[?2004l\r"]
[51.247505, "o", "\u001b[?2004h> "]
[51.247599, "o", "        'mu_hi': mu_hi,\r\n\u001b[?2004l\r"]
[51.247628, "o", "\u001b[?2004h> "]
[51.247725, "o", "        'n_toys': N_TOYS,\r\n\u001b[?2004l\r"]
[51.247754, "o", "\u001b[?2004h> "]
[51.247907, "o", "        'n_signal_like_toys': n_extreme,\r\n\u001b[?2004l\r"]
[51.247936, "o", "\u001b[?2004h> "]
[51.248034, "o", "        'toy_seed': SEED,\r\n\u001b[?2004l\r"]
[51.248064, "o", "\u001b[?2004h> "]
[51.248091, "o", "    }\r\n\u001b[?2004l\r"]
[51.248117, "o", "\u001b[?2004h> "]
[51.248253, "o", "    with open(outfile, 'w') as f:\r\n\u001b[?2004l\r"]
[51.248281, "o", "\u001b[?2004h> "]
[51.248482, "o", "        json.dump(result, f, indent=2, allow_nan=False)\r\n\u001b[?2004l\r"]
[51.24851, "o", "\u001b[?2004h> "]
[51.248595, "o", "        f.write('\\n')\r\n\u001b[?2004l\r"]
[51.248623, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.248649, "o", "\u001b[?2004h> "]
[51.248766, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[51.248795, "o", "\u001b[?2004h> "]
[51.248903, "o", "    if len(sys.argv) != 3:\r\n\u001b[?2004l\r"]
[51.248931, "o", "\u001b[?2004h> "]
[51.249212, "o", "        print(f'Usage: {sys.argv[0]} INPUT_JSON OUTPUT_JSON', file=sys.stderr)\r\n\u001b[?2004l\r"]
[51.249241, "o", "\u001b[?2004h> "]
[51.249324, "o", "        sys.exit(2)\r\n\u001b[?2004l\r"]
[51.249372, "o", "\u001b[?2004h> "]
[51.24948, "o", "    main(sys.argv[1], sys.argv[2])\r\n\u001b[?2004l\r"]
[51.249508, "o", "\u001b[?2004h> "]
[51.249534, "o", "PY\r\n\u001b[?2004l\r"]
[51.252793, "o", "\u001b[?2004hroot@nid004145:~# "]
[51.252973, "o", "cat > /root/submission/run.sh <<'SH'\r\n\u001b[?2004l\r"]
[51.253031, "o", "\u001b[?2004h> "]
[51.253114, "o", "#!/usr/bin/env bash\r\n\u001b[?2004l\r"]
[51.253169, "o", "\u001b[?2004h> "]
[51.25324, "o", "set -euo pipefail\r\n\u001b[?2004l\r"]
[51.253272, "o", "\u001b[?2004h> "]
[51.253389, "o", "if [ \"$#\" -ne 2 ]; then\r\n\u001b[?2004l\r"]
[51.253441, "o", "\u001b[?2004h> "]
[51.253634, "o", "  echo \"Usage: $0 INPUT_JSON OUTPUT_JSON\" >&2\r\n\u001b[?2004l\r"]
[51.253683, "o", "\u001b[?2004h> "]
[51.253731, "o", "  exit 2\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.253875, "o", "> fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.254099, "o", "exec python3 \"$(dirname \"$(readlink -f \"$0\")\")/analyze.py\" \"$1\" \"$2\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[51.254128, "o", "> SH\r\n\u001b[?2004l\r"]
[51.256837, "o", "\u001b[?2004hroot@nid004145:~# "]
[51.256955, "o", "chmod +x /root/submission/run.sh\r\n\u001b[?2004l\r"]
[51.259366, "o", "\u001b[?2004hroot@nid004145:~# "]
[51.25952, "o", "cat > /root/submission/README.md <<'MD'\r\n\u001b[?2004l\r"]
[51.25955, "o", "\u001b[?2004h> "]
[51.259706, "o", "# Four-lepton Poisson counting analysis\r\n\u001b[?2004l\r"]
[51.259736, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.259797, "o", "\u001b[?2004h> "]
[51.259906, "o", "Run the reproducible analysis with:\r\n\u001b[?2004l\r"]
[51.259935, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.259962, "o", "\u001b[?2004h> "]
[51.260007, "o", "```bash\r\n\u001b[?2004l\r"]
[51.260033, "o", "\u001b[?2004h> "]
[51.260213, "o", "/root/submission/run.sh INPUT_JSON OUTPUT_JSON\r\n\u001b[?2004l\r"]
[51.260242, "o", "\u001b[?2004h> ```\r\n\u001b[?2004l\r"]
[51.260305, "o", "\u001b[?2004h"]
[51.260351, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.261429, "o", "The input JSON has `channels`, `observed`, `background`, and `signal` arrays. Each channel is treated as an independent Poisson count. The program reports total Poisson log likelihoods (including `log(k!)`) for background and SM signal-plus-background, and the fixed-hypothesis statistic `q=-2(logL_sb-logL_b)`.\r\n\u001b[?2004l\r"]
[51.261457, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.261483, "o", "\u001b[?2004h> "]
[51.262722, "o", "For the p-value, one million background-only Poisson toy datasets are generated with a fixed NumPy seed. Smaller values of this q are more signal-like, so the reported one-sided p-value is the fraction with `q_toy <= q_observed`. The finite-toy estimate uses `(N_extreme+1)/(N_toys+1)`, and the Gaussian-equivalent significance is `Phi^-1(1-p)`.\r\n\u001b[?2004l\r"]
[51.262795, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.263964, "o", "For the measurement, the likelihood is profiled as a function of physical signal strength `mu >= 0`, with means `background + mu*signal`. Numerical optimization finds `mu_hat`; the one-standard-deviation endpoints are where `-2 Delta log L=1`. If the lower crossing would be below physical `mu=0`, the lower edge is reported as zero.\r\n\u001b[?2004l\r"]
[51.263995, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[51.264024, "o", "\u001b[?2004h> "]
[51.264509, "o", "Diagnostics are always regenerated at `submission/diagnostics/test_statistic_toys.png` and `submission/diagnostics/mu_profile.png`.\r\n\u001b[?2004l\r"]
[51.26454, "o", "\u001b[?2004h> MD\r\n\u001b[?2004l\r"]
[51.266821, "o", "\u001b[?2004hroot@nid004145:~# "]
[51.267139, "o", "/root/submission/run.sh /root/data/four_lepton_counts.json /root/results/results.json\r\n\u001b[?2004l\r"]
[52.779866, "o", "\u001b[?2004hroot@nid004145:~# "]
[61.143626, "i", "cat /root/results/results.json && ls -lh /root/submission/diagnostics /root/submission\n"]
[61.144254, "o", "cat /root/results/results.json && ls -lh /root/submission/diagnostics /root/submission\r\n\u001b[?2004l\r"]
[61.146348, "o", "{\r\n  \"logL_b\": -11.082750320271758,\r\n  \"logL_sb\": -5.8159224919108095,\r\n  \"test_statistic\": -10.533655656721898,\r\n  \"p_value\": 0.000212999787000213,\r\n  \"significance\": 3.523430021471673,\r\n  \"mu_hat\": 1.6238865611147593,\r\n  \"mu_lo\": 1.0089693335395655,\r\n  \"mu_hi\": 2.366643166595182,\r\n  \"n_toys\": 1000000,\r\n  \"n_signal_like_toys\": 212,\r\n  \"toy_seed\": 20250308\r\n}\r\n"]
[61.149563, "o", "/root/submission:\r\n"]
[61.149641, "o", "total 16K\r\n"]
[61.149693, "o", "-rw-r--r-- 1 root root 1.3K Aug 29 16:25 README.md\r\n-rw-r--r-- 1 root root 5.4K Aug 29 16:25 analyze.py\r\ndrwxr-xr-x 2 root root  100 Aug 29 16:25 diagnostics\r\n-rwxr-xr-x 1 root root  189 Aug 29 16:25 run.sh\r\n\r\n/root/submission/diagnostics:\r\n"]
[61.149923, "o", "total 96K\r\n-rw-r--r-- 1 root root 47K Aug 29 16:25 mu_profile.png\r\n-rw-r--r-- 1 root root 45K Aug 29 16:25 test_statistic_toys.png\r\n"]
[61.150162, "o", "\u001b[?2004hroot@nid004145:~# "]
[78.267848, "i", "python3 - <<'PY'\np='/root/submission/analyze.py'\ns=open(p).read()\ns=s.replace(\"    # Conservative finite-toy estimate avoids exactly zero p-values.\\n    p_value = (n_extreme + 1.0) / (N_TOYS + 1.0)\\n\", \"    # Toy-Monte-Carlo p-value: observed fraction at least as signal-like.\\n    p_value = n_extreme / N_TOYS\\n\")\ns=s.replace(\"        'toy_seed': SEED,\\n\", \"        'toy_seed': SEED,\\n        'evidence_at_3sigma': bool(significance >= 3.0),\\n        'mu_uncertainty_minus': mu_hat - mu_lo,\\n        'mu_uncertainty_plus': mu_hi - mu_hat,\\n\")\nopen(p,'w').write(s)\np='/root/submission/README.md'\ns=open(p).read()\ns=s.replace(\"The finite-toy estimate uses `(N_extreme+1)/(N_toys+1)`, and the Gaussian-equivalent significance is `Phi^-1(1-p)`.\", \"The p-value is the direct toy fraction `N_extreme/N_toys`, and the Gaussian-equivalent significance is `Phi^-1(1-p)`.\")\ns += \"\\nThe output also includes `evidence_at_3sigma`, which directly records whether the toy-derived Gaussian significance is at least 3.\\n\"\nopen(p,'w').write(s)\nPY\n/root/submission/run.sh /root/data/four_lepton_counts.json /root/results/results.json\npython3 -m json.tool /root/results/results.json\nprintf '\\nArtifacts:\\n'\ntest -x /root/submission/run.sh && echo 'run.sh is executable'\nfind /root/submission/diagnostics -maxdepth 1 -type f -printf '%f %s bytes\\n' | sort\n"]
[78.268201, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[78.268271, "o", "\u001b[?2004h"]
[78.268303, "o", "> "]
[78.268604, "o", "p='/root/submission/analyze.py'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.268693, "o", "s=open(p).read()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.269478, "o", "s=s.replace(\"    # Conservative finite-toy estimate avoids exactly zero p-values.\\n    p_value = (n_extreme + 1.0) / (N_TOYS + 1.0)\\n\", \"    # Toy-Monte-Carlo p-value: observed fraction at least as signal-like.\\n    p_value = n_extreme / N_TOYS\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.270226, "o", "s=s.replace(\"        'toy_seed': SEED,\\n\", \"        'toy_seed': SEED,\\n        'evidence_at_3sigma': bool(significance >= 3.0),\\n        'mu_uncertainty_minus': mu_hat - mu_lo,\\n        'mu_uncertainty_plus': mu_hi - mu_hat,\\n\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.27032, "o", "open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.270445, "o", "p='/root/submission/README.md'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.270514, "o", "s=open(p).read()\r\n\u001b[?2004l\r"]
[78.270545, "o", "\u001b[?2004h> "]
[78.27135, "o", "s=s.replace(\"The finite-toy estimate uses `(N_extreme+1)/(N_toys+1)`, and the Gaussian-equivalent significance is `Phi^-1(1-p)`.\", \"The p-value is the direct toy fraction `N_extreme/N_toys`, and the Gaussian-equivalent significance is `Phi^-1(1-p)`.\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.271824, "o", "s += \"\\nThe output also includes `evidence_at_3sigma`, which directly records whether the toy-derived Gaussian significance is at least 3.\\n\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.271909, "o", "open(p,'w').write(s)\r\n\u001b[?2004l\r"]
[78.271938, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[78.284491, "o", "\u001b[?2004hroot@nid004145:~# "]
[78.285043, "o", "/root/submission/run.sh /root/data/four_lepton_counts.json /root/results/results.json\r\n\u001b[?2004l\r"]
[79.451621, "o", "\u001b[?2004hroot@nid004145:~# "]
[79.451789, "o", "python3 -m json.tool /root/results/results.json\r\n\u001b[?2004l\r"]
[79.484997, "o", "{\r\n    \"logL_b\": -11.082750320271758,\r\n    \"logL_sb\": -5.8159224919108095,\r\n    \"test_statistic\": -10.533655656721898,\r\n    \"p_value\": 0.000212,\r\n    \"significance\": 3.5246766533968237,\r\n    \"mu_hat\": 1.6238865611147593,\r\n    \"mu_lo\": 1.0089693335395655,\r\n    \"mu_hi\": 2.366643166595182,\r\n    \"n_toys\": 1000000,\r\n    \"n_signal_like_toys\": 212,\r\n    "]
[79.485136, "o", "\"toy_seed\": 20250308,\r\n    \"evidence_at_3sigma\": true,\r\n    \"mu_uncertainty_minus\": 0.6149172275751937,\r\n    \"mu_uncertainty_plus\": 0.7427566054804227\r\n}\r\n"]
[79.488994, "o", "\u001b[?2004hroot@nid004145:~# "]
[79.489139, "o", "printf '\\nArtifacts:\\n'\r\n\u001b[?2004l\r"]
[79.489194, "o", "\r\nArtifacts:\r\n\u001b[?2004h"]
[79.489356, "o", "root@nid004145:~# "]
[79.489701, "o", "test -x /root/submission/run.sh && echo 'run.sh is executable'\r\n\u001b[?2004l\rrun.sh is executable\r\n"]
[79.489846, "o", "\u001b[?2004hroot@nid004145:~# "]
[79.490315, "o", "find /root/submission/diagnostics -maxdepth 1 -type f -printf '%f %s bytes\\n' | sort\r\n\u001b[?2004l\r"]
[79.494441, "o", "mu_profile.png 47691 bytes\r\ntest_statistic_toys.png 45368 bytes\r\n"]
[79.494787, "o", "\u001b[?2004hroot@nid004145:~# "]
