[?2004l[?2004h> #!/usr/bin/env python3
[?2004l[?2004h> """Likelihood analysis for independent Poisson counting channels."""
[?2004l[?2004h> import json
[?2004l[?2004h> import math
[?2004l[?2004h> import os
[?2004l[?2004h> import sys
[?2004l[?2004h> import numpy as np
[?2004l[?2004h> import matplotlib
[?2004l[?2004h> matplotlib.use('Agg')
[?2004l[?2004h> import matplotlib.pyplot as plt
[?2004l[?2004h> from scipy.optimize import minimize_scalar, brentq
[?2004l[?2004h> from scipy.special import gammaln, ndtri
[?2004l[?2004h> 
[?2004l[?2004h> N_TOYS = 1_000_000
[?2004l[?2004h> SEED = 20250308
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def loglike(mu, observed, background, signal):
[?2004l[?2004h>     mean = background + mu * signal
[?2004l[?2004h>     if np.any(mean <= 0):
[?2004l[?2004h>         return -np.inf
[?2004l[?2004h>     return float(np.sum(-mean + observed * np.log(mean) - gammaln(observed + 1)))
[?2004l[?2004h> 
[?2004l[?2004h> 
[?2004l[?2004h> def main(infile, outfile):
[?2004l[?2004h>     with open(infile) as f:
[?2004l[?2004h>         d = json.load(f)
[?2004l[?2004h>     observed = np.asarray(d['observed'], dtype=float)
[?2004l[?2004h>     background = np.asarray(d['background'], dtype=float)
[?2004l[?2004h>     signal = np.asarray(d['signal'], dtype=float)
[?2004l[?2004h>     n = len(observed)
[?2004l[?2004h>     if n == 0 or len(background) != n or len(signal) != n:
[?2004l[?2004h>         raise ValueError('observed, background, and signal must be equal-length nonempty arrays')
[?2004l[?2004h>     if np.any(observed < 0) or np.any(observed != np.floor(observed)):
[?2004l[?2004h>         raise ValueError('observed counts must be nonnegative integers')
[?2004l[?2004h>     if np.any(background <= 0) or np.any(signal < 0):
[?2004l[?2004h>         raise ValueError('background must be positive and signal nonnegative')
[?2004l[?2004h> 
[?2004l[?2004h>     logL_b = loglike(0.0, observed, background, signal)
[?2004l[?2004h>     logL_sb = loglike(1.0, observed, background, signal)
[?2004l[?2004h>     q_obs = -2.0 * (logL_sb - logL_b)
[?2004l[?2004h> 
[?2004l[?2004h>     # For fixed b versus fixed s+b, a lower q favors s+b and is more signal-like.
[?2004l[?2004h>     rng = np.random.default_rng(SEED)
[?2004l[?2004h>     q_toys = np.empty(N_TOYS, dtype=np.float64)
[?2004l[?2004h>     done = 0
[?2004l[?2004h>     logratio_const = -2.0 * (-(background + signal).sum() + background.sum())
[?2004l[?2004h>     # q = -2[sum(k log((b+s)/b)) - sum(s)]
[?2004l[?2004h>     weights = np.log((background + signal) / background)
[?2004l[?2004h>     batch = 100_000
[?2004l[?2004h>     while done < N_TOYS:
[?2004l[?2004h>         m = min(batch, N_TOYS - done)
[?2004l[?2004h>         toys = rng.poisson(background, size=(m, n))
[?2004l[?2004h>         q_toys[done:done+m] = -2.0 * (toys @ weights - signal.sum())
[?2004l[?2004h>         done += m
[?2004l[?2004h>     n_extreme = int(np.count_nonzero(q_toys <= q_obs))
[?2004l[?2004h>     # Conservative finite-toy estimate avoids exactly zero p-values.
[?2004l[?2004h>     p_value = (n_extreme + 1.0) / (N_TOYS + 1.0)
[?2004l[?2004h>     significance = float(ndtri(1.0 - p_value))
[?2004l[?2004h> 
[?2004l[?2004h>     # Profile over the physical signal-strength domain mu >= 0.
[?2004l[?2004h>     # Expand a bracket until its high end lies below the maximum likelihood.
[?2004l[?2004h>     upper = max(5.0, 2.0 * (float(observed.sum()) / max(float(signal.sum()), 1e-12) + 1.0))
[?2004l[?2004h>     while loglike(upper, observed, background, signal) > loglike(upper * 0.8, observed, background, signal):
[?2004l[?2004h>         upper *= 2.0
[?2004l[?2004h>     fit = minimize_scalar(lambda x: -loglike(x, observed, background, signal), bounds=(0.0, upper), method='bounded', options={'xatol': 1e-12})
[?2004l[?2004h>     mu_hat = float(fit.x)
[?2004l[?2004h>     ll_hat = -float(fit.fun)
[?2004l[?2004h>     target = ll_hat - 0.5
[?2004l[?2004h>     fprof = lambda x: loglike(x, observed, background, signal) - target
[?2004l[?2004h>     # If the likelihood at physical boundary remains within one unit, quote boundary.
[?2004l[?2004h>     mu_lo = 0.0 if fprof(0.0) >= 0 else float(brentq(fprof, 0.0, mu_hat, xtol=1e-12))
[?2004l[?2004h>     hi_bracket = max(upper, mu_hat + 1.0)
[?2004l[?2004h>     while fprof(hi_bracket) > 0:
[?2004l[?2004h>         hi_bracket *= 2.0
[?2004l[?2004h>     mu_hi = float(brentq(fprof, mu_hat, hi_bracket, xtol=1e-12))
[?2004l[?2004h> 
[?2004l[?2004h>     outdir = os.path.dirname(os.path.abspath(outfile))
[?2004l[?2004h>     os.makedirs(outdir, exist_ok=True)
[?2004l[?2004h>     diagnostics = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'diagnostics')
[?2004l[?2004h>     os.makedirs(diagnostics, exist_ok=True)
[?2004l[?2004h> 
[?2004l[?2004h>     # Distribution of the fixed-hypothesis likelihood-ratio statistic.
[?2004l[?2004h>     fig, ax = plt.subplots(figsize=(7, 4.5))
[?2004l[?2004h>     ax.hist(q_toys, bins=100, density=True, color='#4c78a8', alpha=0.8, label='Background-only toys')
[?2004l[?2004h>     ax.axvline(q_obs, color='#e45756', lw=2, label=f'Observed q = {q_obs:.3f}')
[?2004l[?2004h>     ax.set(xlabel=r'$q=-2\ln(L_{s+b}/L_b)$', ylabel='Density', title='Background-only pseudo-experiment distribution')
[?2004l[?2004h>     ax.legend()
[?2004l[?2004h>     fig.tight_layout()
[?2004l[?2004h>     fig.savefig(os.path.join(diagnostics, 'test_statistic_toys.png'), dpi=150)
[?2004l[?2004h>     plt.close(fig)
[?2004l[?2004h> 
[?2004l[?2004h>     scan_max = max(mu_hi * 1.25, 2.0)
[?2004l[?2004h>     mu_scan = np.linspace(0.0, scan_max, 800)
[?2004l[?2004h>     profile = np.array([-2.0 * (loglike(x, observed, background, signal) - ll_hat) for x in mu_scan])
[?2004l[?2004h>     fig, ax = plt.subplots(figsize=(7, 4.5))
[?2004l[?2004h>     ax.plot(mu_scan, profile, color='#4c78a8', lw=2)
[?2004l[?2004h>     ax.axhline(1.0, color='gray', ls='--', label=r'$1\sigma$ threshold')
[?2004l[?2004h>     ax.axvline(mu_hat, color='#e45756', ls='-', label=rf'$\hat{{\mu}}={mu_hat:.3f}$')
[?2004l[?2004h>     ax.scatter([mu_lo, mu_hi], [1, 1], color='#e45756', zorder=3)
[?2004l[?2004h>     ax.set(xlabel=r'Signal strength $\mu$', ylabel=r'$-2\Delta\log L(\mu)$', ylim=(0, max(3.0, min(float(profile.max()) * 1.05, 10.0))), title='Signal-strength likelihood profile')
[?2004l[?2004h>     ax.legend()
