[?2004l[?2004h> #!/usr/bin/env bash
[?2004l[?2004h> set -euo pipefail
[?2004l[?2004h> if [ "$#" -ne 2 ]; then
[?2004l[?2004h>   echo "Usage: $0 INPUT_JSON OUTPUT_JSON" >&2
[?2004l[?2004h>   exit 2
[?2004l[?2004h> fi
[?2004l[?2004h> exec python3 "$(dirname "$(readlink -f "$0")")/analyze.py" "$1" "$2"
