  "p_value": 0.999741,
  "significance": -3.471271488166993,
  "mu_hat": 1.6238866986318632,
  "mu_lo": 1.008969477246336,
  "mu_hi": 2.3666424563978943
}[?2004hroot@nid004218:~# 