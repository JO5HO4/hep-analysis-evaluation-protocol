[41.086082, "o", "\u001b[?2004h> "]
[41.086221, "o", "    plt.title('Profile Likelihood Scan')\r\n\u001b[?2004l\r"]
[41.086258, "o", "\u001b[?2004h> "]
[41.086334, "o", "    plt.xlabel('mu')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.086451, "o", "    plt.ylabel('-2 Delta log L')\r\n\u001b[?2004l\r"]
[41.08649, "o", "\u001b[?2004h> "]
[41.086563, "o", "    plt.legend()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.086714, "o", "    plt.savefig(f'{diag_dir}/mu_scan.png')\r\n\u001b[?2004l\r"]
[41.086773, "o", "\u001b[?2004h> "]
[41.086833, "o", "    plt.close()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
