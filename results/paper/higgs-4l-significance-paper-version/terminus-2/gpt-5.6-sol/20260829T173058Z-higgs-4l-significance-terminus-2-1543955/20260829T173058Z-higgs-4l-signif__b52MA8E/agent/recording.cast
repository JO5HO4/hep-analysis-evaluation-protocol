[79.217046, "o", "    # Explicitly compare the boundary in case the numerical optimizer sits nearby.\r\n\u001b[?2004l\r"]
[79.217077, "o", "\u001b[?2004h> "]
[79.217222, "o", "    if nll2(0.0) <= nll2(mu_hat):\r\n\u001b[?2004l\r"]
[79.21725, "o", "\u001b[?2004h> "]
[79.217362, "o", "        mu_hat = 0.0\r\n\u001b[?2004l\r"]
[79.217393, "o", "\u001b[?2004h> "]
[79.217514, "o", "    min_nll2 = nll2(mu_hat)\r\n\u001b[?2004l\r"]
[79.217544, "o", "\u001b[?2004h> "]
[79.217643, "o", "    def delta(mu):\r\n\u001b[?2004l\r"]
[79.217671, "o", "\u001b[?2004h> "]
[79.217884, "o", "        return nll2(mu) - min_nll2 - 1.0\r\n\u001b[?2004l\r"]
[79.217912, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[79.217937, "o", "\u001b[?2004h> "]
[79.21815, "o", "    if mu_hat > 0 and delta(0.0) >= 0:\r\n\u001b[?2004l\r"]
[79.218181, "o", "\u001b[?2004h> "]
[79.218434, "o", "        mu_lo = float(brentq(delta, 0.0, mu_hat, xtol=1e-12))\r\n\u001b[?2004l\r"]
[79.218463, "o", "\u001b[?2004h> "]
[79.218527, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.218572, "o", "> "]
[79.218946, "o", "        # If no lower unit crossing exists in the physical region, report boundary.\r\n\u001b[?2004l\r"]
[79.218975, "o", "\u001b[?2004h> "]
[79.219068, "o", "        mu_lo = 0.0\r\n\u001b[?2004l\r"]
[79.219097, "o", "\u001b[?2004h> "]
[79.219255, "o", "    hi = max(1.0, mu_hat*1.5 + 0.5)\r\n\u001b[?2004l\r"]
[79.219284, "o", "\u001b[?2004h> "]
[79.219389, "o", "    while delta(hi) < 0:\r\n\u001b[?2004l\r"]
[79.219418, "o", "\u001b[?2004h> "]
[79.219507, "o", "        hi *= 2.0\r\n\u001b[?2004l\r"]
[79.219536, "o", "\u001b[?2004h> "]
[79.219626, "o", "        if hi > 1e7:\r\n\u001b[?2004l\r"]
[79.219672, "o", "\u001b[?2004h> "]
[79.220035, "o", "            raise RuntimeError('failed to bracket upper likelihood crossing')\r\n\u001b[?2004l\r"]
[79.220065, "o", "\u001b[?2004h> "]
[79.220297, "o", "    mu_hi = float(brentq(delta, mu_hat, hi, xtol=1e-12))\r\n\u001b[?2004l\r"]
[79.220326, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[79.220352, "o", "\u001b[?2004h> "]
[79.22042, "o", "    result = {\r\n\u001b[?2004l\r"]
[79.220449, "o", "\u001b[?2004h> "]
[79.220548, "o", "        'logL_b': logL_b,\r\n\u001b[?2004l\r"]
[79.220576, "o", "\u001b[?2004h> "]
[79.220676, "o", "        'logL_sb': logL_sb,\r\n\u001b[?2004l\r"]
[79.220704, "o", "\u001b[?2004h> "]
[79.220837, "o", "        'test_statistic': q_obs,\r\n\u001b[?2004l\r"]
[79.220867, "o", "\u001b[?2004h> "]
[79.220965, "o", "        'p_value': p_value,\r\n\u001b[?2004l\r"]
[79.220993, "o", "\u001b[?2004h> "]
[79.221136, "o", "        'significance': significance,\r\n\u001b[?2004l\r"]
[79.221166, "o", "\u001b[?2004h> "]
[79.221255, "o", "        'mu_hat': mu_hat,\r\n\u001b[?2004l\r"]
[79.221286, "o", "\u001b[?2004h> "]
[79.221373, "o", "        'mu_lo': mu_lo,\r\n\u001b[?2004l\r"]
[79.221402, "o", "\u001b[?2004h> "]
[79.221492, "o", "        'mu_hi': mu_hi,\r\n\u001b[?2004l\r"]
[79.221521, "o", "\u001b[?2004h> "]
[79.221659, "o", "        'mu_err_minus': mu_hat-mu_lo,\r\n\u001b[?2004l\r"]
[79.221688, "o", "\u001b[?2004h> "]
[79.221824, "o", "        'mu_err_plus': mu_hi-mu_hat,\r\n\u001b[?2004l\r"]
[79.221853, "o", "\u001b[?2004h> "]
[79.22195, "o", "        'n_toys': N_TOYS,\r\n\u001b[?2004l\r"]
[79.22198, "o", "\u001b[?2004h> "]
[79.222118, "o", "        'n_extreme_toys': n_extreme,\r\n\u001b[?2004l\r"]
[79.222147, "o", "\u001b[?2004h> "]
[79.222239, "o", "        'toy_seed': SEED,\r\n\u001b[?2004l\r"]
[79.222268, "o", "\u001b[?2004h> "]
[79.222488, "o", "        'reaches_3sigma_evidence': bool(significance >= 3.0)\r\n\u001b[?2004l\r"]
[79.222517, "o", "\u001b[?2004h> "]
[79.222546, "o", "    }\r\n\u001b[?2004l\r"]
[79.222571, "o", "\u001b[?2004h> "]
[79.222821, "o", "    os.makedirs(os.path.dirname(os.path.abspath(out)), exist_ok=True)\r\n\u001b[?2004l\r"]
[79.222867, "o", "\u001b[?2004h> "]
[79.222963, "o", "    with open(out, 'w') as f:\r\n\u001b[?2004l\r"]
[79.222993, "o", "\u001b[?2004h> "]
[79.22319, "o", "        json.dump(result, f, indent=2, allow_nan=False)\r\n\u001b[?2004l\r"]
[79.223219, "o", "\u001b[?2004h> "]
[79.223303, "o", "        f.write('\\n')\r\n\u001b[?2004l\r"]
[79.223336, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[79.223362, "o", "\u001b[?2004h> "]
[79.223672, "o", "    diag = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'diagnostics')\r\n\u001b[?2004l\r"]
[79.223701, "o", "\u001b[?2004h> "]
[79.223836, "o", "    os.makedirs(diag, exist_ok=True)\r\n\u001b[?2004l\r"]
[79.223865, "o", "\u001b[?2004h> "]
[79.224018, "o", "    fig, ax = plt.subplots(figsize=(7,5))\r\n\u001b[?2004l\r"]
[79.224047, "o", "\u001b[?2004h> "]
[79.224332, "o", "    ax.hist(toy_q, bins=100, histtype='stepfilled', alpha=.7, color='steelblue')\r\n\u001b[?2004l\r"]
[79.224361, "o", "\u001b[?2004h> "]
[79.224646, "o", "    ax.axvline(q_obs, color='crimson', lw=2, label=f'observed q = {q_obs:.3f}')\r\n\u001b[?2004l\r"]
[79.224677, "o", "\u001b[?2004h> "]
[79.224865, "o", "    ax.set_xlabel(r'$q=-2\\log(L_{s+b}/L_b)$')\r\n\u001b[?2004l\r"]
[79.224897, "o", "\u001b[?2004h> "]
[79.22507, "o", "    ax.set_ylabel('Background-only toys / bin')\r\n\u001b[?2004l\r"]
[79.2251, "o", "\u001b[?2004h> "]
[79.225354, "o", "    ax.set_title(f'Background-only toy distribution ({N_TOYS:,} toys)')\r\n\u001b[?2004l\r"]
[79.225383, "o", "\u001b[?2004h> "]
[79.225446, "o", "    ax.legend()\r\n\u001b[?2004l\r"]
[79.225475, "o", "\u001b[?2004h> "]
[79.225562, "o", "    fig.tight_layout()\r\n\u001b[?2004l\r"]
[79.225591, "o", "\u001b[?2004h> "]
[79.22588, "o", "    fig.savefig(os.path.join(diag, 'test_statistic_distribution.png'), dpi=160)\r\n\u001b[?2004l\r"]
[79.225909, "o", "\u001b[?2004h> "]
[79.22598, "o", "    plt.close(fig)\r\n\u001b[?2004l\r"]
[79.226009, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[79.226035, "o", "\u001b[?2004h> "]
[79.2262, "o", "    scan_hi = max(mu_hi*1.35, mu_hat+1.0)\r\n\u001b[?2004l\r"]
[79.226228, "o", "\u001b[?2004h> "]
[79.226371, "o", "    mus = np.linspace(0, scan_hi, 600)\r\n\u001b[?2004l\r"]
[79.226399, "o", "\u001b[?2004h> "]
[79.226583, "o", "    ds = np.array([nll2(x)-min_nll2 for x in mus])\r\n\u001b[?2004l\r"]
[79.226612, "o", "\u001b[?2004h> "]
[79.226762, "o", "    fig, ax = plt.subplots(figsize=(7,5))\r\n\u001b[?2004l\r"]
[79.226793, "o", "\u001b[?2004h> "]
[79.226942, "o", "    ax.plot(mus, ds, color='navy', lw=2)\r\n\u001b[?2004l\r"]
[79.226971, "o", "\u001b[?2004h> "]
[79.227223, "o", "    ax.axhline(1, color='gray', ls='--', label=r'$-2\\Delta\\log L=1$')\r\n\u001b[?2004l\r"]
[79.227251, "o", "\u001b[?2004h> "]
[79.22754, "o", "    ax.axvline(mu_hat, color='crimson', ls='-', label=rf'$\\hat\\mu={mu_hat:.3f}$')\r\n\u001b[?2004l\r"]
[79.227589, "o", "\u001b[?2004h> "]
[79.227743, "o", "    ax.axvline(mu_lo, color='crimson', ls=':')\r\n\u001b[?2004l\r"]
[79.227789, "o", "\u001b[?2004h> "]
[79.227939, "o", "    ax.axvline(mu_hi, color='crimson', ls=':')\r\n\u001b[?2004l\r"]
[79.227968, "o", "\u001b[?2004h> "]
[79.228168, "o", "    ax.set_ylim(0, max(4, min(12, float(ds[-1])*1.05)))\r\n\u001b[?2004l\r"]
[79.228197, "o", "\u001b[?2004h> "]
[79.2283, "o", "    ax.set_xlim(0, scan_hi)\r\n\u001b[?2004l\r"]
[79.22833, "o", "\u001b[?2004h> "]
[79.228489, "o", "    ax.set_xlabel(r'Signal strength $\\mu$')\r\n\u001b[?2004l\r"]
[79.228518, "o", "\u001b[?2004h> "]
[79.228673, "o", "    ax.set_ylabel(r'$-2\\Delta\\log L(\\mu)$')\r\n\u001b[?2004l\r"]
[79.228702, "o", "\u001b[?2004h> "]
[79.228935, "o", "    ax.set_title('Signal-strength profile likelihood')\r\n\u001b[?2004l\r"]
[79.228966, "o", "\u001b[?2004h> "]
[79.229027, "o", "    ax.legend()\r\n\u001b[?2004l\r"]
[79.229055, "o", "\u001b[?2004h> "]
[79.229138, "o", "    fig.tight_layout()\r\n\u001b[?2004l\r"]
[79.229166, "o", "\u001b[?2004h> "]
[79.229431, "o", "    fig.savefig(os.path.join(diag, 'mu_profile_likelihood.png'), dpi=160)\r\n\u001b[?2004l\r"]
[79.229462, "o", "\u001b[?2004h> "]
[79.229533, "o", "    plt.close(fig)\r\n\u001b[?2004l\r"]
[79.229562, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[79.229587, "o", "\u001b[?2004h> "]
[79.229698, "o", "if __name__ == '__main__':\r\n\u001b[?2004l\r"]
[79.229727, "o", "\u001b[?2004h> "]
[79.229826, "o", "    if len(sys.argv) != 3:\r\n\u001b[?2004l\r"]
[79.229855, "o", "\u001b[?2004h> "]
[79.230133, "o", "        print(f'Usage: {sys.argv[0]} INPUT_JSON OUTPUT_JSON', file=sys.stderr)\r\n\u001b[?2004l\r"]
[79.230163, "o", "\u001b[?2004h> "]
[79.230243, "o", "        sys.exit(2)\r\n\u001b[?2004l\r"]
[79.230272, "o", "\u001b[?2004h> "]
[79.230394, "o", "    main(sys.argv[1], sys.argv[2])\r\n\u001b[?2004l\r"]
[79.230422, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[79.232716, "o", "\u001b[?2004hroot@nid004145:~# "]
[79.232968, "o", "cat > /root/submission/run.sh <<'SH'\r\n\u001b[?2004l\r"]
[79.233005, "o", "\u001b[?2004h"]
[79.233039, "o", "> "]
[79.23315, "o", "#!/usr/bin/env bash\r\n\u001b[?2004l\r"]
[79.233188, "o", "\u001b[?2004h> "]
[79.23331, "o", "set -euo pipefail\r\n\u001b[?2004l\r"]
[79.233349, "o", "\u001b[?2004h> "]
[79.233511, "o", "if [[ $# -ne 2 ]]; then\r\n\u001b[?2004l\r"]
[79.23355, "o", "\u001b[?2004h> "]
[79.233722, "o", "  echo \"Usage: $0 INPUT_JSON OUTPUT_JSON\" >&2\r\n\u001b[?2004l\r"]
[79.233751, "o", "\u001b[?2004h> "]
[79.23381, "o", "  exit 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.233855, "o", "fi\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.234025, "o", "SCRIPT_DIR=\"$(cd \"$(dirname \"$0\")\" && pwd)\"\r\n\u001b[?2004l\r"]
[79.234054, "o", "\u001b[?2004h> "]
[79.23423, "o", "exec python3 \"$SCRIPT_DIR/analyze.py\" \"$1\" \"$2\"\r\n\u001b[?2004l\r"]
[79.234258, "o", "\u001b[?2004h> SH\r\n\u001b[?2004l\r"]
[79.236339, "o", "\u001b[?2004hroot@nid004145:~# "]
[79.23657, "o", "chmod +x /root/submission/run.sh /root/submission/analyze.py\r\n\u001b[?2004l\r"]
[79.23855, "o", "\u001b[?2004hroot@nid004145:~# "]
[79.238801, "o", "cat > /root/submission/README.md <<'MD'\r\n\u001b[?2004l\r"]
[79.23884, "o", "\u001b[?2004h"]
[79.238876, "o", "> "]
[79.239057, "o", "# Four-lepton counting analysis\r\n\u001b[?2004l\r"]
[79.239095, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[79.239176, "o", "\u001b[?2004h> "]
[79.239239, "o", "Run with:\r\n\u001b[?2004l\r"]
[79.239301, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[79.239361, "o", "\u001b[?2004h> "]
[79.239396, "o", "```bash\r\n\u001b[?2004l\r"]
[79.23947, "o", "\u001b[?2004h> "]
[79.239657, "o", "/root/submission/run.sh INPUT_JSON OUTPUT_JSON\r\n\u001b[?2004l\r"]
[79.239688, "o", "\u001b[?2004h> ```\r\n"]
[79.239745, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[79.239773, "o", "\u001b[?2004h> "]
[79.240301, "o", "The program validates the channel arrays and computes summed Poisson log-likelihoods including the `log(k!)` terms. The fixed-hypothesis statistic is\r\n\u001b[?2004l\r"]
[79.24033, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[79.240387, "o", "\u001b[?2004h> "]
[79.240488, "o", "`q = -2 [log L(s+b) - log L(b)]`.\r\n\u001b[?2004l\r"]
[79.240514, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[79.24054, "o", "\u001b[?2004h> "]
[79.24197, "o", "One million background-only pseudo-experiments are generated with NumPy's `default_rng` using seed 123456789. With this sign convention, signal-like outcomes have **smaller** q, so the reported empirical p-value is the fraction `q_toy <= q_observed`; Z is `norm.isf(p)`. If no toy enters the tail, a half-toy convention is used only to keep the reported Z finite (the p-value itself remains zero).\r\n\u001b[?2004l\r"]
[79.242001, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[79.242027, "o", "\u001b[?2004h> "]
[79.243394, "o", "For signal strength, the Poisson likelihood with means `b_i + mu*s_i` is optimized over the physical region `mu >= 0`. Brent root finding locates the two `-2 delta log L = 1` crossings; if a lower crossing does not occur in the physical region, `mu_lo=0` is used. The output also includes uncertainty differences, toy metadata, and a 3-sigma evidence boolean beyond the required fields.\r\n\u001b[?2004l\r"]
[79.243423, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[79.243487, "o", "\u001b[?2004h> "]
[79.2442, "o", "Each run writes diagnostic PNGs to `diagnostics/test_statistic_distribution.png` and `diagnostics/mu_profile_likelihood.png` beside this code. Scientific dependencies are NumPy, SciPy, and Matplotlib.\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.244233, "o", "> MD\r\n\u001b[?2004l\r"]
[79.246311, "o", "\u001b[?2004hroot@nid004145:~# "]
[79.24666, "o", "/root/submission/run.sh /root/data/four_lepton_counts.json /root/results/results.json\r\n\u001b[?2004l\r"]
[80.750411, "o", "\u001b[?2004hroot@nid004145:~# "]
[80.750542, "o", "cat /root/results/results.json\r\n\u001b[?2004l\r"]
[80.752876, "o", "{\r\n  \"logL_b\": -11.082750320271758,\r\n  \"logL_sb\": -5.8159224919108095,\r\n  \"test_statistic\": -10.533655656721898,\r\n  \"p_value\": 0.000258,\r\n  \"significance\": 3.4723100618884772,\r\n  \"mu_hat\": 1.6238865854853561,\r\n  \"mu_lo\": 1.008969333539566,\r\n  \"mu_hi\": 2.3666431665951246,\r\n  \"mu_err_minus\": 0.6149172519457902,\r\n  \"mu_err_plus\": 0.7427565811097685,\r\n  \"n_toys\": 1000000,\r\n  \"n_extreme_toys\": 258,\r\n  \"toy_seed\": 123456789,\r\n  \"reaches_3sigma_evidence\": true\r\n}\r\n"]
[80.753076, "o", "\u001b[?2004hroot@nid004145:~# "]
[80.753266, "o", "ls -lh /root/submission/diagnostics\r\n\u001b[?2004l\r"]
[80.756545, "o", "total 116K\r\n"]
[80.756631, "o", "-rw-r--r-- 1 root root 66K Aug 29 17:34 mu_profile_likelihood.png\r\n-rw-r--r-- 1 root root 48K Aug 29 17:34 test_statistic_distribution.png\r\n"]
[80.756901, "o", "\u001b[?2004hroot@nid004145:~# "]
[110.106126, "i", "python3 -m py_compile /root/submission/analyze.py && bash -n /root/submission/run.sh && test -x /root/submission/run.sh && python3 - <<'PY'\nimport json, math\nfrom pathlib import Path\nfrom scipy.special import gammaln\nwith open('/root/data/four_lepton_counts.json') as f: d=json.load(f)\nwith open('/root/results/results.json') as f: r=json.load(f)\ndef ll(mu):\n    return sum(-(b+mu*s)+n*math.log(b+mu*s)-gammaln(n+1)\n               for n,b,s in zip(d['observed'],d['background'],d['signal']))\nassert abs(ll(0)-r['logL_b']) < 1e-12\nassert abs(ll(1)-r['logL_sb']) < 1e-12\nassert abs(-2*(ll(1)-ll(0))-r['test_statistic']) < 1e-12\nassert abs(-2*(ll(r['mu_lo'])-ll(r['mu_hat']))-1) < 1e-8\nassert abs(-2*(ll(r['mu_hi'])-ll(r['mu_hat']))-1) < 1e-8\nassert r['n_toys'] >= 1_000_000\nassert r['reaches_3sigma_evidence'] == (r['significance'] >= 3)\nprint('All numerical and file checks passed')\nprint(f\"mu = {r['mu_hat']:.4f} +{r['mu_err_plus']:.4f} -{r['mu_err_minus']:.4f}\")\nprint(f\"p = {r['p_value']:.6g}, Z = {r['significance']:.4f}, 3sigma = {r['reaches_3sigma_evidence']}\")\nPY\nfile /root/submission/diagnostics/*.png\nfind /root/submission /root/results -maxdepth 2 -type f -printf '%p\\n' | sort\n"]
[110.106756, "o", "python3 -m py_compile /root/submission/analyze.py && bash -n /root/submission/run.sh && test -x /root/submission/run.sh && python3 - <<'PY'\r\n\u001b[?2004l\r"]
[110.106803, "o", "\u001b[?2004h> "]
[110.106839, "o", "import json, math\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.106976, "o", "> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.107089, "o", "from scipy.special import gammaln\r\n\u001b[?2004l\r"]
[110.107126, "o", "\u001b[?2004h> "]
[110.10741, "o", "with open('/root/data/four_lepton_counts.json') as f: d=json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.107656, "o", "with open('/root/results/results.json') as f: r=json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.107722, "o", "def ll(mu):\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.107755, "o", "> "]
[110.107927, "o", "    return sum(-(b+mu*s)+n*math.log(b+mu*s)-gammaln(n+1)\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.107957, "o", "> "]
[110.108224, "o", "               for n,b,s in zip(d['observed'],d['background'],d['signal']))\r\n\u001b[?2004l\r"]
[110.108252, "o", "\u001b[?2004h> "]
[110.10839, "o", "assert abs(ll(0)-r['logL_b']) < 1e-12\r\n\u001b[?2004l\r"]
[110.10842, "o", "\u001b[?2004h> "]
[110.108562, "o", "assert abs(ll(1)-r['logL_sb']) < 1e-12\r\n\u001b[?2004l\r"]
[110.10859, "o", "\u001b[?2004h> "]
[110.10884, "o", "assert abs(-2*(ll(1)-ll(0))-r['test_statistic']) < 1e-12\r\n\u001b[?2004l\r"]
[110.108872, "o", "\u001b[?2004h> "]
[110.109072, "o", "assert abs(-2*(ll(r['mu_lo'])-ll(r['mu_hat']))-1) < 1e-8\r\n\u001b[?2004l\r"]
[110.1091, "o", "\u001b[?2004h> "]
[110.109306, "o", "assert abs(-2*(ll(r['mu_hi'])-ll(r['mu_hat']))-1) < 1e-8\r\n\u001b[?2004l\r"]
[110.109335, "o", "\u001b[?2004h> "]
[110.109451, "o", "assert r['n_toys'] >= 1_000_000\r\n\u001b[?2004l\r"]
[110.10948, "o", "\u001b[?2004h> "]
[110.109708, "o", "assert r['reaches_3sigma_evidence'] == (r['significance'] >= 3)\r\n\u001b[?2004l\r"]
[110.109736, "o", "\u001b[?2004h> "]
[110.109907, "o", "print('All numerical and file checks passed')\r\n\u001b[?2004l\r"]
[110.109934, "o", "\u001b[?2004h> "]
[110.110229, "o", "print(f\"mu = {r['mu_hat']:.4f} +{r['mu_err_plus']:.4f} -{r['mu_err_minus']:.4f}\")\r\n\u001b[?2004l\r"]
[110.110257, "o", "\u001b[?2004h> "]
[110.110627, "o", "print(f\"p = {r['p_value']:.6g}, Z = {r['significance']:.4f}, 3sigma = {r['reaches_3sigma_evidence']}\")\r\n\u001b[?2004l\r"]
[110.110653, "o", "\u001b[?2004h> PY\r\n"]
[110.110707, "o", "\u001b[?2004l\r"]
[110.379166, "o", "All numerical and file checks passed\r\nmu = 1.6239 +0.7428 -0.6149\r\np = 0.000258, Z = 3.4723, 3sigma = True\r\n"]
[110.405186, "o", "\u001b[?2004hroot@nid004145:~# "]
[110.405388, "o", "file /root/submission/diagnostics/*.png\r\n\u001b[?2004l\r"]
[110.406227, "o", "bash: file: command not found\r\n"]
[110.406475, "o", "\u001b[?2004hroot@nid004145:~# "]
