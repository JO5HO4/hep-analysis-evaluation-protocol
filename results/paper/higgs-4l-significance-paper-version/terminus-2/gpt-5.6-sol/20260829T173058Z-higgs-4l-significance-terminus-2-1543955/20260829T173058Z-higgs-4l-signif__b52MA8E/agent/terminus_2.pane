[?2004l[?2004h>         if hi > 1e7:
[?2004l[?2004h>             raise RuntimeError('failed to bracket upper likelihood crossing')
[?2004l[?2004h>     mu_hi = float(brentq(delta, mu_hat, hi, xtol=1e-12))
[?2004l[?2004h> 
[?2004l[?2004h>     result = {
[?2004l[?2004h>         'logL_b': logL_b,
[?2004l[?2004h>         'logL_sb': logL_sb,
[?2004l[?2004h>         'test_statistic': q_obs,
[?2004l[?2004h>         'p_value': p_value,
[?2004l[?2004h>         'significance': significance,
[?2004l[?2004h>         'mu_hat': mu_hat,
[?2004l[?2004h>         'mu_lo': mu_lo,
