[?2004l[?2004h>         qvals = 2.0*(np.sum(sig) - counts @ weights)
[?2004l[?2004h>         n_extreme += int(np.count_nonzero(qvals <= q_obs + 1e-12))
[?2004l[?2004h>         toy_q_parts.append(qvals)
[?2004l[?2004h>     toy_q = np.concatenate(toy_q_parts)
[?2004l[?2004h>     p_value = n_extreme/N_TOYS
[?2004l[?2004h>     significance = float(norm.isf(p_value)) if p_value > 0 else float(norm.isf(0.5/N_TOYS))
[?2004l[?2004h> 
[?2004l[?2004h>     def nll2(mu):
[?2004l[?2004h>         means = bkg + mu*sig
[?2004l[?2004h>         return -2.0*loglike(obs, means)
[?2004l[?2004h> 
[?2004l[?2004h>     # Physical signal strength constraint mu >= 0.
[?2004l[?2004h>     upper = max(5.0, 2.0*(np.sum(obs)/np.sum(sig)))
[?2004l[?2004h>     fit = minimize_scalar(nll2, bounds=(0.0, upper), method='bounded',
[?2004l[?2004h>                           options={'xatol': 1e-12})
[?2004l[?2004h>     mu_hat = float(fit.x)
[?2004l[?2004h>     # Explicitly compare the boundary in case the numerical optimizer sits nearby.
[?2004l[?2004h>     if nll2(0.0) <= nll2(mu_hat):
