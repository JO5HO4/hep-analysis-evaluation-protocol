[?2004l[?2004h>     obs, bkg, sig = validate(data)
[?2004l[?2004h> 
[?2004l[?2004h>     logL_b = loglike(obs, bkg)
[?2004l[?2004h>     logL_sb = loglike(obs, bkg + sig)
[?2004l[?2004h>     q_obs = -2.0*(logL_sb - logL_b)
[?2004l[?2004h> 
[?2004l[?2004h>     # For fixed hypotheses q = 2 sum[s_i - n_i log((b_i+s_i)/b_i)].
[?2004l[?2004h>     # Thus smaller q is more signal-like.
[?2004l[?2004h>     weights = np.log1p(sig/bkg)
[?2004l[?2004h>     rng = np.random.default_rng(SEED)
[?2004l[?2004h>     toy_q_parts = []
[?2004l[?2004h>     batch = 100_000
[?2004l[?2004h>     n_extreme = 0
