[?2004l[?2004h> 
[?2004l[?2004h> N_TOYS = 1_000_000
[?2004l[?2004h> SEED = 123456789
[?2004l[?2004h> 
[?2004l[?2004h> def validate(data):
[?2004l[?2004h>     for key in ('channels', 'observed', 'background', 'signal'):
[?2004l[?2004h>         if key not in data:
[?2004l[?2004h>             raise ValueError(f'missing required field: {key}')
[?2004l[?2004h>     n = len(data['channels'])
[?2004l[?2004h>     if n == 0 or any(len(data[k]) != n for k in ('observed','background','signal')):
[?2004l[?2004h>         raise ValueError('channel arrays must be nonempty and have equal lengths')
[?2004l[?2004h>     obs = np.asarray(data['observed'], dtype=float)
[?2004l[?2004h>     bkg = np.asarray(data['background'], dtype=float)
[?2004l[?2004h>     sig = np.asarray(data['signal'], dtype=float)
[?2004l[?2004h>     if np.any(~np.isfinite(obs)) or np.any(obs < 0) or np.any(obs != np.floor(obs)):
[?2004l[?2004h>         raise ValueError('observed counts must be finite nonnegative integers')
[?2004l[?2004h>     if np.any(~np.isfinite(bkg)) or np.any(bkg <= 0):
[?2004l[?2004h>         raise ValueError('background expectations must be finite and strictly positive')
[?2004l[?2004h>     if np.any(~np.isfinite(sig)) or np.any(sig < 0) or not np.any(sig > 0):
[?2004l[?2004h>         raise ValueError('signal expectations must be finite, nonnegative, and not all zero')
[?2004l[?2004h>     return obs.astype(np.int64), bkg, sig
[?2004l[?2004h> 
[?2004l[?2004h> def loglike(counts, means):
