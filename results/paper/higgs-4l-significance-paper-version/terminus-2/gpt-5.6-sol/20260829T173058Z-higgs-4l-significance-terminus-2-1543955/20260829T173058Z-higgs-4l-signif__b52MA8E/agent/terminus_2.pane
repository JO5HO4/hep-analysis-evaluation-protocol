[?2004l[?2004h>         'mu_err_minus': mu_hat-mu_lo,
[?2004l[?2004h>         'mu_err_plus': mu_hi-mu_hat,
[?2004l[?2004h>         'n_toys': N_TOYS,
[?2004l[?2004h>         'n_extreme_toys': n_extreme,
[?2004l[?2004h>         'toy_seed': SEED,
[?2004l[?2004h>         'reaches_3sigma_evidence': bool(significance >= 3.0)
[?2004l[?2004h>     }
[?2004l[?2004h>     os.makedirs(os.path.dirname(os.path.abspath(out)), exist_ok=True)
