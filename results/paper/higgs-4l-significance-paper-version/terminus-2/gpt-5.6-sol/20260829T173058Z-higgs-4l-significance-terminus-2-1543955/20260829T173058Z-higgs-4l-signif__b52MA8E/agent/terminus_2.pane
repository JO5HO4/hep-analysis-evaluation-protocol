[?2004l[?2004h>     min_nll2 = nll2(mu_hat)
[?2004l[?2004h>     def delta(mu):
[?2004l[?2004h>         return nll2(mu) - min_nll2 - 1.0
[?2004l[?2004h> 
[?2004l[?2004h>     if mu_hat > 0 and delta(0.0) >= 0:
[?2004l[?2004h>         mu_lo = float(brentq(delta, 0.0, mu_hat, xtol=1e-12))
[?2004l[?2004h>     else:
[?2004l[?2004h>         # If no lower unit crossing exists in the physical region, report boundary.
[?2004l[?2004h>         mu_lo = 0.0
[?2004l[?2004h>     hi = max(1.0, mu_hat*1.5 + 0.5)
[?2004l[?2004h>     while delta(hi) < 0:
