[?2004l[?2004h> def dphi(a,b): return abs((a-b+np.pi)%(2*np.pi)-np.pi)
[?2004l[?2004h> def vec(pt,eta,phi,m):
[?2004l[?2004h>  px=pt*np.cos(phi); py=pt*np.sin(phi); pz=pt*np.sinh(eta)
[?2004l[?2004h>  return px,py,pz,np.sqrt(max(0,m*m+pt*pt*np.cosh(eta)**2))
[?2004l[?2004h> def kin(indices,pt,eta,phi,m):
[?2004l[?2004h>  vs=[vec(float(pt[q]),float(eta[q]),float(phi[q]),float(m[q])) for q in indices]
[?2004l[?2004h>  px=sum(v[0] for v in vs); py=sum(v[1] for v in vs); pz=sum(v[2] for v in vs); E=sum(v[3] for v in vs)
[?2004l[?2004h>  pT=np.hypot(px,py); mass=np.sqrt(max(0,E*E-px*px-py*py-pz*pz))
[?2004l[?2004h>  et=np.arcsinh(pz/pT) if pT>0 else 0.; ph=np.arctan2(py,px)
[?2004l[?2004h>  return pT,et,ph,mass
[?2004l[?2004h> 
[?2004l[?2004h> def auc(y,s):
[?2004l[?2004h>  y=np.asarray(y,dtype=int); s=np.asarray(s)
[?2004l[?2004h>  order=np.argsort(s,kind='mergesort'); ranks=np.empty(len(s),float); ranks[order]=np.arange(1,len(s)+1)
[?2004l[?2004h>  # average tied ranks
[?2004l[?2004h>  for lo in range(len(order)):
[?2004l[?2004h>   if lo and s[order[lo]]==s[order[lo-1]]: continue
[?2004l[?2004h>   hi=lo+1
[?2004l[?2004h>   while hi<len(order) and s[order[hi]]==s[order[lo]]: hi+=1
[?2004l[?2004h>   ranks[order[lo:hi]]=(lo+1+hi)/2
[?2004l[?2004h>  n1=y.sum(); n0=len(y)-n1
[?2004l[?2004h>  return float((ranks[y==1].sum()-n1*(n1+1)/2)/(n1*n0))
