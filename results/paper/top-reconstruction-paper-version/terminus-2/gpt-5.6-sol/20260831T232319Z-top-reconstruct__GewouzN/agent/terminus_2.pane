[?2004l[?2004h>                tm,tpt,teta,tphi,n,pts[0],pts[1],pts[2],sum(pts),bts[0],bts[1],bts[2],sum(bts),min(ds),max(ds),sum(ds),pms[0],pms[1],pms[2]))
[?2004l[?2004h> cols=['event_id','i','j','k','is_truth','dr_ab','dr_ac','dr_bc','mij_over_m123_ab','mij_over_m123_ac','mij_over_m123_bc','triplet_mass','triplet_pt','triplet_eta','triplet_phi','n_genjet','pt_max','pt_mid','pt_min','pt_sum','btag_max','btag_mid','btag_min','btag_sum','dr_min','dr_max','dr_sum','mij_ab','mij_ac','mij_bc']
