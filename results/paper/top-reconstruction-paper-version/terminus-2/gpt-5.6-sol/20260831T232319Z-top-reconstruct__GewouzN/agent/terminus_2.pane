[?2004l[?2004h> # Event selector: exact maximization over singleton/pair; score^alpha emphasizes confidence.
[?2004l[?2004h> def select(frame,scorecol='score',mode='exact',alpha=1.0):
[?2004l[?2004h>  out=[]
[?2004l[?2004h>  for eid,g0 in frame.groupby('event_id',sort=False):
[?2004l[?2004h>   g=g0.sort_values(scorecol,ascending=False).head(120)
[?2004l[?2004h>   rec=list(g.to_dict('records'))
[?2004l[?2004h>   if not rec: continue
[?2004l[?2004h>   if mode=='greedy':
[?2004l[?2004h>    chosen=[rec[0]]; used={rec[0]['i'],rec[0]['j'],rec[0]['k']}
[?2004l[?2004h>    for r in rec[1:]:
[?2004l[?2004h>     if used.isdisjoint({r['i'],r['j'],r['k']}): chosen.append(r); break
[?2004l[?2004h>   else:
[?2004l[?2004h>    util=np.power(np.clip(np.array([r[scorecol] for r in rec]),1e-9,1),alpha)
[?2004l[?2004h>    best=float(util[0]); pair=None
[?2004l[?2004h>    for p in range(len(rec)):
[?2004l[?2004h>     sp={rec[p]['i'],rec[p]['j'],rec[p]['k']}
[?2004l[?2004h>     for q in range(p+1,len(rec)):
[?2004l[?2004h>      if sp.isdisjoint({rec[q]['i'],rec[q]['j'],rec[q]['k']}):
[?2004l[?2004h>       z=float(util[p]+util[q])
[?2004l[?2004h>       if z>best: best=z; pair=(p,q)
[?2004l[?2004h>    chosen=[rec[0]] if pair is None else [rec[pair[0]],rec[pair[1]]]
[?2004l[?2004h>    chosen=sorted(chosen,key=lambda r:r[scorecol],reverse=True)
[?2004l[?2004h>   out.extend(chosen)
[?2004l[?2004h>  return pd.DataFrame(out)
