[142.537295, "o", "def dphi(a,b): return abs((a-b+np.pi)%(2*np.pi)-np.pi)\r\n\u001b[?2004l\r"]
[142.537365, "o", "\u001b[?2004h> "]
[142.53744, "o", "def vec(pt,eta,phi,m):\r\n\u001b[?2004l\r"]
[142.53749, "o", "\u001b[?2004h> "]
[142.537803, "o", " px=pt*np.cos(phi); py=pt*np.sin(phi); pz=pt*np.sinh(eta)\r\n\u001b[?2004l\r"]
[142.537873, "o", "\u001b[?2004h> "]
[142.538175, "o", " return px,py,pz,np.sqrt(max(0,m*m+pt*pt*np.cosh(eta)**2))\r\n\u001b[?2004l\r"]
[142.538243, "o", "\u001b[?2004h> "]
[142.538389, "o", "def kin(indices,pt,eta,phi,m):\r\n\u001b[?2004l\r"]
[142.538458, "o", "\u001b[?2004h> "]
[142.538888, "o", " vs=[vec(float(pt[q]),float(eta[q]),float(phi[q]),float(m[q])) for q in indices]\r\n\u001b[?2004l\r"]
[142.53896, "o", "\u001b[?2004h> "]
[142.539538, "o", " px=sum(v[0] for v in vs); py=sum(v[1] for v in vs); pz=sum(v[2] for v in vs); E=sum(v[3] for v in vs)\r\n\u001b[?2004l\r"]
[142.539589, "o", "\u001b[?2004h> "]
[142.539959, "o", " pT=np.hypot(px,py); mass=np.sqrt(max(0,E*E-px*px-py*py-pz*pz))\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.54003, "o", "> "]
[142.540327, "o", " et=np.arcsinh(pz/pT) if pT>0 else 0.; ph=np.arctan2(py,px)\r\n\u001b[?2004l\r"]
[142.540398, "o", "\u001b[?2004h> "]
[142.540495, "o", " return pT,et,ph,mass\r\n\u001b[?2004l\r"]
