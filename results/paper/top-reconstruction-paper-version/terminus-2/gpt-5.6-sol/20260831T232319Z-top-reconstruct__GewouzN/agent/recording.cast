[142.540703, "o", "def auc(y,s):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.540984, "o", " y=np.asarray(y,dtype=int); s=np.asarray(s)\r\n\u001b[?2004l\r"]
[142.54105, "o", "\u001b[?2004h> "]
[142.541597, "o", " order=np.argsort(s,kind='mergesort'); ranks=np.empty(len(s),float); ranks[order]=np.arange(1,len(s)+1)\r\n\u001b[?2004l\r"]
[142.541664, "o", "\u001b[?2004h> "]
[142.541775, "o", " # average tied ranks\r\n\u001b[?2004l\r"]
