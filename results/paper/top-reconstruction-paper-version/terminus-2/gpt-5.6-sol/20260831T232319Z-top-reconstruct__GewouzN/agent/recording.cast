[363.129079, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport pandas as pd, json, itertools\nR=Path('/root/results')\nreq=['dataset_build/triplets_raw.parquet','dataset_prepare/train.parquet','dataset_prepare/val.parquet','dataset_prepare/test.parquet','train/model_xgb.json','train/training_report_xgb.json','infer/inference_test_xgb.parquet','infer/inference_report_xgb.json','select_triplets/selected_triplets.parquet','select_triplets/event_selection.parquet','select_triplets/selection_report.json','optimization_report.md','sanity_checks/mass_sanity_summary.json','sanity_checks/interpretation.md']\nfor f in req:\n p=R/f; assert p.exists() and p.stat().st_size>0,f\n print(f,p.stat().st_size)\nraw=pd.read_parquet(R/'dataset_build/triplets_raw.parquet'); inf=pd.read_parquet(R/'infer/inference_test_xgb.parquet'); sel=pd.read_parquet(R/'select_triplets/selected_triplets.parquet'); ev=pd.read_parquet(R/'select_triplets/event_selection.parquet')\nassert {'event_id','i','j','k','is_truth','dr_ab','dr_ac','dr_bc','mij_over_m123_ab','mij_over_m123_ac','mij_over_m123_bc'}<=set(raw)\nassert ((raw.i<raw.j)&(raw.j<raw.k)).all()\nassert {'event_id','i','j','k','is_truth','score_xgb'}<=set(inf)\nassert {'event_id','selected_rank','i','j','k','score','triplet_pt','triplet_eta','triplet_phi','triplet_mass'}<=set(sel)\nassert {'event_id','n_top_selected','top1_pt','top1_eta','top1_phi','top1_mass'}<=set(ev)\nassert len(ev)==1500 and ev.event_id.nunique()==1500\nassert ev.n_top_selected.max()<=2 and sel.groupby('event_id').size().max()<=2\nfor eid,g in sel.groupby('event_id'):\n if len(g)==2:\n  a=set(g.iloc[0][['i','j','k']].astype(int)); b=set(g.iloc[1][['i','j','k']].astype(int)); assert a.isdisjoint(b),eid\nrep=json.load(open(R/'select_triplets/selection_report.json'))\ncalc=sel.is_truth.sum()/inf.is_truth.sum()\nassert abs(calc-rep['triplet_reconstruction_efficiency'])<1e-12\ntr=json.load(open(R/'train/training_report_xgb.json')); assert 'validation_auc' in tr\nprint('\\nCHECKS PASS')\nprint('raw rows/truth',len(raw),raw.is_truth.sum())\nprint('split rows',*[len(pd.read_parquet(R/f'dataset_prepare/{x}.parquet')) for x in ['train','val','test']])\nprint('test truth/recovered/eff',int(inf.is_truth.sum()),int(sel.is_truth.sum()),calc)\nprint('selected event multiplicity',ev.n_top_selected.value_counts().sort_index().to_dict())\nprint('mass sanity',json.load(open(R/'sanity_checks/mass_sanity_summary.json')))\nprint('plots',sorted(p.name for p in (R/'select_triplets/plots').iterdir()))\nPY\nprintf '\\n--- optimization report ---\\n'; cat /root/results/optimization_report.md\n"]
