[142.55446, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.554678, "o", "# deterministic event split 70/15/15\r\n\u001b[?2004l\r"]
[142.554726, "o", "\u001b[?2004h> "]
[142.555121, "o", "ids=np.asarray(sorted(df.event_id.unique())); rng=np.random.default_rng(2025); rng.shuffle(ids)\r\n\u001b[?2004l\r"]
[142.555175, "o", "\u001b[?2004h> "]
