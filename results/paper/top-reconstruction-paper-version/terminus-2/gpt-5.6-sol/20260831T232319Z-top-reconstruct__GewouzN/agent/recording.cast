[142.556734, "o", "\u001b[?2004h> "]
[142.558164, "o", "features=['dr_ab','dr_ac','dr_bc','mij_over_m123_ab','mij_over_m123_ac','mij_over_m123_bc','triplet_mass','triplet_pt','n_genjet','pt_max','pt_mid','pt_min','pt_sum','btag_max','btag_mid','btag_min','btag_sum','dr_min','dr_max','dr_sum','mij_ab','mij_ac','mij_bc']\r\n\u001b[?2004l\r"]
