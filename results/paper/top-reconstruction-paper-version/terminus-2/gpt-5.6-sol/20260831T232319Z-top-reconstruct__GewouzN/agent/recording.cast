[142.555632, "o", "\u001b[?2004h> "]
[142.556167, "o", "parts={n:df[df.event_id.isin(s)].reset_index(drop=True) for n,s in [('train',trainids),('val',valids),('test',testids)]}\r\n\u001b[?2004l\r"]
[142.556236, "o", "\u001b[?2004h> "]
