[54.707001, "i", "python3 - <<'PY'\nimport uproot, awkward as ak, numpy as np, math\nT=uproot.open('/root/data/ttbar.root')['output']\na=T.arrays(['N_genjet','truth_triplet_0','truth_triplet_1','truth_triplet_2','truth_triplet_3'],library='ak')\nn=np.asarray(a.N_genjet)\nprint('njet quantiles',np.quantile(n,[0,.5,.9,.95,.99,1]),'mean',n.mean())\nprint('total combinations',sum(math.comb(int(x),3) for x in n if x>=3))\ncounts=[]; valid=0; duplicate=0\nfor e in range(len(n)):\n s=[]\n for q in range(4):\n  x=ak.to_list(a[f'truth_triplet_{q}'][e])\n  if len(x)==3 and min(x)>=0 and max(x)<n[e] and len(set(x))==3:\n   z=tuple(sorted(x)); valid+=1\n   if z in s: duplicate+=1\n   else:s.append(z)\n counts.append(len(s))\nprint('valid entries',valid,'duplicate labels',duplicate,'unique truths',sum(counts))\nprint('truths/event histogram',dict(zip(*np.unique(counts,return_counts=True))))\nPY\n"]
