[142.552131, "o", "               tm,tpt,teta,tphi,n,pts[0],pts[1],pts[2],sum(pts),bts[0],bts[1],bts[2],sum(bts),min(ds),max(ds),sum(ds),pms[0],pms[1],pms[2]))\r\n\u001b[?2004l\r"]
[142.552181, "o", "\u001b[?2004h> "]
