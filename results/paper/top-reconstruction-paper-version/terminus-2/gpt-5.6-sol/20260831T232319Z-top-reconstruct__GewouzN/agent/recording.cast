[142.542462, "o", "  hi=lo+1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.542808, "o", "  while hi<len(order) and s[order[hi]]==s[order[lo]]: hi+=1\r\n\u001b[?2004l\r"]
[142.542875, "o", "\u001b[?2004h> "]
[142.543042, "o", "  ranks[order[lo:hi]]=(lo+1+hi)/2\r\n\u001b[?2004l\r"]
[142.543109, "o", "\u001b[?2004h> "]
