[142.559101, "o", "dval=xgb.DMatrix(parts['val'][features],label=parts['val'].is_truth,feature_names=features)\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.559158, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.559685, "o", "# Event selector: exact maximization over singleton/pair; score^alpha emphasizes confidence.\r\n\u001b[?2004l\r"]
[142.559736, "o", "\u001b[?2004h> "]
[142.560037, "o", "def select(frame,scorecol='score',mode='exact',alpha=1.0):\r\n\u001b[?2004l\r"]
[142.560087, "o", "\u001b[?2004h> "]
[142.560129, "o", " out=[]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.560411, "o", " for eid,g0 in frame.groupby('event_id',sort=False):\r\n\u001b[?2004l\r"]
[142.560482, "o", "\u001b[?2004h> "]
[142.560661, "o", "  g=g0.sort_values(scorecol,ascending=False).head(120)\r\n\u001b[?2004l\r"]
[142.56073, "o", "\u001b[?2004h> "]
[142.560839, "o", "  rec=list(g.to_dict('records'))\r\n\u001b[?2004l\r"]
[142.560906, "o", "\u001b[?2004h> "]
[142.560968, "o", "  if not rec: continue\r\n\u001b[?2004l\r"]
[142.561017, "o", "\u001b[?2004h> "]
[142.561097, "o", "  if mode=='greedy':\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.561142, "o", "> "]
[142.561384, "o", "   chosen=[rec[0]]; used={rec[0]['i'],rec[0]['j'],rec[0]['k']}\r\n\u001b[?2004l\r"]
[142.561432, "o", "\u001b[?2004h> "]
[142.561514, "o", "   for r in rec[1:]:\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.56158, "o", "> "]
[142.561824, "o", "    if used.isdisjoint({r['i'],r['j'],r['k']}): chosen.append(r); break\r\n\u001b[?2004l\r"]
[142.561891, "o", "\u001b[?2004h>   else:\r\n\u001b[?2004l\r"]
[142.561958, "o", "\u001b[?2004h> "]
[142.562234, "o", "   util=np.power(np.clip(np.array([r[scorecol] for r in rec]),1e-9,1),alpha)\r\n\u001b[?2004l\r"]
[142.562304, "o", "\u001b[?2004h> "]
[142.562407, "o", "   best=float(util[0]); pair=None\r\n\u001b[?2004l\r"]
[142.562473, "o", "\u001b[?2004h> "]
[142.562558, "o", "   for p in range(len(rec)):\r\n\u001b[?2004l\r"]
[142.562625, "o", "\u001b[?2004h> "]
[142.562773, "o", "    sp={rec[p]['i'],rec[p]['j'],rec[p]['k']}\r\n\u001b[?2004l\r"]
[142.562837, "o", "\u001b[?2004h> "]
[142.562944, "o", "    for q in range(p+1,len(rec)):\r\n\u001b[?2004l\r"]
[142.563011, "o", "\u001b[?2004h> "]
[142.563226, "o", "     if sp.isdisjoint({rec[q]['i'],rec[q]['j'],rec[q]['k']}):\r\n\u001b[?2004l\r"]
[142.563292, "o", "\u001b[?2004h> "]
[142.563411, "o", "      z=float(util[p]+util[q])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.563578, "o", "      if z>best: best=z; pair=(p,q)\r\n\u001b[?2004l\r"]
[142.56363, "o", "\u001b[?2004h> "]
[142.563892, "o", "   chosen=[rec[0]] if pair is None else [rec[pair[0]],rec[pair[1]]]\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.563946, "o", "> "]
[142.564179, "o", "   chosen=sorted(chosen,key=lambda r:r[scorecol],reverse=True)\r\n\u001b[?2004l\r"]
[142.56423, "o", "\u001b[?2004h> "]
[142.564299, "o", "  out.extend(chosen)\r\n\u001b[?2004l\r"]
[142.564344, "o", "\u001b[?2004h> "]
[142.56444, "o", " return pd.DataFrame(out)\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.564509, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.564853, "o", "def efficiency(sel,allframe): return float(sel.is_truth.sum()/allframe.is_truth.sum())\r\n\u001b[?2004l\r"]
[142.56492, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.564989, "o", "configs=[\r\n\u001b[?2004l\r\u001b[?2004h> "]
[142.565487, "o", " ('baseline_depth4',dict(max_depth=4,eta=.08,min_child_weight=2,subsample=.85,colsample_bytree=.9,lambda_=1.0),350,1.0),\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.565537, "o", "> "]
[142.566005, "o", " ('deeper_depth6',dict(max_depth=6,eta=.06,min_child_weight=2,subsample=.9,colsample_bytree=.9,lambda_=1.5),500,1.0),\r\n\u001b[?2004l\r"]
[142.566055, "o", "\u001b[?2004h> "]
[142.566525, "o", " ('balanced_depth5',dict(max_depth=5,eta=.06,min_child_weight=1,subsample=.9,colsample_bytree=1.0,lambda_=1.0),600,8.0),\r\n\u001b[?2004l\r"]
[142.566596, "o", "\u001b[?2004h> "]
[142.567092, "o", " ('ranking_depth5',dict(max_depth=5,eta=.05,min_child_weight=2,subsample=.9,colsample_bytree=.95,lambda_=2.0),700,2.5)]\r\n\u001b[?2004l\r"]
[142.567144, "o", "\u001b[?2004h> "]
[142.567251, "o", "iterations=[]; best=None\r\n\u001b[?2004l\r"]
[142.567318, "o", "\u001b[?2004h> "]
[142.567436, "o", "for name,p,nround,spw in configs:\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.567508, "o", "> "]
[142.568024, "o", " params={'objective':'binary:logistic','eval_metric':'auc','tree_method':'hist','seed':17,'nthread':8,'scale_pos_weight':spw,'verbosity':0}\r\n\u001b[?2004l\r"]
[142.568074, "o", "\u001b[?2004h> "]
[142.568291, "o", " params.update(p); params['lambda']=params.pop('lambda_')\r\n\u001b[?2004l\r"]
[142.568361, "o", "\u001b[?2004h> "]
[142.568799, "o", " ev={}; model=xgb.train(params,dtrain,num_boost_round=nround,evals=[(dval,'val')],evals_result=ev,verbose_eval=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
