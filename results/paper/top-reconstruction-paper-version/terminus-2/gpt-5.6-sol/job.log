KS PASS')\nprint('raw rows/truth',len(raw),raw.is_truth.sum())\nprint('split rows',*[len(pd.read_parquet(R/f'dataset_prepare/{x}.parquet')) for x in ['train','val','test']])\nprint('test truth/recovered/eff',int(inf.is_truth.sum()),int(sel.is_truth.sum()),calc)\nprint('selected event multiplicity',ev.n_top_selected.value_counts().sort_index().to_dict())\nprint('mass sanity',json.load(open(R/'sanity_checks/mass_sanity_summary.json')))\nprint('plots',sorted(p.name for p in (R/'select_triplets/plots').iterdir()))\nPY\nprintf '\\n--- optimization report ---\\n'; cat /root/results/optimization_report.md\n"] min_timeout_sec: 4.0 max_timeout_sec: 180.0
