[75.632503, "o", "for i in range(len(data['Number'])):\r\n\u001b[?2004l\r"]
[75.632534, "o", "\u001b[?2004h> "]
[75.632645, "o", "    ev_id = data['Number'][i]\r\n\u001b[?2004l\r"]
[75.632678, "o", "\u001b[?2004h> "]
[75.632791, "o", "    n_jets = data['N_genjet'][i]\r\n\u001b[?2004l\r"]
[75.632822, "o", "\u001b[?2004h> "]
[75.632971, "o", "    pts = np.array(data['genjet_pt'][i])\r\n\u001b[?2004l\r"]
[75.633003, "o", "\u001b[?2004h> "]
[75.633153, "o", "    etas = np.array(data['genjet_eta'][i])\r\n\u001b[?2004l\r"]
[75.633186, "o", "\u001b[?2004h> "]
[75.633343, "o", "    phis = np.array(data['genjet_phi'][i])\r\n\u001b[?2004l\r"]
[75.633378, "o", "\u001b[?2004h> "]
[75.63345, "o", "    truth_sets = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.633481, "o", "> "]
[75.633575, "o", "    for t_idx in range(4):\r\n\u001b[?2004l\r"]
[75.633607, "o", "\u001b[?2004h> "]
[75.633791, "o", "        triplet = data[f'truth_triplet_{t_idx}'][i]\r\n\u001b[?2004l\r"]
[75.633822, "o", "\u001b[?2004h> "]
[75.634039, "o", "        if triplet[0] != -1: truth_sets.append(set(triplet))\r\n\u001b[?2004l\r"]
[75.634071, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[75.634134, "o", "\u001b[?2004h> "]
[75.634302, "o", "    for idxs in combinations(range(n_jets), 3):\r\n\u001b[?2004l\r"]
[75.634337, "o", "\u001b[?2004h> "]
[75.634459, "o", "        i_idx, j_idx, k_idx = idxs\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.634493, "o", "> "]
[75.634685, "o", "        is_truth = 1 if set(idxs) in truth_sets else 0\r\n\u001b[?2004l\r"]
[75.63472, "o", "\u001b[?2004h> "]
[75.634983, "o", "        dr_ab = delta_r(etas[i_idx], phis[i_idx], etas[j_idx], phis[j_idx])\r\n\u001b[?2004l\r"]
[75.635017, "o", "\u001b[?2004h> "]
[75.635281, "o", "        dr_ac = delta_r(etas[i_idx], phis[i_idx], etas[k_idx], phis[k_idx])\r\n\u001b[?2004l\r"]
[75.635315, "o", "\u001b[?2004h> "]
[75.635578, "o", "        dr_bc = delta_r(etas[j_idx], phis[j_idx], etas[k_idx], phis[k_idx])\r\n\u001b[?2004l\r"]
[75.635613, "o", "\u001b[?2004h> "]
[75.635885, "o", "        m123 = get_mass(pts[list(idxs)], etas[list(idxs)], phis[list(idxs)])\r\n\u001b[?2004l\r"]
[75.63592, "o", "\u001b[?2004h> "]
[75.636285, "o", "        m_ab = get_pair_mass(pts[i_idx], etas[i_idx], phis[i_idx], pts[j_idx], etas[j_idx], phis[j_idx])\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.636318, "o", "> "]
[75.636686, "o", "        m_ac = get_pair_mass(pts[i_idx], etas[i_idx], phis[i_idx], pts[k_idx], etas[k_idx], phis[k_idx])\r\n\u001b[?2004l\r"]
[75.636721, "o", "\u001b[?2004h> "]
[75.637086, "o", "        m_bc = get_pair_mass(pts[j_idx], etas[j_idx], phis[j_idx], pts[k_idx], etas[k_idx], phis[k_idx])\r\n\u001b[?2004l\r"]
[75.637119, "o", "\u001b[?2004h> "]
[75.637319, "o", "        mij_over_m123_ab = m_ab / m123 if m123 > 0 else 0\r\n\u001b[?2004l\r"]
[75.637353, "o", "\u001b[?2004h> "]
[75.637562, "o", "        mij_over_m123_ac = m_ac / m123 if m123 > 0 else 0\r\n\u001b[?2004l\r"]
[75.637598, "o", "\u001b[?2004h> "]
[75.637799, "o", "        mij_over_m123_bc = m_bc / m123 if m123 > 0 else 0\r\n\u001b[?2004l\r"]
[75.637834, "o", "\u001b[?2004h> "]
[75.638346, "o", "        all_triplets.append([ev_id, i_idx, j_idx, k_idx, is_truth, dr_ab, dr_ac, dr_bc, mij_over_m123_ab, mij_over_m123_ac, mij_over_m123_bc])\r\n\u001b[?2004l\r"]
[75.638381, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[75.638451, "o", "> "]
[75.638994, "o", "df = pd.DataFrame(all_triplets, columns=['event_id', 'i', 'j', 'k', 'is_truth', 'dr_ab', 'dr_ac', 'dr_bc', 'mij_over_m123_ab', 'mij_over_m123_ac', 'mij_over_m123_bc'])\r\n\u001b[?2004l\r"]
[75.639028, "o", "\u001b[?2004h> "]
[75.639266, "o", "df.to_parquet('/root/results/dataset_build/triplets_raw.parquet')\r\n\u001b[?2004l\r"]
[75.6393, "o", "\u001b[?2004h> "]
[75.63948, "o", "print('Successfully wrote triplets_raw.parquet')\r\n\u001b[?2004l\r"]
[75.639515, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
