[196.849154, "o", "    ev_triplets = infer_df[infer_df['event_id'] == ev].sort_values('score_xgb', ascending=False)\r\n\u001b[?2004l\r"]
[196.849182, "o", "\u001b[?2004h> "]
[196.84921, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[196.84928, "o", "> "]
[196.849329, "o", "    selected_in_ev = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.849357, "o", "> "]
[196.849432, "o", "    used_jets = set()\r\n\u001b[?2004l\r"]
[196.84946, "o", "\u001b[?2004h> "]
[196.849487, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[196.849513, "o", "> "]
[196.849665, "o", "    for _, row in ev_triplets.iterrows():\r\n\u001b[?2004l\r"]
[196.849694, "o", "\u001b[?2004h> "]
[196.849845, "o", "        if len(selected_in_ev) >= 2: break\r\n\u001b[?2004l\r"]
[196.849873, "o", "\u001b[?2004h> "]
[196.849931, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[196.850156, "o", "        jets = {int(row['i']), int(row['j']), int(row['k'])}\r\n\u001b[?2004l\r"]
[196.850183, "o", "\u001b[?2004h> "]
[196.850339, "o", "        if jets.isdisjoint(used_jets):\r\n\u001b[?2004l\r"]
[196.850367, "o", "\u001b[?2004h> "]
[196.850507, "o", "            selected_in_ev.append(row)\r\n\u001b[?2004l\r"]
[196.850535, "o", "\u001b[?2004h> "]
[196.850659, "o", "            used_jets.update(jets)\r\n\u001b[?2004l\r"]
[196.85069, "o", "\u001b[?2004h> "]
[196.850926, "o", "            if row['is_truth'] == 1: recovered_truth_triplets += 1\r\n\u001b[?2004l\r"]
[196.850955, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[196.85101, "o", "\u001b[?2004h> "]
[196.851115, "o", "    # Record selection for results\r\n\u001b[?2004l\r"]
[196.851143, "o", "\u001b[?2004h> "]
[196.851328, "o", "    for rank, row in enumerate(selected_in_ev, 1):\r\n\u001b[?2004l\r"]
[196.851356, "o", "\u001b[?2004h> "]
[196.851713, "o", "        pt, eta, phi, mass = get_triplet_kinematics(ev, int(row['i']), int(row['j']), int(row['k']))\r\n\u001b[?2004l\r"]
[196.851742, "o", "\u001b[?2004h> "]
[196.851855, "o", "        selected_list.append([\r\n\u001b[?2004l\r"]
[196.851883, "o", "\u001b[?2004h> "]
[196.852123, "o", "            ev, rank, int(row['i']), int(row['j']), int(row['k']), \r\n\u001b[?2004l\r"]
[196.852151, "o", "\u001b[?2004h> "]
[196.852327, "o", "            row['score_xgb'], pt, eta, phi, mass\r\n\u001b[?2004l\r"]
[196.852356, "o", "\u001b[?2004h> "]
[196.8524, "o", "        ])\r\n\u001b[?2004l\r"]
[196.852427, "o", "\u001b[?2004h> "]
[196.852453, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h"]
[196.85248, "o", "> "]
[196.852592, "o", "    # Record event selection\r\n\u001b[?2004l\r"]
[196.852621, "o", "\u001b[?2004h> "]
[196.852732, "o", "    if len(selected_in_ev) > 0:\r\n\u001b[?2004l\r"]
[196.852759, "o", "\u001b[?2004h> "]
[196.852876, "o", "        row = selected_in_ev[0]\r\n\u001b[?2004l\r"]
[196.852904, "o", "\u001b[?2004h> "]
[196.853259, "o", "        pt, eta, phi, mass = get_triplet_kinematics(ev, int(row['i']), int(row['j']), int(row['k']))\r\n\u001b[?2004l\r"]
[196.853289, "o", "\u001b[?2004h> "]
[196.853584, "o", "        event_selection_list.append([ev, len(selected_in_ev), pt, eta, phi, mass])\r\n\u001b[?2004l\r"]
[196.853613, "o", "\u001b[?2004h> "]
[196.853672, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.853701, "o", "> "]
[196.853887, "o", "        event_selection_list.append([ev, 0, 0, 0, 0, 0])\r\n\u001b[?2004l\r"]
[196.853915, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[196.853976, "o", "\u001b[?2004h> "]
[196.854004, "o", "# Save results\r\n\u001b[?2004l\r"]
[196.854063, "o", "\u001b[?2004h> "]
[196.854627, "o", "selected_df = pd.DataFrame(selected_list, columns=['event_id', 'selected_rank', 'i', 'j', 'k', 'score', 'triplet_pt', 'triplet_eta', 'triplet_phi', 'triplet_mass'])\r\n\u001b[?2004l\r"]
[196.854656, "o", "\u001b[?2004h> "]
[196.854951, "o", "selected_df.to_parquet('/root/results/select_triplets/selected_triplets.parquet')\r\n\u001b[?2004l\r"]
[196.854981, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[196.855009, "o", "\u001b[?2004h> "]
[196.855491, "o", "event_df = pd.DataFrame(event_selection_list, columns=['event_id', 'n_top_selected', 'top1_pt', 'top1_eta', 'top1_phi', 'top1_mass'])\r\n\u001b[?2004l\r"]
[196.85552, "o", "\u001b[?2004h> "]
[196.855787, "o", "event_df.to_parquet('/root/results/select_triplets/event_selection.parquet')\r\n\u001b[?2004l\r"]
[196.855816, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[196.855872, "o", "\u001b[?2004h> "]
[196.856189, "o", "efficiency = recovered_truth_triplets / total_truth_triplets if total_truth_triplets > 0 else 0\r\n\u001b[?2004l\r"]
[196.856218, "o", "\u001b[?2004h> "]
[196.856272, "o", "report = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[196.8563, "o", "> "]
[196.856505, "o", "    'triplet_reconstruction_efficiency': float(efficiency),\r\n\u001b[?2004l\r"]
[196.856532, "o", "\u001b[?2004h> "]
[196.856731, "o", "    'total_truth_triplets': int(total_truth_triplets),\r\n\u001b[?2004l\r"]
[196.856759, "o", "\u001b[?2004h> "]
[196.856984, "o", "    'recovered_truth_triplets': int(recovered_truth_triplets),\r\n\u001b[?2004l\r"]
[196.857012, "o", "\u001b[?2004h> "]
[196.857189, "o", "    'selection_strategy': 'greedy_disjoint_top2'\r\n\u001b[?2004l\r"]
[196.857218, "o", "\u001b[?2004h> }\r\n\u001b[?2004l\r"]
[196.857275, "o", "\u001b[?2004h> "]
[196.857528, "o", "with open('/root/results/select_triplets/selection_report.json', 'w') as f:\r\n\u001b[?2004l\r"]
[196.857557, "o", "\u001b[?2004h> "]
[196.857688, "o", "    json.dump(report, f, indent=4)\r\n\u001b[?2004l\r"]
[196.857717, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[196.857779, "o", "\u001b[?2004h> "]
[196.857967, "o", "print(f'Selection complete. Efficiency: {efficiency:.4f}')\r\n\u001b[?2004l\r"]
