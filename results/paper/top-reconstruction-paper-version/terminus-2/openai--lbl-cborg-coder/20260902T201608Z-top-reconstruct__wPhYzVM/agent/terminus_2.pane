[?2004l[?2004h> target = 'is_truth'
[?2004l[?2004h> 
[?2004l[?2004h> X_train = train_df[features]
[?2004l[?2004h> y_train = train_df[target]
[?2004l[?2004h> X_val = val_df[features]
[?2004l[?2004h> y_val = val_df[target]
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate scale_pos_weight for imbalance
[?2004l[?2004h> num_neg = (y_train == 0).sum()
[?2004l[?2004h> num_pos = (y_train == 1).sum()
[?2004l[?2004h> scale_weight = num_neg / num_pos
[?2004l[?2004h> 
[?2004l[?2004h> model = xgb.XGBClassifier(
[?2004l[?2004h>     n_estimators=200,
[?2004l[?2004h>     max_depth=5,
[?2004l[?2004h>     learning_rate=0.1,
[?2004l[?2004h>     scale_pos_weight=scale_weight,
[?2004l[?2004h>     objective='binary:logistic',
[?2004l[?2004h>     random_state=42
[?2004l[?2004h> )
[?2004l[?2004h> 
[?2004l[?2004h> model.fit(X_train, y_train, eval_set=[(X_val, y_val)], verbose=False)
[?2004l[?2004h> 
[?2004l[?2004h> # Validation performance
