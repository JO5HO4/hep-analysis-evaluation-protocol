[?2004l[?2004h> # Selection algorithms
[?2004l[?2004h> # Pair-max picks candidate singleton or pair with greatest summed score, then is allowed to retain just a singleton for 3-5 jet events.
[?2004l[?2004h> def choose(group, mode):
[?2004l[?2004h>     a=group.sort_values('score_xgb',ascending=False).to_dict('records')
[?2004l[?2004h>     if not a:return []
[?2004l[?2004h>     if mode=='one': return [a[0]]
[?2004l[?2004h>     if mode=='greedy':
[?2004l[?2004h>       out=[]; used=set()
[?2004l[?2004h>       for r in a:
[?2004l[?2004h>        ss={r['i'],r['j'],r['k']}
[?2004l[?2004h>        if not(ss&used): out.append(r);used|=ss
[?2004l[?2004h>        if len(out)==2:break
[?2004l[?2004h>       return out
[?2004l[?2004h>     # score-maximizing disjoint pair (or singleton): exhaustive and deterministic
[?2004l[?2004h>     best=[a[0]]; bestv=a[0]['score_xgb']
[?2004l[?2004h>     for q in range(len(a)):
[?2004l[?2004h>       for r in range(q+1,len(a)):
[?2004l[?2004h>        if not ({a[q]['i'],a[q]['j'],a[q]['k']} & {a[r]['i'],a[r]['j'],a[r]['k']}):
[?2004l[?2004h>         v=a[q]['score_xgb']+a[r]['score_xgb']
[?2004l[?2004h>         if v>bestv: bestv=v;best=[a[q],a[r]]
[?2004l[?2004h>     return best
[?2004l[?2004h> def efficiency(frame,mode):
[?2004l[?2004h>  sel=[]
[?2004l[?2004h>  for _,g in frame.groupby('event_id',sort=False): sel+=choose(g,mode)
[?2004l[?2004h>  return (sum(x['is_truth'] for x in sel)/int(frame.is_truth.sum()) if frame.is_truth.sum() else 0),sel
