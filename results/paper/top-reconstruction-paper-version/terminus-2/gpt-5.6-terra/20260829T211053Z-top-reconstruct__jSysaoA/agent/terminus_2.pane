[?2004l[?2004h>        mij_over_m123_ab=mab/(tm+1e-6),mij_over_m123_ac=mac/(tm+1e-6),mij_over_m123_bc=mbc/(tm+1e-6),
[?2004l[?2004h>        triplet_pt=tp,triplet_eta=te,triplet_phi=tph,triplet_mass=tm,pair_mass_ab=mab,pair_mass_ac=mac,pair_mass_bc=mbc,
[?2004l[?2004h>        jet_pt_1=sp[0],jet_pt_2=sp[1],jet_pt_3=sp[2],jet_btag_max=float(bt[list(inds)].max()),jet_btag_sum=float(bt[list(inds)].sum()),
[?2004l[?2004h>        top_mass_distance=abs(tm-172.5),w_mass_distance=min(abs(mab-80.4),abs(mac-80.4),abs(mbc-80.4))))
