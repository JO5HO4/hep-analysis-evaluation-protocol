[?2004l[?2004h> def dphi(a,b): return (a-b+np.pi)%(2*np.pi)-np.pi
[?2004l[?2004h> def p4(pt,eta,phi,m):
[?2004l[?2004h>     px=pt*np.cos(phi); py=pt*np.sin(phi); pz=pt*np.sinh(eta)
[?2004l[?2004h>     e=np.sqrt(np.maximum(m*m+px*px+py*py+pz*pz,0))
[?2004l[?2004h>     return px,py,pz,e
[?2004l[?2004h> def combine(js):
[?2004l[?2004h>     pt=np.array([x[0] for x in js]); eta=np.array([x[1] for x in js]); phi=np.array([x[2] for x in js]); m=np.array([x[3] for x in js])
[?2004l[?2004h>     px,py,pz,e=p4(pt,eta,phi,m); px=px.sum();py=py.sum();pz=pz.sum();e=e.sum()
[?2004l[?2004h>     ppt=np.hypot(px,py); pp=np.sqrt(px*px+py*py+pz*pz)
[?2004l[?2004h>     mass=np.sqrt(max(e*e-pp*pp,0)); peta=np.arcsinh(pz/ppt) if ppt>0 else 0.
[?2004l[?2004h>     return ppt,peta,np.arctan2(py,px),mass
[?2004l[?2004h> def auc(y,s):
[?2004l[?2004h>     y=np.asarray(y);s=np.asarray(s); npos=y.sum(); nneg=len(y)-npos
[?2004l[?2004h>     if not npos or not nneg:return float('nan')
[?2004l[?2004h>     # average ranks, without scipy
[?2004l[?2004h>     order=np.argsort(s,kind='mergesort'); ranks=np.empty(len(s),float); ranks[order]=np.arange(1,len(s)+1)
[?2004l[?2004h>     vals,inv,cnt=np.unique(s,return_inverse=True,return_counts=True)
[?2004l[?2004h>     for q,c in enumerate(cnt):
[?2004l[?2004h>       if c>1:
[?2004l[?2004h>        ii=np.where(inv==q)[0]; ranks[ii]=ranks[ii].mean()
[?2004l[?2004h>     return float((ranks[y==1].sum()-npos*(npos+1)/2)/(npos*nneg))
