[?2004l[?2004h> def choose(g):
[?2004l[?2004h>  a=g.sort_values('score',ascending=False).to_dict('records')
[?2004l[?2004h>  if not a:return []
[?2004l[?2004h>  best=[a[0]]; val=a[0]['score']
[?2004l[?2004h>  for q in range(len(a)):
[?2004l[?2004h>   for r in range(q+1,len(a)):
