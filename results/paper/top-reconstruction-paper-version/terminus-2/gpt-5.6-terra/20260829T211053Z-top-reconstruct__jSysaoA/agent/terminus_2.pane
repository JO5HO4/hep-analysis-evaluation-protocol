[?2004l[?2004h>     for i,j,k in itertools.combinations(range(n),3):
[?2004l[?2004h>       inds=(i,j,k); js=[(pts[q],etas[q],phis[q],ms[q]) for q in inds]
[?2004l[?2004h>       tp,te,tph,tm=combine(js)
[?2004l[?2004h>       def dr(a,b): return float(np.hypot(etas[a]-etas[b],dphi(phis[a],phis[b])))
[?2004l[?2004h>       mab=combine([js[0],js[1]])[3]; mac=combine([js[0],js[2]])[3]; mbc=combine([js[1],js[2]])[3]
