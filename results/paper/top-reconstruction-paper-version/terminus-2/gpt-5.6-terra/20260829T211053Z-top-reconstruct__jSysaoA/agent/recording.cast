[382.158206, "o", "### Event selection strategies (validation)\r\n\u001b[?2004l\r\u001b[?2004h"]
[382.158247, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[382.158326, "o", "> "]
[382.158517, "o", "| Configuration | Triplet reconstruction efficiency | Truth selected |\r\n\u001b[?2004l\r\u001b[?2004h"]
