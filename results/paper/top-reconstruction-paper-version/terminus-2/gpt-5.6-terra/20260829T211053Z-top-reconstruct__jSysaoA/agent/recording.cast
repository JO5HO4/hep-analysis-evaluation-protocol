[139.639693, "o", "\u001b[?2004h> "]
[139.640366, "o", " counts=sel.groupby('event_id').size().rename('n_top_selected').reset_index(); events=events.merge(counts,on='event_id',how='left').merge(top1,on='event_id',how='left')\r\n\u001b[?2004l\r"]
