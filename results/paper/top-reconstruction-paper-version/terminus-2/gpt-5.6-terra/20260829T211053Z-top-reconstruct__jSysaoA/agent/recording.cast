[382.159323, "o", "\u001b[?2004h> "]
[382.159389, "o", "md+='''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[382.159595, "o", "### Classifier variants with pairmax selection (validation)\r\n\u001b[?2004l\r"]
[382.15963, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[382.159662, "o", "\u001b[?2004h> "]
[382.159974, "o", "| Configuration | Best iteration | Validation AUC | Triplet reconstruction efficiency |\r\n\u001b[?2004l\r\u001b[?2004h"]
[382.160009, "o", "> "]
[382.160075, "o", "|---|---:|---:|---:|\r\n\u001b[?2004l\r"]
[382.160109, "o", "\u001b[?2004h> '''\r\n\u001b[?2004l\r"]
[382.160175, "o", "\u001b[?2004h> "]
[382.160232, "o", "for x in variants:\r\n\u001b[?2004l\r\u001b[?2004h"]
[382.160266, "o", "> "]
[382.160831, "o", " md+=f\"| {x['name']} (depth {x['max_depth']}, eta {x['eta']}) | {x['best_iteration']} | {x['validation_auc_xgb']:.6f} | {x['validation_pairmax_efficiency']:.6f} |\\n\"\r\n\u001b[?2004l\r"]
[382.160865, "o", "\u001b[?2004h> "]
[382.16093, "o", "md+='''\r\n\u001b[?2004l\r\u001b[?2004h> "]
[382.162056, "o", "The baseline was retained: although the shallow model had essentially tied candidate AUC, its event-level disjoint-selection recall was lower. Training detail is in `train/training_report_xgb.json`, variant data in `train/model_variant_comparison.json`, and held-out inference details in `infer/inference_report_xgb.json`.\r\n\u001b[?2004l\r"]
[382.162092, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[382.162167, "o", "\u001b[?2004h> "]
[382.162203, "o", "## Mass sanity check\r\n\u001b[?2004l\r"]
[382.162233, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[382.162318, "o", "\u001b[?2004h> "]
[382.163706, "o", "`select_triplets/plots/triplet_mass_comparison.png` compares selected held-out masses against validation truth and combinatorial candidates. The selected mass distribution has median 173.1 GeV and broad 5--95% range 131.8--412.4 GeV; no artificially narrow mass-window cut was applied. Numerical comparison and interpretation are in `sanity_checks/mass_sanity_report.json` and `sanity_checks/mass_sanity_note.md`.\r\n\u001b[?2004l\r"]
[382.163741, "o", "\u001b[?2004h> '''\r\n"]
[382.163815, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[382.163953, "o", "open(R/'optimization_report.md','w').write(md)\r\n\u001b[?2004l\r"]
[382.163985, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[382.193275, "o", "\u001b[?2004hroot@nid004942:~# "]
[382.193329, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[382.193499, "o", "\u001b[?2004h> "]
[382.193541, "o", "import pandas as pd, json\r\n\u001b[?2004l\r\u001b[?2004h> "]
[382.193652, "o", "from pathlib import Path\r\n\u001b[?2004l\r"]
[382.193688, "o", "\u001b[?2004h> "]
[382.193796, "o", "R=Path('/root/results')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[382.194023, "o", "raw=pd.read_parquet(R/'dataset_build/triplets_raw.parquet')\r\n\u001b[?2004l\r"]
[382.194058, "o", "\u001b[?2004h> "]
[382.194263, "o", "inf=pd.read_parquet(R/'infer/inference_test_xgb.parquet')\r\n\u001b[?2004l\r"]
[382.194297, "o", "\u001b[?2004h> "]
[382.194527, "o", "sel=pd.read_parquet(R/'select_triplets/selected_triplets.parquet')\r\n\u001b[?2004l\r"]
[382.194603, "o", "\u001b[?2004h> "]
[382.194782, "o", "ev=pd.read_parquet(R/'select_triplets/event_selection.parquet')\r\n\u001b[?2004l\r"]
[382.194817, "o", "\u001b[?2004h> "]
[382.195037, "o", "rep=json.load(open(R/'select_triplets/selection_report.json'))\r\n\u001b[?2004l\r"]
[382.19507, "o", "\u001b[?2004h> "]
[382.195547, "o", "assert {'event_id','i','j','k','is_truth','dr_ab','dr_ac','dr_bc','mij_over_m123_ab','mij_over_m123_ac','mij_over_m123_bc'} <= set(raw)\r\n\u001b[?2004l\r"]
[382.195582, "o", "\u001b[?2004h> "]
[382.195811, "o", "assert {'event_id','i','j','k','is_truth','score_xgb'} <= set(inf)\r\n\u001b[?2004l\r"]
[382.195846, "o", "\u001b[?2004h> "]
[382.196275, "o", "assert {'event_id','selected_rank','i','j','k','score','triplet_pt','triplet_eta','triplet_phi','triplet_mass'} <= set(sel)\r\n\u001b[?2004l\r"]
[382.196309, "o", "\u001b[?2004h> "]
[382.196598, "o", "assert ev.n_top_selected.max() <= 2 and sel.groupby('event_id').size().max() <= 2\r\n\u001b[?2004l\r"]
[382.19663, "o", "\u001b[?2004h> "]
[382.196756, "o", "for _,g in sel.groupby('event_id'):\r\n\u001b[?2004l\r"]
[382.196788, "o", "\u001b[?2004h> "]
[382.197113, "o", "    if len(g)==2: assert not (set(g.iloc[0][['i','j','k']]) & set(g.iloc[1][['i','j','k']]))\r\n\u001b[?2004l\r"]
[382.197145, "o", "\u001b[?2004h> "]
[382.197366, "o", "assert int(sel.is_truth.sum())==rep['selected_truth_triplets']\r\n\u001b[?2004l\r"]
[382.197401, "o", "\u001b[?2004h> "]
[382.197626, "o", "assert int(inf.is_truth.sum())==rep['inference_truth_triplets']\r\n\u001b[?2004l\r"]
[382.197658, "o", "\u001b[?2004h> "]
[382.197766, "o", "print('FINAL VALIDATION PASS')\r\n\u001b[?2004l\r"]
[382.197799, "o", "\u001b[?2004h> "]
[382.198282, "o", "print('efficiency =',rep['triplet_reconstruction_efficiency'],f\"({rep['selected_truth_triplets']}/{rep['inference_truth_triplets']})\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[382.198315, "o", "> "]
[382.198584, "o", "print('candidate/event constraints valid; all required data columns present')\r\n\u001b[?2004l\r"]
[382.198619, "o", "\u001b[?2004h> "]
[382.199293, "o", "print('sanity files:',[(p.name,p.exists()) for p in [R/'sanity_checks/mass_sanity_report.json',R/'sanity_checks/mass_sanity_note.md',R/'select_triplets/plots/triplet_mass_comparison.png']])\r\n\u001b[?2004l\r"]
[382.199326, "o", "\u001b[?2004h> "]
[382.199391, "o", "PY\r\n\u001b[?2004l\r"]
[382.853165, "o", "FINAL VALIDATION PASS\r\nefficiency = 0.7023675310033822 (623/887)\r\ncandidate/event constraints valid; all required data columns present\r\n"]
[382.853345, "o", "sanity files: [('mass_sanity_report.json', True), ('mass_sanity_note.md', True), ('triplet_mass_comparison.png', True)]\r\n"]
[382.900313, "o", "\u001b[?2004hroot@nid004942:~# "]
