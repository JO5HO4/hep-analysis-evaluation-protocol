[279.448554, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport pandas as pd, json\nR=Path('/root/results')\nneed=['dataset_build/triplets_raw.parquet','dataset_prepare/train.parquet','dataset_prepare/val.parquet','dataset_prepare/test.parquet','train/model_xgb.json','train/training_report_xgb.json','infer/inference_test_xgb.parquet','infer/inference_report_xgb.json','select_triplets/selected_triplets.parquet','select_triplets/event_selection.parquet','select_triplets/selection_report.json','optimization_report.md','sanity_checks/mass_sanity_report.json']\nprint('ARTIFACTS',[(x,(R/x).exists()) for x in need])\nraw=pd.read_parquet(R/'dataset_build/triplets_raw.parquet'); inf=pd.read_parquet(R/'infer/inference_test_xgb.parquet'); sel=pd.read_parquet(R/'select_triplets/selected_triplets.parquet'); ev=pd.read_parquet(R/'select_triplets/event_selection.parquet')\nprint('raw rows',len(raw),'required raw cols',set(['event_id','i','j','k','is_truth','dr_ab','dr_ac','dr_bc','mij_over_m123_ab','mij_over_m123_ac','mij_over_m123_bc']) <= set(raw.columns),'ordered',bool(((raw.i<raw.j)&(raw.j<raw.k)).all()))\nprint('inference required',set(['event_id','i','j','k','is_truth','score_xgb'])<=set(inf.columns),'selected max',sel.groupby('event_id').size().max(),'events max',ev.n_top_selected.max())\nbad=0\nfor _,g in sel.groupby('event_id'):\n if len(g)==2 and set(g.iloc[0][['i','j','k']]) & set(g.iloc[1][['i','j','k']]):bad+=1\nprint('overlapping selected events',bad,'selected rows',len(sel),'truth selected',int(sel.is_truth.sum()))\nprint('plots', [x.name for x in (R/'select_triplets/plots').iterdir()])\nPY\n"]
