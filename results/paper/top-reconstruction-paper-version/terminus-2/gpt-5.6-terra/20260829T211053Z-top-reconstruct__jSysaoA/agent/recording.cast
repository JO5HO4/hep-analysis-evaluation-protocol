[382.152973, "o", "summary={'final_test_triplet_reconstruction_efficiency':sel['triplet_reconstruction_efficiency'],'final_test_selected_truth_triplets':sel['selected_truth_triplets'],'final_test_truth_triplets':sel['inference_truth_triplets'],'final_selection_strategy':sel['selection_strategy'],'selection_strategy_iterations':sel['validation_strategy_comparison'],'classifier_hyperparameter_iterations':variants,'decision':'Retained baseline depth-5 eta-0.07 classifier because it had the largest validation pairmax triplet recall.'}\r\n\u001b[?2004l\r\u001b[?2004h> "]
